        for s in range(n_steps):
            # Динамический шаг по времени (CFL Condition)
            max_vel_current = torch.max(torch.sqrt(v_current[0] ** 2 + v_current[1] ** 2)).item()
            dt = min(0.004, 0.25 * engine.dx / (max_vel_current + 1e-6))

            v_current, singularity_idx = engine.step(v_current, dt)
            sim_time += dt

            if s % 20 == 0:
                vorticity = compute_vorticity(v_current, engine.mesh)
                max_v, mean_v, energy, max_w, enstro = compute_metrics(v_current, vorticity)
                mean_T = torch.mean(engine.T).item()
                max_T = torch.max(engine.T).item()

                print(
                    f"{s:<6} | {max_v:<8.2f} | {mean_T:<8.1f} | {max_T:<8.1f} | {max_w:<10.2f} | {enstro:<12.1f} | {singularity_idx:<8.2f}")

                vorticity_np = vorticity.cpu().numpy()
                grid = pv.StructuredGrid(X, Y, np.zeros_like(X))
                grid.point_data["vorticity"] = vorticity_np.ravel(order='C')

                warp_factor = 3.0 / (max_w + 10.0)
                grid_warp = grid.warp_by_scalar("vorticity", factor=warp_factor)

                pl.clear()
                vmax = np.percentile(np.abs(vorticity_np), 98)
                if vmax < 1e-3:
                    vmax = 1e-3

                pl.add_mesh(grid_warp, scalars="vorticity", cmap="RdBu", ambient=0.1, diffuse=0.8, specular=0.3,
                            show_edges=False, clim=[-vmax, vmax])

                # Формирование заголовка
                title_str = f"{env_name.replace('_', ' ').upper()} Flow + Thermal Loop"
                pl.add_text(f"{title_str}\nStep: {s} | Time: {sim_time:.3f}s\nMax T: {max_T:.1f} K", color='white',
                            font_size=14)

                filename = os.path.join(output_dir, f"frame_{s:04d}.png")
                pl.screenshot(filename)
                filenames.append(filename)

    finally:
        pl.close()
        del pl
        gc.collect()

    print("-" * 95)
    print("Сборка GIF...")
    if filenames:
        gif_path = f'{env_name}_thermal_feedback.gif'
        with imageio.get_writer(gif_path, mode='I', duration=0.04, subrectangles=True) as writer:
            for filename in filenames:
                image = imageio.imread(filename)
                writer.append_data(image)

        # Очистка файловой системы
        for filename in filenames:
            try:
                os.remove(filename)
            except OSError:
                pass
        try:
            os.rmdir(output_dir)
        except OSError:
            pass

        print(f"Готово! Файл: {gif_path}")
