var float[] w_in_macd = array.new_float(units, 0.1)

// Momentum for per-feature weights
var float[] mv_w_in_price = array.new_float(units, 0.0), mv_w_in_rsi = array.new_float(units, 0.0), mv_w_in_roc = array.new_float(units, 0.0), mv_w_in_atr = array.new_float(units, 0.0), mv_w_in_volratio = array.new_float(units, 0.0), mv_w_in_corrpv = array.new_float(units, 0.0), mv_w_in_corrpm = array.new_float(units, 0.0), mv_w_in_rsi_vol = array.new_float(units, 0.0), mv_w_in_slope = array.new_float(units, 0.0), mv_w_in_volume = array.new_float(units, 0.0), mv_w_in_macd = array.new_float(units, 0.0), mv_w_in_entropy = array.new_float(units, 0.0)
// NEW: CNN feature weights
var float[] w_in_cnn = array.new_float(units, 0.1)
var float[] mv_w_in_cnn = array.new_float(units, 0.0)

// Layer inputs weights
var float[] w_in_l2 = array.new_float(units, 0.1)
var float[] mv_w_in_l2 = array.new_float(units, 0.0)
var float[] w_in_l3 = array.new_float(units, 0.1)
var float[] mv_w_in_l3 = array.new_float(units, 0.0)
var float[] w_in_l4 = array.new_float(units, 0.1)
var float[] mv_w_in_l4 = array.new_float(units, 0.0)

var int lstm_backprop_counter = 0
lstm_backprop_frequency = input.int(3, "LSTM Backprop Frequency (bars)", minval=1, maxval=10, group="LSTM Optimization", tooltip="1 = каждый бар (медленно), 3 = каждые 3 бара (рекомендуется), 5 = каждые 5 баров (быстро)")

// Placeholder logic for features
if bar_index > safe_len_default
    // Calculate slope of a 10-bar SMA
    sma_10 = ta.sma(close, 10)
    km_safe_sma_slope := (sma_10 - sma_10[1]) / ta.atr(14)
    
    // Volume
    km_safe_volume := volume
    
    // MACD
    fast_len = 12, slow_len = 26, signal_len = 9
    fast_ma = ta.ema(close, fast_len)
    slow_ma = ta.ema(close, slow_len)
    macd_line = fast_ma - slow_ma
    signal_line = ta.ema(macd_line, signal_len)
    km_safe_macd := macd_line - signal_line

    // Entropy
    window = 20
    entropy_series = array.new_float(0)
    for i_entropy = 0 to window - 1 
        array.push(entropy_series, math.log(close[i_entropy]/close[i_entropy+1]))
    stddev = array_std(entropy_series, array_mean(entropy_series))
    km_safe_entropy := stddev * math.log(window)

// -------------------------
// ============================================================
// LSTM forecast function (ИСПРАВЛЕННАЯ ВЕРСИЯ)
// ============================================================

// LSTM forecast function (full features, trainable online)
lstm_forecast(src, len, forecast_length) =>
    // ============================================================
    // 1. ИНИЦИАЛИЗАЦИЯ
    // ============================================================
    safe_len = math.max(10, math.min(30, int(nz(len, 30))))

    // ============================================================
    // 2. ИЗВЛЕЧЕНИЕ БАЗОВЫХ ПРИЗНАКОВ (ДОЛЖНО БЫТЬ ПЕРВЫМ!)
    // ============================================================
    // КРИТИЧНО: Объявляем mv_cnn_weights в начале функции
    var array<float> mv_cnn_weights = array.new_float(0)
    rsi_series = ta.rsi(src, 14)
    roc_series = ta.roc(src, 10)
    wma_roc_series = ta.wma(roc_series, 5)
    local_atr = nz(ta.atr(14))
    vol_ratio_series = ta.sma(volume, 20) / ta.sma(volume, 50) - 1
    corr_pv_series = ta.correlation(src, volume, safe_len)
    corr_pm_series = ta.correlation(src, ta.mom(src, 10), safe_len)
    rsi_vol_series = ta.correlation(rsi_series, volume, safe_len)
    slope_series = km_safe_sma_slope
    volume_series = km_safe_volume
    macd_series = km_safe_macd
    entropy_series = km_safe_entropy

// ============================================================
// 3. CNN FEATURES (ИСПРАВЛЕННАЯ ВЕРСИЯ)
// ============================================================
    cnn_windows = array.from(3, 5, 7)
    total_cnn_features = 3 * cnn_filters

    var array<float> cnn_features_multiscale = array.new_float(total_cnn_features, 0.0)

    feature_idx = 0
    total_cnn_weights = 0

// Предварительно вычисляем общее количество весов для правильной индексации
    for w_idx = 0 to 2
        window_size = array.get(cnn_windows, w_idx)
        total_cnn_weights += window_size * cnn_filters

// Основной цикл CNN (исправленный)
    for window_idx = 0 to 2
        current_window = array.get(cnn_windows, window_idx)
    
    // Вычисляем смещение весов для текущего окна
        weight_offset = 0
        for prev_idx = 0 to window_idx - 1
            prev_window = array.get(cnn_windows, prev_idx)
            weight_offset += prev_window * cnn_filters

        for filter_idx = 0 to cnn_filters - 1
            convolution_values = array.new_float(0)
        
        // КРИТИЧЕСКОЕ ИСПРАВЛЕНИЕ: правильная индексация исторических данных
        // Проходим по всем возможным позициям свертки в пределах safe_len
            for conv_pos = current_window to math.min(bar_index - 1, safe_len + current_window)
                if conv_pos < bar_index and conv_pos >= current_window
                    window_sum = 0.0
                    valid_convolution = true
                
                    for j = 0 to current_window - 1
                    // ИСПРАВЛЕНИЕ: используем правильную индексацию для исторических данных
                        price_idx1 = conv_pos - j
                        price_idx2 = conv_pos - j - 1
                    
                    // Проверяем доступность исторических данных
                        if price_idx1 >= 0 and price_idx2 >= 0 and price_idx1 < bar_index and price_idx2 < bar_index
                            weight_index = weight_offset + filter_idx * current_window + j
                        
                            if weight_index < array.size(cnn_weights_flat)
                                weight_val = array.get(cnn_weights_flat, weight_index)
                            
                            // Вычисляем разницу цен (исторические данные)
                                if not na(src[price_idx1]) and not na(src[price_idx2])
                                    price_diff = src[price_idx1] - src[price_idx2]
                                    window_sum += price_diff * weight_val
                                else
                                    valid_convolution := false
                            else
                                valid_convolution := false
                        else
                            valid_convolution := false
                
                    if valid_convolution
                        array.push(convolution_values, window_sum)
        
        // Global Average Pooling (исправленный)
            pooled_value = 0.0
            if array.size(convolution_values) > 0
                for idx = 0 to array.size(convolution_values) - 1
                    pooled_value += array.get(convolution_values, idx)
                pooled_value := pooled_value / array.size(convolution_values)
            else
                pooled_value := 0.0
        
        // Сохраняем фичу
            if feature_idx < total_cnn_features
                array.set(cnn_features_multiscale, feature_idx, pooled_value)
                feature_idx += 1

// ============================================================
// 3.1 НОРМАЛИЗАЦИЯ CNN FEATURES (ИСПРАВЛЕННАЯ)
// ============================================================
    mean_cnn = 0.0
    valid_cnn_count = 0

    // Вычисляем среднее только по валидным значениям
    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val) and math.abs(feature_val) < 1000  // Защита от выбросов
            mean_cnn += feature_val
            valid_cnn_count += 1

    mean_cnn := valid_cnn_count > 0 ? mean_cnn / valid_cnn_count : 0.0

// Вычисляем стандартное отклонение
    variance_cnn = 0.0
    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val) and math.abs(feature_val) < 1000
            diff = feature_val - mean_cnn
            variance_cnn += diff * diff

    std_cnn = valid_cnn_count > 1 ? math.sqrt(variance_cnn / valid_cnn_count) : 1.0
    std_cnn := std_cnn > 0 ? std_cnn : 1.0

// Применяем нормализацию
    var array<float> norm_cnn_features_multi = array.new_float(total_cnn_features, 0.0)
    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val)
            normalized_val = (feature_val - mean_cnn) / std_cnn
        // Ограничиваем диапазон для стабильности
            clamped_val = math.max(-5.0, math.min(5.0, normalized_val))
            array.set(norm_cnn_features_multi, f, clamped_val)
        else
            array.set(norm_cnn_features_multi, f, 0.0)

    // ============================================================
    // 4. НОРМАЛИЗАЦИЯ БАЗОВЫХ ПРИЗНАКОВ (safe_len и rsi_series уже определены)
    // ============================================================
    mean_price = ta.sma(src, safe_len)
    std_price = ta.stdev(src, safe_len)
    std_price := std_price > 0 ? std_price : nz(src, close) * 0.01

    mean_rsi = ta.sma(rsi_series, safe_len)
    std_rsi = ta.stdev(rsi_series, safe_len)
    std_rsi := std_rsi > 0 ? std_rsi : 10.0

    mean_roc = ta.sma(wma_roc_series, safe_len)
    std_roc = ta.stdev(wma_roc_series, safe_len)
    std_roc := std_roc > 0 ? std_roc : 1.0

    mean_atr = ta.sma(local_atr, safe_len)
    std_atr = ta.stdev(local_atr, safe_len)
    std_atr := std_atr > 0 ? std_atr : local_atr * 0.01

    mean_vol_ratio = ta.sma(vol_ratio_series, safe_len)
    std_vol_ratio = ta.stdev(vol_ratio_series, safe_len)
    std_vol_ratio := std_vol_ratio > 0 ? std_vol_ratio : 0.01

    mean_corr_pv = ta.sma(corr_pv_series, safe_len)
    std_corr_pv = ta.stdev(corr_pv_series, safe_len)
    std_corr_pv := std_corr_pv > 0 ? std_corr_pv : 0.1

    mean_corr_pm = ta.sma(corr_pm_series, safe_len)
    std_corr_pm = ta.stdev(corr_pm_series, safe_len)
    std_corr_pm := std_corr_pm > 0 ? std_corr_pm : 0.1

    mean_rsi_vol = ta.sma(rsi_vol_series, safe_len)
    std_rsi_vol = ta.stdev(rsi_vol_series, safe_len)
    std_rsi_vol := std_rsi_vol > 0 ? std_rsi_vol : 0.1

    mean_slope = ta.sma(slope_series, safe_len)
    std_slope = ta.stdev(slope_series, safe_len)
    std_slope := std_slope > 0 ? std_slope : 0.1

    mean_volume = ta.sma(volume_series, safe_len)
    std_volume = ta.stdev(volume_series, safe_len)
    std_volume := std_volume > 0 ? std_volume : 0.1

    mean_macd = ta.sma(macd_series, safe_len)
    std_macd = ta.stdev(macd_series, safe_len)
    std_macd := std_macd > 0 ? std_macd : 0.1

    mean_entropy = ta.sma(entropy_series, safe_len)
    std_entropy = ta.stdev(entropy_series, safe_len)
    std_entropy := std_entropy > 0 ? std_entropy : 0.1

    // ============================================================
    // 5. НОРМАЛИЗАЦИЯ CNN FEATURES
    // ============================================================
  
    valid_cnn_features = 0

    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val)
            mean_cnn += feature_val
            valid_cnn_features += 1

    mean_cnn := valid_cnn_features > 0 ? mean_cnn / valid_cnn_features : 0.0

    
    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val)
            diff = feature_val - mean_cnn
            variance_cnn += diff * diff

    valid_cnn_features > 1 ? math.sqrt(variance_cnn / (valid_cnn_features - 1)) : 1.0
    std_cnn := std_cnn > 0 ? std_cnn : 0.01

    for f = 0 to total_cnn_features - 1
        feature_val = array.get(cnn_features_multiscale, f)
        if not na(feature_val)
            normalized_val = (feature_val - mean_cnn) / std_cnn
            clamped_val = math.max(-3.0, math.min(3.0, normalized_val))
            array.set(norm_cnn_features_multi, f, clamped_val)
        else
            array.set(norm_cnn_features_multi, f, 0.0)

    // ============================================================
    // 6. ADAPTIVE ALPHA, DROPOUT, BATCH NORM
    // ============================================================
    volatility = ta.stdev(src, safe_len) / math.max(mean_price, 1e-10)
    alpha_adaptive = alpha_base * (1 + volatility)

    dropout_rate = 0.2
    is_training = not barstate.isconfirmed

    var array<float> dropout_mask1 = array.new_float(units, 1.0)
    var array<float> dropout_mask2 = array.new_float(units, 1.0)
    var array<float> dropout_mask3 = array.new_float(units, 1.0)

    if is_training
        for u = 0 to units - 1
            dropout_mask1.set(u, math.random() > dropout_rate ? 1.0 / (1.0 - dropout_rate) : 0.0)
            dropout_mask2.set(u, math.random() > dropout_rate ? 1.0 / (1.0 - dropout_rate) : 0.0)
            dropout_mask3.set(u, math.random() > dropout_rate ? 1.0 / (1.0 - dropout_rate) : 0.0)
    else
        for u = 0 to units - 1
            dropout_mask1.set(u, 1.0)
            dropout_mask2.set(u, 1.0)
            dropout_mask3.set(u, 1.0)

    var float bn_epsilon = 1e-5
    var float bn_gamma1 = 1.0
    var float bn_beta1 = 0.0
    var float bn_gamma2 = 1.0
    var float bn_beta2 = 0.0
    var float bn_gamma3 = 1.0
    var float bn_beta3 = 0.0


    // --- Sequence pass
    for i = safe_len - 1 to 0
        norm_price = math.max(-3.0, math.min(3.0, (src[i] - mean_price) / std_price))
        norm_rsi = math.max(-3.0, math.min(3.0, (rsi_series[i] - mean_rsi) / std_rsi))
        norm_roc = math.max(-3.0, math.min(3.0, (wma_roc_series[i] - mean_roc) / std_roc))
        norm_atr = math.max(-3.0, math.min(3.0, (local_atr[i] - mean_atr) / std_atr))
        norm_vol_ratio = math.max(-3.0, math.min(3.0, (vol_ratio_series[i] - mean_vol_ratio) / std_vol_ratio))
        norm_corr_pv = math.max(-3.0, math.min(3.0, (corr_pv_series[i] - mean_corr_pv) / std_corr_pv))
        norm_corr_pm = math.max(-3.0, math.min(3.0, (corr_pm_series[i] - mean_corr_pm) / std_corr_pm))
        norm_rsi_vol = math.max(-3.0, math.min(3.0, (rsi_vol_series[i] - mean_rsi_vol) / std_rsi_vol))
        norm_slope = math.max(-3.0, math.min(3.0, (slope_series[i] - mean_slope) / std_slope))
        norm_volume = math.max(-3.0, math.min(3.0, (volume_series[i] - mean_volume) / std_volume))
        norm_macd = math.max(-3.0, math.min(3.0, (macd_series[i] - mean_macd) / std_macd))
        norm_entropy = math.max(-3.0, math.min(3.0, (entropy_series[i] - mean_entropy) / std_entropy))
        
        // FIRST LAYER с Dropout
        for u = 0 to units - 1
            h_prev = hidden1.get(u)
            c_prev = cell1.get(u)
            
            // Агрегация CNN features (безопасно)
            cnn_sum = 0.0
            for f = 0 to math.min(total_cnn_features - 1, units - 1)
                if f < array.size(norm_cnn_features_multi)
                    cnn_sum += array.get(norm_cnn_features_multi, f) * w_in_cnn.get(u)
            cnn_sum := total_cnn_features > 0 ? cnn_sum / total_cnn_features : 0.0
            
            input_sum = w_in_price.get(u) * norm_price + w_in_rsi.get(u) * norm_rsi + w_in_roc.get(u) * norm_roc + w_in_atr.get(u) * norm_atr + w_in_volratio.get(u) * norm_vol_ratio + w_in_corrpv.get(u) * norm_corr_pv + w_in_corrpm.get(u) * norm_corr_pm + w_in_rsi_vol.get(u) * norm_rsi_vol + w_in_slope.get(u) * norm_slope + w_in_volume.get(u) * norm_volume + w_in_macd.get(u) * norm_macd + w_in_entropy.get(u) * norm_entropy + cnn_sum
            forget = sigmoid(w_f1.get(u) * h_prev + u_f1.get(u) * input_sum + b_f1.get(u))
            input_gate = sigmoid(w_i1.get(u) * h_prev + u_i1.get(u) * input_sum + b_i1.get(u))
            candidate = tanh_act(w_c1.get(u) * h_prev + u_c1.get(u) * input_sum + b_c1.get(u))
            c_new = forget * c_prev + input_gate * candidate
            output_gate = sigmoid(w_o1.get(u) * h_prev + u_o1.get(u) * input_sum + b_o1.get(u))
            h_new = output_gate * tanh_act(c_new)
            
            h_new := h_new * dropout_mask1.get(u)

            cell1.set(u, c_new)
            hidden1.set(u, h_new)
// ========================================
    // BATCH NORMALIZATION для Layer1 output
    // ========================================
    mean_h1 = 0.0
    for u = 0 to units - 1
        mean_h1 += hidden1.get(u)
    mean_h1 := mean_h1 / units
    
    variance_h1 = 0.0
    for u = 0 to units - 1
        diff = hidden1.get(u) - mean_h1
        variance_h1 += diff * diff
    variance_h1 := variance_h1 / units
    
    // Normalize + Scale + Shift
    for u = 0 to units - 1
        normalized_h1 = (hidden1.get(u) - mean_h1) / math.sqrt(variance_h1 + bn_epsilon)
        scaled_h1 = bn_gamma1 * normalized_h1 + bn_beta1
        hidden1.set(u, scaled_h1)
    
    // Attention Layer1
    var float[] att1 = array.new_float(units, 0.0)
    sum_exp1 = 0.0
    for u = 0 to units - 1
        hv = hidden1.get(u)
        score = math.exp(math.min(10.0, hv))
        att1.set(u, score)
        sum_exp1 += score

    weighted_hidden1 = 0.0
    for u = 0 to units - 1
        wgt = sum_exp1 > 0 ? att1.get(u) / sum_exp1 : 1.0 / units
        weighted_hidden1 += hidden1.get(u) * wgt

    // --- Layer2 с Dropout
    for u = 0 to units - 1
        h_prev2 = hidden2.get(u)
        c_prev2 = cell2.get(u)
        input2 = weighted_hidden1 * w_in_l2.get(u)

        forget2 = sigmoid(w_f2.get(u) * h_prev2 + u_f2.get(u) * input2 + b_f2.get(u))
        input_gate2 = sigmoid(w_i2.get(u) * h_prev2 + u_i2.get(u) * input2 + b_i2.get(u))
        candidate2 = tanh_act(w_c2.get(u) * h_prev2 + u_c2.get(u) * input2 + b_c2.get(u))
        c_new2 = forget2 * c_prev2 + input_gate2 * candidate2
        output2 = sigmoid(w_o2.get(u) * h_prev2 + u_o2.get(u) * input2 + b_o2.get(u))
        h_new2 = output2 * tanh_act(c_new2)
        
        // Dropout
        h_new2 := h_new2 * dropout_mask2.get(u)

        cell2.set(u, c_new2)
        hidden2.set(u, h_new2)
    
    // BATCH NORM Layer2
    mean_h2 = 0.0
    for u = 0 to units - 1
        mean_h2 += hidden2.get(u)
    mean_h2 := mean_h2 / units
    
    variance_h2 = 0.0
    for u = 0 to units - 1
        diff = hidden2.get(u) - mean_h2
        variance_h2 += diff * diff
    variance_h2 := variance_h2 / units
    
    for u = 0 to units - 1
        normalized_h2 = (hidden2.get(u) - mean_h2) / math.sqrt(variance_h2 + bn_epsilon)
        scaled_h2 = bn_gamma2 * normalized_h2 + bn_beta2
        hidden2.set(u, scaled_h2)
    
    // Attention Layer2
    var float[] att2 = array.new_float(units, 0.0)
    sum_exp2 = 0.0
    for u = 0 to units - 1
        hv = hidden2.get(u)
        score = math.exp(math.min(10.0, hv))
        att2.set(u, score)
        sum_exp2 += score

    weighted_hidden2 = 0.0
    for u = 0 to units - 1
        wgt = sum_exp2 > 0 ? att2.get(u) / sum_exp2 : 1.0 / units
        weighted_hidden2 += hidden2.get(u) * wgt

    // --- Layer3 с Dropout
    for u = 0 to units - 1
        h_prev3 = hidden3.get(u)
        c_prev3 = cell3.get(u)
        input3 = weighted_hidden2 * w_in_l3.get(u)

        forget3 = sigmoid(w_f3.get(u) * h_prev3 + u_f3.get(u) * input3 + b_f3.get(u))
        input_gate3 = sigmoid(w_i3.get(u) * h_prev3 + u_i3.get(u) * input3 + b_i3.get(u))
        candidate3 = tanh_act(w_c3.get(u) * h_prev3 + u_c3.get(u) * input3 + b_c3.get(u))
        c_new3 = forget3 * c_prev3 + input_gate3 * candidate3
        output3 = sigmoid(w_o3.get(u) * h_prev3 + u_o3.get(u) * input3 + b_o3.get(u))
        h_new3 = output3 * tanh_act(c_new3)
        
        // Dropout
        h_new3 := h_new3 * dropout_mask3.get(u)

        cell3.set(u, c_new3)
        hidden3.set(u, h_new3)

    // BATCH NORM Layer3
    mean_h3 = 0.0
    for u = 0 to units - 1
        mean_h3 += hidden3.get(u)
    mean_h3 := mean_h3 / units
    
    variance_h3 = 0.0
    for u = 0 to units - 1
        diff = hidden3.get(u) - mean_h3
        variance_h3 += diff * diff
    variance_h3 := variance_h3 / units
    
    for u = 0 to units - 1
        normalized_h3 = (hidden3.get(u) - mean_h3) / math.sqrt(variance_h3 + bn_epsilon)
        scaled_h3 = bn_gamma3 * normalized_h3 + bn_beta3
        hidden3.set(u, scaled_h3)

    // Attention Layer3
    var float[] att3 = array.new_float(units, 0.0)
    sum_exp3 = 0.0
    for u = 0 to units - 1
        hv = hidden3.get(u)
        score = math.exp(math.min(10.0, hv))
        att3.set(u, score)
        sum_exp3 += score

    weighted_hidden3 = 0.0
    for u = 0 to units - 1
        wgt = sum_exp3 > 0 ? att3.get(u) / sum_exp3 : 1.0 / units
        weighted_hidden3 += hidden3.get(u) * wgt

    // --- Layer4 (без Dropout на последнем слое для стабильности прогноза)
    for u = 0 to units - 1
        h_prev4 = hidden4.get(u)
        c_prev4 = cell4.get(u)
        input4 = weighted_hidden3 * w_in_l4.get(u)

        forget4 = sigmoid(w_f4.get(u) * h_prev4 + u_f4.get(u) * input4 + b_f4.get(u))
        input_gate4 = sigmoid(w_i4.get(u) * h_prev4 + u_i4.get(u) * input4 + b_i4.get(u))
        candidate4 = tanh_act(w_c4.get(u) * h_prev4 + u_c4.get(u) * input4 + b_c4.get(u))
        c_new4 = forget4 * c_prev4 + input_gate4 * candidate4
        output4 = sigmoid(w_o4.get(u) * h_prev4 + u_o4.get(u) * input4 + b_o4.get(u))
        h_new4 = output4 * tanh_act(c_new4)

        cell4.set(u, c_new4)
        hidden4.set(u, h_new4)

    // --- Forecast output
    forecast = 0.0
    for u = 0 to units - 1
        forecast += hidden4.get(u)
    forecast := forecast / units
    
// ============================================================
// CNN + LSTM BACKPROP (ПОЛНОСТЬЮ ИСПРАВЛЕННАЯ ВЕРСИЯ)
// ============================================================

    var float saved_forecast = na
    var float saved_price = na
    var int saved_bar_index = na
    var bool first_training_done = false

// Обучение только на определенной частоте
    if bar_index % lstm_backprop_frequency == 0 and barstate.isconfirmed and bar_index >= 2
    
        price_stdev = ta.stdev(src, 20)
    
    // BACKPROP: если есть сохраненный прогноз с ПРЕДЫДУЩЕГО ЦИКЛА ОБУЧЕНИЯ
        if not na(price_stdev) and price_stdev > 0.001 and first_training_done
        
        // ВЫЧИСЛЯЕМ СКОЛЬКО БАРОВ ПРОШЛО С ПОСЛЕДНЕГО ОБУЧЕНИЯ
            bars_ago = bar_index - saved_bar_index
        
        // Должно быть равно lstm_backprop_frequency (проверка целостности)
            if bars_ago == lstm_backprop_frequency
            
                // Фактическое изменение от момента СОХРАНЕННОГО прогноза до текущего момента
                actual_price_change = src[0] - saved_price
                actual_change_normalized = actual_price_change / price_stdev
            
                // predicted_change - прогноз сделанный НА ПРЕДЫДУЩЕМ ЦИКЛЕ ОБУЧЕНИЯ
                predicted_change = saved_forecast
            
                // Loss - разница между фактическим и предсказанным изменением
                loss = actual_change_normalized - predicted_change
            
                // ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА ВАЛИДНОСТИ (раскомментируйте при необходимости)
                if not na(loss) and math.abs(loss) < 10.0 and math.abs(predicted_change) < 10.0
                
                    max_grad_norm = 0.5
                    l2_lambda = 0.02
                    weight_decay = 0.002
                
                    // КРИТИЧНО: Используем признаки с ТОГО БАРА, где был сделан СОХРАНЕННЫЙ прогноз
                    lookback_offset = bars_ago  // = lstm_backprop_frequency
                
                    // ПРИЗНАКИ с ПРАВИЛЬНЫМ СМЕЩЕНИЕМ (с бара предыдущего обучения)
                    f_price = math.max(-3.0, math.min(3.0, (src[lookback_offset] - mean_price[lookback_offset]) / math.max(std_price[lookback_offset], 0.001)))
                    f_rsi = math.max(-3.0, math.min(3.0, (rsi_series[lookback_offset] - mean_rsi[lookback_offset]) / math.max(std_rsi[lookback_offset], 0.001)))
                    f_roc = math.max(-3.0, math.min(3.0, (wma_roc_series[lookback_offset] - mean_roc[lookback_offset]) / math.max(std_roc[lookback_offset], 0.001)))
                    f_atr = math.max(-3.0, math.min(3.0, (local_atr[lookback_offset] - mean_atr[lookback_offset]) / math.max(std_atr[lookback_offset], 0.001)))
                    f_volratio = math.max(-3.0, math.min(3.0, (vol_ratio_series[lookback_offset] - mean_vol_ratio[lookback_offset]) / math.max(std_vol_ratio[lookback_offset], 0.001)))
                    f_corrpv = math.max(-3.0, math.min(3.0, (corr_pv_series[lookback_offset] - mean_corr_pv[lookback_offset]) / math.max(std_corr_pv[lookback_offset], 0.001)))
                    f_corrpm = math.max(-3.0, math.min(3.0, (corr_pm_series[lookback_offset] - mean_corr_pm[lookback_offset]) / math.max(std_corr_pm[lookback_offset], 0.001)))
                    f_rsi_vol = math.max(-3.0, math.min(3.0, (rsi_vol_series[lookback_offset] - mean_rsi_vol[lookback_offset]) / math.max(std_rsi_vol[lookback_offset], 0.001)))
                    f_slope = math.max(-3.0, math.min(3.0, (slope_series[lookback_offset] - mean_slope[lookback_offset]) / math.max(std_slope[lookback_offset], 0.001)))
                    f_volume = math.max(-3.0, math.min(3.0, (volume_series[lookback_offset] - mean_volume[lookback_offset]) / math.max(std_volume[lookback_offset], 0.001)))
                    f_macd = math.max(-3.0, math.min(3.0, (macd_series[lookback_offset] - mean_macd[lookback_offset]) / math.max(std_macd[lookback_offset], 0.001)))
                    f_entropy = math.max(-3.0, math.min(3.0, (entropy_series[lookback_offset] - mean_entropy[lookback_offset]) / math.max(std_entropy[lookback_offset], 0.001)))
                
                    // CNN MOMENTUM ИНИЦИАЛИЗАЦИЯ
                    var bool cnn_momentum_initialized = false
                    if not cnn_momentum_initialized
                        total_weights = array.size(cnn_weights_flat)
                        for i = 0 to total_weights - 1
                            array.push(mv_cnn_weights, 0.0)
                        cnn_momentum_initialized := true
                
                    // CNN BACKPROP (ИСПРАВЛЕННЫЙ - добавляем lookback_offset)
                    weight_idx = 0
                    for window_idx = 0 to 2
                        current_window = array.get(cnn_windows, window_idx)
                        for filter_idx = 0 to cnn_filters - 1
                            for weight_pos = 0 to current_window - 1
                                if weight_idx < array.size(cnn_weights_flat)
                                    // КРИТИЧНО: добавляем lookback_offset для согласования с признаками
                                    lookback_base = math.max(5, current_window) + lookback_offset
                                    price_idx1 = lookback_base + weight_pos
                                    price_idx2 = lookback_base + weight_pos + 1
                                
                                    if price_idx2 < bar_index and price_idx1 >= 0
                                        prev_weight = array.get(cnn_weights_flat, weight_idx)
                                        if not na(src[price_idx1]) and not na(src[price_idx2])
                                            price_diff_raw = src[price_idx1] - src[price_idx2]
                                            // Используем price_stdev текущего бара
                                            price_diff_norm = price_diff_raw / math.max(price_stdev, 0.001)
                                            price_diff_clamped = math.max(-2.0, math.min(2.0, price_diff_norm))
                                        
                                            cnn_grad = -loss * price_diff_clamped - l2_lambda * prev_weight - weight_decay * math.sign(prev_weight)
                                            grad_norm = math.abs(cnn_grad)
                                            if grad_norm > max_grad_norm
                                                cnn_grad := (max_grad_norm / grad_norm) * cnn_grad
                                        
                                            adaptive_lr = alpha_adaptive * math.exp(-0.0005 * weight_idx)
                                            cnn_weight_delta = adaptive_lr * cnn_grad
                                        
                                            if weight_idx < array.size(mv_cnn_weights)
                                                prev_momentum = array.get(mv_cnn_weights, weight_idx)
                                                new_momentum = 0.9 * prev_momentum + 0.1 * cnn_weight_delta
                                                array.set(mv_cnn_weights, weight_idx, new_momentum)
                                                cnn_weight_delta := new_momentum
                                        
                                            new_weight = prev_weight + cnn_weight_delta
                                            weight_abs_limit = 1.5
                                            if math.abs(new_weight) > weight_abs_limit
                                                excess = math.abs(new_weight) - weight_abs_limit
                                                new_weight := new_weight * math.exp(-0.5 * excess)
                                        
                                            if not na(new_weight)
                                                array.set(cnn_weights_flat, weight_idx, new_weight)
                                weight_idx += 1
                
                    // LSTM LAYER 4 BACKPROP
                    for u = 0 to units - 1
                        delta_loss_w_f4 = loss * tanh_act(hidden4.get(u))
                        grad_norm = math.abs(delta_loss_w_f4)
                        if grad_norm > max_grad_norm
                            delta_loss_w_f4 := delta_loss_w_f4 * (max_grad_norm / grad_norm)
                        prev_mv_w_f4 = mv_w_f4.get(u)
                        new_mv_w_f4 = momentum * prev_mv_w_f4 + alpha_adaptive * delta_loss_w_f4
                        mv_w_f4.set(u, new_mv_w_f4)
                        prev_weight = w_f4.get(u)
                        new_weight = prev_weight + new_mv_w_f4 - l2_lambda * prev_weight
                        w_f4.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        delta_loss_u_f4 = loss * tanh_act(weighted_hidden3)
                        grad_norm := math.abs(delta_loss_u_f4)
                        if grad_norm > max_grad_norm
                            delta_loss_u_f4 := delta_loss_u_f4 * (max_grad_norm / grad_norm)
                        prev_mv_u_f4 = mv_u_f4.get(u)
                        new_mv_u_f4 = momentum * prev_mv_u_f4 + alpha_adaptive * delta_loss_u_f4
                        mv_u_f4.set(u, new_mv_u_f4)
                        prev_weight := u_f4.get(u)
                        new_weight := prev_weight + new_mv_u_f4 - l2_lambda * prev_weight
                        u_f4.set(u, math.max(w_min, math.min(w_max, new_weight)))
                
                    // LSTM LAYER 3 BACKPROP
                    for u = 0 to units - 1
                        delta_loss_w_f3 = loss * tanh_act(hidden3.get(u))
                        grad_norm = math.abs(delta_loss_w_f3)
                        if grad_norm > max_grad_norm
                            delta_loss_w_f3 := delta_loss_w_f3 * (max_grad_norm / grad_norm)
                        prev_mv_w_f3 = mv_w_f3.get(u)
                        new_mv_w_f3 = momentum * prev_mv_w_f3 + alpha_adaptive * delta_loss_w_f3
                        mv_w_f3.set(u, new_mv_w_f3)
                        prev_weight = w_f3.get(u)
                        new_weight = prev_weight + new_mv_w_f3 - l2_lambda * prev_weight
                        w_f3.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        delta_loss_u_f3 = loss * tanh_act(weighted_hidden2)
                        grad_norm := math.abs(delta_loss_u_f3)
                        if grad_norm > max_grad_norm
                            delta_loss_u_f3 := delta_loss_u_f3 * (max_grad_norm / grad_norm)
                        prev_mv_u_f3 = mv_u_f3.get(u)
                        new_mv_u_f3 = momentum * prev_mv_u_f3 + alpha_adaptive * delta_loss_u_f3
                        mv_u_f3.set(u, new_mv_u_f3)
                        prev_weight := u_f3.get(u)
                        new_weight := prev_weight + new_mv_u_f3 - l2_lambda * prev_weight
                        u_f3.set(u, math.max(w_min, math.min(w_max, new_weight)))
                
                // LSTM LAYER 2 BACKPROP
                    for u = 0 to units - 1
                        delta_loss_w_f2 = loss * tanh_act(hidden2.get(u))
                        grad_norm = math.abs(delta_loss_w_f2)
                        if grad_norm > max_grad_norm
                            delta_loss_w_f2 := delta_loss_w_f2 * (max_grad_norm / grad_norm)
                        prev_mv_w_f2 = mv_w_f2.get(u)
                        new_mv_w_f2 = momentum * prev_mv_w_f2 + alpha_adaptive * delta_loss_w_f2
                        mv_w_f2.set(u, new_mv_w_f2)
                        prev_weight = w_f2.get(u)
                        new_weight = prev_weight + new_mv_w_f2 - l2_lambda * prev_weight
                        w_f2.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        delta_loss_u_f2 = loss * tanh_act(weighted_hidden1)
                        grad_norm := math.abs(delta_loss_u_f2)
                        if grad_norm > max_grad_norm
                            delta_loss_u_f2 := delta_loss_u_f2 * (max_grad_norm / grad_norm)
                        prev_mv_u_f2 = mv_u_f2.get(u)
                        new_mv_u_f2 = momentum * prev_mv_u_f2 + alpha_adaptive * delta_loss_u_f2
                        mv_u_f2.set(u, new_mv_u_f2)
                        prev_weight := u_f2.get(u)
                        new_weight := prev_weight + new_mv_u_f2 - l2_lambda * prev_weight
                        u_f2.set(u, math.max(w_min, math.min(w_max, new_weight)))
                
                    // LSTM LAYER 1 BACKPROP (ALL INPUT WEIGHTS)
                    for u = 0 to units - 1
                        // Price
                        delta_loss_w_in_price = loss * f_price
                        grad_norm = math.abs(delta_loss_w_in_price)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_price := delta_loss_w_in_price * (max_grad_norm / grad_norm)
                        prev_mv_w_in_price = mv_w_in_price.get(u)
                        new_mv_w_in_price = momentum * prev_mv_w_in_price + alpha_adaptive * delta_loss_w_in_price
                        mv_w_in_price.set(u, new_mv_w_in_price)
                        prev_weight = w_in_price.get(u)
                        new_weight = prev_weight + new_mv_w_in_price - l2_lambda * prev_weight
                        w_in_price.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // RSI
                        delta_loss_w_in_rsi = loss * f_rsi
                        grad_norm := math.abs(delta_loss_w_in_rsi)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_rsi := delta_loss_w_in_rsi * (max_grad_norm / grad_norm)
                        prev_mv_w_in_rsi = mv_w_in_rsi.get(u)
                        new_mv_w_in_rsi = momentum * prev_mv_w_in_rsi + alpha_adaptive * delta_loss_w_in_rsi
                        mv_w_in_rsi.set(u, new_mv_w_in_rsi)
                        prev_weight := w_in_rsi.get(u)
                        new_weight := prev_weight + new_mv_w_in_rsi - l2_lambda * prev_weight
                        w_in_rsi.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // ROC
                        delta_loss_w_in_roc = loss * f_roc
                        grad_norm := math.abs(delta_loss_w_in_roc)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_roc := delta_loss_w_in_roc * (max_grad_norm / grad_norm)
                        prev_mv_w_in_roc = mv_w_in_roc.get(u)
                        new_mv_w_in_roc = momentum * prev_mv_w_in_roc + alpha_adaptive * delta_loss_w_in_roc
                        mv_w_in_roc.set(u, new_mv_w_in_roc)
                        prev_weight := w_in_roc.get(u)
                        new_weight := prev_weight + new_mv_w_in_roc - l2_lambda * prev_weight
                        w_in_roc.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // ATR
                        delta_loss_w_in_atr = loss * f_atr
                        grad_norm := math.abs(delta_loss_w_in_atr)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_atr := delta_loss_w_in_atr * (max_grad_norm / grad_norm)
                        prev_mv_w_in_atr = mv_w_in_atr.get(u)
                        new_mv_w_in_atr = momentum * prev_mv_w_in_atr + alpha_adaptive * delta_loss_w_in_atr
                        mv_w_in_atr.set(u, new_mv_w_in_atr)
                        prev_weight := w_in_atr.get(u)
                        new_weight := prev_weight + new_mv_w_in_atr - l2_lambda * prev_weight
                        w_in_atr.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // VolRatio
                        delta_loss_w_in_volratio = loss * f_volratio
                        grad_norm := math.abs(delta_loss_w_in_volratio)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_volratio := delta_loss_w_in_volratio * (max_grad_norm / grad_norm)
                        prev_mv_w_in_volratio = mv_w_in_volratio.get(u)
                        new_mv_w_in_volratio = momentum * prev_mv_w_in_volratio + alpha_adaptive * delta_loss_w_in_volratio
                        mv_w_in_volratio.set(u, new_mv_w_in_volratio)
                        prev_weight := w_in_volratio.get(u)
                        new_weight := prev_weight + new_mv_w_in_volratio - l2_lambda * prev_weight
                        w_in_volratio.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // CorrPV
                        delta_loss_w_in_corrpv = loss * f_corrpv
                        grad_norm := math.abs(delta_loss_w_in_corrpv)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_corrpv := delta_loss_w_in_corrpv * (max_grad_norm / grad_norm)
                        prev_mv_w_in_corrpv = mv_w_in_corrpv.get(u)
                        new_mv_w_in_corrpv = momentum * prev_mv_w_in_corrpv + alpha_adaptive * delta_loss_w_in_corrpv
                        mv_w_in_corrpv.set(u, new_mv_w_in_corrpv)
                        prev_weight := w_in_corrpv.get(u)
                        new_weight := prev_weight + new_mv_w_in_corrpv - l2_lambda * prev_weight
                        w_in_corrpv.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // CorrPM
                        delta_loss_w_in_corrpm = loss * f_corrpm
                        grad_norm := math.abs(delta_loss_w_in_corrpm)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_corrpm := delta_loss_w_in_corrpm * (max_grad_norm / grad_norm)
                        prev_mv_w_in_corrpm = mv_w_in_corrpm.get(u)
                        new_mv_w_in_corrpm = momentum * prev_mv_w_in_corrpm + alpha_adaptive * delta_loss_w_in_corrpm
                        mv_w_in_corrpm.set(u, new_mv_w_in_corrpm)
                        prev_weight := w_in_corrpm.get(u)
                        new_weight := prev_weight + new_mv_w_in_corrpm - l2_lambda * prev_weight
                        w_in_corrpm.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // RSI_Vol
                        delta_loss_w_in_rsi_vol = loss * f_rsi_vol
                        grad_norm := math.abs(delta_loss_w_in_rsi_vol)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_rsi_vol := delta_loss_w_in_rsi_vol * (max_grad_norm / grad_norm)
                        prev_mv_w_in_rsi_vol = mv_w_in_rsi_vol.get(u)
                        new_mv_w_in_rsi_vol = momentum * prev_mv_w_in_rsi_vol + alpha_adaptive * delta_loss_w_in_rsi_vol
                        mv_w_in_rsi_vol.set(u, new_mv_w_in_rsi_vol)
                        prev_weight := w_in_rsi_vol.get(u)
                        new_weight := prev_weight + new_mv_w_in_rsi_vol - l2_lambda * prev_weight
                        w_in_rsi_vol.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // Slope
                        delta_loss_w_in_slope = loss * f_slope
                        grad_norm := math.abs(delta_loss_w_in_slope)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_slope := delta_loss_w_in_slope * (max_grad_norm / grad_norm)
                        prev_mv_w_in_slope = mv_w_in_slope.get(u)
                        new_mv_w_in_slope = momentum * prev_mv_w_in_slope + alpha_adaptive * delta_loss_w_in_slope
                        mv_w_in_slope.set(u, new_mv_w_in_slope)
                        prev_weight := w_in_slope.get(u)
                        new_weight := prev_weight + new_mv_w_in_slope - l2_lambda * prev_weight
                        w_in_slope.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // Volume
                        delta_loss_w_in_volume = loss * f_volume
                        grad_norm := math.abs(delta_loss_w_in_volume)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_volume := delta_loss_w_in_volume * (max_grad_norm / grad_norm)
                        prev_mv_w_in_volume = mv_w_in_volume.get(u)
                        new_mv_w_in_volume = momentum * prev_mv_w_in_volume + alpha_adaptive * delta_loss_w_in_volume
                        mv_w_in_volume.set(u, new_mv_w_in_volume)
                        prev_weight := w_in_volume.get(u)
                        new_weight := prev_weight + new_mv_w_in_volume - l2_lambda * prev_weight
                        w_in_volume.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // MACD
                        delta_loss_w_in_macd = loss * f_macd
                        grad_norm := math.abs(delta_loss_w_in_macd)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_macd := delta_loss_w_in_macd * (max_grad_norm / grad_norm)
                        prev_mv_w_in_macd = mv_w_in_macd.get(u)
                        new_mv_w_in_macd = momentum * prev_mv_w_in_macd + alpha_adaptive * delta_loss_w_in_macd
                        mv_w_in_macd.set(u, new_mv_w_in_macd)
                        prev_weight := w_in_macd.get(u)
                        new_weight := prev_weight + new_mv_w_in_macd - l2_lambda * prev_weight
                        w_in_macd.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // Entropy
                        delta_loss_w_in_entropy = loss * f_entropy
                        grad_norm := math.abs(delta_loss_w_in_entropy)
                        if grad_norm > max_grad_norm
                            delta_loss_w_in_entropy := delta_loss_w_in_entropy * (max_grad_norm / grad_norm)
                        prev_mv_w_in_entropy = mv_w_in_entropy.get(u)
                        new_mv_w_in_entropy = momentum * prev_mv_w_in_entropy + alpha_adaptive * delta_loss_w_in_entropy
                        mv_w_in_entropy.set(u, new_mv_w_in_entropy)
                        prev_weight := w_in_entropy.get(u)
                        new_weight := prev_weight + new_mv_w_in_entropy - l2_lambda * prev_weight
                        w_in_entropy.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // Forget gate Layer1
                        delta_loss_w_f1 = loss * tanh_act(hidden1.get(u))
                        grad_norm := math.abs(delta_loss_w_f1)
                        if grad_norm > max_grad_norm
                            delta_loss_w_f1 := delta_loss_w_f1 * (max_grad_norm / grad_norm)
                        prev_mv_w_f1 = mv_w_f1.get(u)
                        new_mv_w_f1 = momentum * prev_mv_w_f1 + alpha_adaptive * delta_loss_w_f1
                        mv_w_f1.set(u, new_mv_w_f1)
                        prev_weight := w_f1.get(u)
                        new_weight := prev_weight + new_mv_w_f1 - l2_lambda * prev_weight
                        w_f1.set(u, math.max(w_min, math.min(w_max, new_weight)))
                    
                        // CNN input weight
                        for f = 0 to math.min(total_cnn_features - 1, units - 1)
                            if f < array.size(norm_cnn_features_multi)
                                delta_loss_w_in_cnn = loss * array.get(norm_cnn_features_multi, f)
                                grad_norm := math.abs(delta_loss_w_in_cnn)
                                if grad_norm > max_grad_norm
                                    delta_loss_w_in_cnn := delta_loss_w_in_cnn * (max_grad_norm / grad_norm)
                                prev_mv_w_in_cnn = mv_w_in_cnn.get(u)
                                new_mv_w_in_cnn = momentum * prev_mv_w_in_cnn + alpha_adaptive * delta_loss_w_in_cnn
                                mv_w_in_cnn.set(u, new_mv_w_in_cnn)
                                prev_weight := w_in_cnn.get(u)
                                new_weight := prev_weight + new_mv_w_in_cnn - l2_lambda * prev_weight
                                w_in_cnn.set(u, math.max(w_min, math.min(w_max, new_weight)))
    
        // КРИТИЧНО: Сохраняем ТЕКУЩИЙ прогноз ПОСЛЕ backprop для следующего цикла
        // ДОЛЖНО БЫТЬ ВНЕ условия first_training_done!
        saved_forecast := forecast
        saved_price := src[0]
        saved_bar_index := bar_index
        first_training_done := true

    forecast


// ============================================================
// УЛУЧШЕННЫЙ SVR с Multi-Kernel, Adaptive Selection и Online Learning
// ============================================================

svr_forecast(float src, int len, float decay_rate_base, float kernel_scale_base) =>
    if len <= 1 or bar_index < 20
        nz(src, close)
    else
        adjusted_len = math.min(len, bar_index + 1)
        adjusted_len := math.max(1, adjusted_len)
        
        // ============================================================
        // 1. ИЗВЛЕЧЕНИЕ ПРИЗНАКОВ (улучшенное)
        // ============================================================
        
        // Базовые индикаторы
        rsi_series = ta.rsi(src, 14)
        roc_series = ta.roc(src, 10)
        wma_roc_series = ta.wma(roc_series, 5)
        [macd_line, signal_line, macd_hist] = ta.macd(close, 12, 26, 9)
        local_atr = nz(ta.atr(14), ta.tr(handle_na=true))
        adx_series = f_custom_adx(high, low, close, 14)
        
        // НОВОЕ: Дополнительные признаки
        [bb_lower, bb_middle, bb_upper] = ta.bb(src, 20, 2)
        bb_position = (src - bb_lower) / math.max(bb_upper - bb_lower, 1e-10)  // Позиция в BB
        bb_width_normalized = (bb_upper - bb_lower) / math.max(bb_middle, 1e-10)
        
        // Ускорение (2-я производная)
        acceleration = ta.roc(wma_roc_series, 5)
        
        // Нормализованные значения
        rsi_val = nz(rsi_series, 50)
        momentum_val = nz(wma_roc_series, 0)
        sma_val = nz(ta.sma(src, 20), close)
        stdev_val = nz(ta.stdev(src, 20), sma_val * 0.01)
        volume_sma = nz(ta.sma(volume, 20), volume)
        volatility = stdev_val / math.max(sma_val, 1e-10)
        
        // Текущие значения для сравнения
        current_adx = nz(adx_series, 20)
        current_macd = nz(macd_line, 0)
        current_macd_hist = nz(macd_hist, 0)
        current_volume = nz(volume, volume_sma)
        current_acceleration = nz(acceleration, 0)
        current_bb_position = bb_position
        
        // K-means++ признаки
        current_volume_ratio = nz(km_safe_volume_ratio, 1.0)
        current_corr_price_volume = nz(km_safe_corr_price_volume, 0.0)
        current_corr_price_macd = nz(km_safe_corr_price_macd, 0.0)
        current_rsi_volatility = nz(km_safe_rsi_volatility, 0.0)
        current_entropy = nz(km_safe_entropy, 0.0)
        
        // ============================================================
        // 2. АДАПТИВНЫЕ ПАРАМЕТРЫ (улучшенные)
        // ============================================================
        
        // Адаптивная скорость затухания
        // Учитываем волатильность, энтропию и силу тренда
        trend_strength = math.abs(ta.ema(close, 12) - ta.ema(close, 26)) / ta.ema(close, 26)
        float adaptive_decay_rate = decay_rate_base / (1.0 + volatility * 0.15 + (1 - current_entropy) * 0.25 + trend_strength * 0.1)
        adaptive_decay_rate := math.max(0.01, math.min(0.5, adaptive_decay_rate))
        
        // НОВОЕ: Адаптивный выбор ядра на основе режима
        float confidence_normalized = math.max(0.0, math.min(1.0, nz(cluster_confidence, 0.5)))
        
        var int kernel_type = 0  // 0 = RBF, 1 = Polynomial, 2 = Hybrid
        
        // Выбор ядра на основе режима и уверенности
        if is_flat and confidence_normalized > 0.7
            kernel_type := 0  // RBF для флэта (локальные паттерны)
        else if (is_bull_trend or is_bear_trend) and trend_strength > 0.02
            kernel_type := 1  // Polynomial для трендов (глобальные паттерны)
        else
            kernel_type := 2  // Hybrid для неопределенности
        
        // Адаптивный масштаб ядра
        float adaptive_kernel_scale = kernel_scale_base
        if is_flat
            adaptive_kernel_scale := kernel_scale_base * 0.6  // Более широкое ядро
        else if confidence_normalized > 0.7
            adaptive_kernel_scale := kernel_scale_base * (1.2 + confidence_normalized * 0.3)
        else
            adaptive_kernel_scale := kernel_scale_base * 0.9
        
        adaptive_kernel_scale := math.max(0.1, math.min(5.0, adaptive_kernel_scale))
        
        // Динамическая регуляризация
        float reg_lambda = 0.5
        if is_flat
            reg_lambda := 1.8  // Сильная регуляризация во флэте
        else if volatility > 0.03
            reg_lambda := 0.3  // Слабая регуляризация в волатильности
        else
            reg_lambda := 0.7
        
        // ============================================================
        // 3. ВЗВЕШЕННОЕ ЯДРО С РАСШИРЕННЫМИ ПРИЗНАКАМИ
        // ============================================================
        
        float prediction = 0.0
        float sum_weights = 0.0
        float sum_weighted = 0.0
        
        // НОВОЕ: Отслеживаем количество значимых точек
        int significant_points = 0
        
        for i = 0 to adjusted_len - 1
            // Временной вес (экспоненциальное затухание)
            weight = math.exp(-adaptive_decay_rate * i)
            
            // Историческая цена
            y = i <= bar_index ? nz(src[i], close) : nz(src, close)
            
            // ========================================
            // РАСЧЕТ РАССТОЯНИЙ (расширенный набор)
            // ========================================
            
            // Базовые расстояния
            dist_price = math.pow(i - (adjusted_len - 1), 2) / (adjusted_len * adjusted_len)  // Нормализовано
            dist_rsi = math.pow(nz(ta.rsi(src, 14)[i], rsi_val) - rsi_val, 2) / 10000
            dist_mom = math.pow(nz(wma_roc_series[i], momentum_val) - momentum_val, 2) / 1000
            dist_atr = math.pow(nz(ta.atr(14)[i], local_atr) - local_atr, 2) / math.max(local_atr * local_atr, 1e-10)
            dist_adx = math.pow(nz(adx_series[i], 20) - current_adx, 2) / 400
            dist_macd = math.pow(nz(macd_line[i], 0) - current_macd, 2) / math.max(nz(ta.sma(math.abs(macd_line), 20), 1e-10), 1e-10)
            dist_volume = math.pow(nz(volume[i], current_volume) - current_volume, 2) / math.max(volume_sma * volume_sma, 1e-10)
            
            // НОВОЕ: Дополнительные расстояния
            dist_macd_hist = math.pow(nz(macd_hist[i], 0) - current_macd_hist, 2) / 1000
            dist_acceleration = math.pow(nz(acceleration[i], 0) - current_acceleration, 2) / 1000
            bb_pos_i = nz((src[i] - bb_lower[i]) / math.max(bb_upper[i] - bb_lower[i], 1e-10), 0.5)
            dist_bb_position = math.pow(bb_pos_i - current_bb_position, 2)
            
            // K-means++ расстояния
            dist_volume_ratio = math.pow(nz(km_safe_volume_ratio[i], current_volume_ratio) - current_volume_ratio, 2) / 1000
            dist_corr_price_volume = math.pow(nz(km_safe_corr_price_volume[i], current_corr_price_volume) - current_corr_price_volume, 2) / 1000
            dist_corr_price_macd = math.pow(nz(km_safe_corr_price_macd[i], current_corr_price_macd) - current_corr_price_macd, 2) / 1000
            dist_rsi_volatility = math.pow(nz(km_safe_rsi_volatility[i], current_rsi_volatility) - current_rsi_volatility, 2) / 1000
            dist_entropy = math.pow(nz(km_safe_entropy[i], current_entropy) - current_entropy, 2)
            
            // ========================================
            // MULTI-KERNEL COMPUTATION
            // ========================================
            
            // Суммарное расстояние (взвешенное)
            total_distance = 0.3 * dist_price +          // Время (30%)
                           0.15 * dist_rsi +             // Технические (15%)
                           0.1 * dist_mom +
                           0.05 * dist_atr +
                           0.05 * dist_adx +
                           0.1 * dist_macd +
                           0.05 * dist_macd_hist +
                           0.05 * dist_acceleration +
                           0.05 * dist_bb_position +
                           0.05 * dist_volume +          // Объем (5%)
                           0.025 * dist_volume_ratio +   // K-means (5%)
                           0.025 * dist_corr_price_volume +
                           0.025 * dist_corr_price_macd +
                           0.025 * dist_rsi_volatility +
                           0.05 * dist_entropy           // Энтропия (5%)
            
            // Выбор функции ядра
            float kernel_val = 0.0
            
            if kernel_type == 0
                // RBF Kernel (Gaussian)
                kernel_val := math.exp(-adaptive_kernel_scale * total_distance + reg_lambda)
            else if kernel_type == 1
                // Polynomial Kernel
                kernel_val := math.pow(1.0 + adaptive_kernel_scale * total_distance, 2) * math.exp(reg_lambda)
            else
                // Hybrid Kernel (комбинация)
                rbf_part = math.exp(-adaptive_kernel_scale * total_distance)
                poly_part = math.pow(1.0 + adaptive_kernel_scale * total_distance * 0.5, 2)
                kernel_val := (0.6 * rbf_part + 0.4 * poly_part) * math.exp(reg_lambda)
            
            // НОВОЕ: Фильтрация незначительных точек
            if kernel_val > 0.01  // Порог значимости
                sum_weights += weight * kernel_val
                sum_weighted += weight * y * kernel_val
                significant_points += 1
        
        // ========================================
        // ПРОГНОЗ С ЗАЩИТОЙ ОТ НЕСТАБИЛЬНОСТИ
        // ========================================
        
        // Проверка на достаточность данных
        if significant_points < 3 or sum_weights < 1e-10
            prediction := nz(src, close)  // Fallback к текущей цене
        else
            prediction := sum_weighted / sum_weights
        
        // ============================================================
        // 4. ПОСТОБРАБОТКА И КОРРЕКЦИЯ (улучшенная)
        // ============================================================
        
        // Адаптивное сглаживание волатильности
        float smooth_vol = ta.ema(volatility, 5)
        
        // Адаптивный max_move на основе режима и уверенности
        float max_move_factor = 2.0
        if is_flat
            max_move_factor := 0.8  // Консервативно во флэте
        else if confidence_normalized > 0.8
            max_move_factor := 2.5  // Агрессивно при уверенности
        else
            max_move_factor := 1.5
        
        max_move = local_atr * max_move_factor * math.sqrt(adjusted_len) * (1 + smooth_vol * 0.3)
        
        // НОВОЕ: Коррекция на основе momentum и acceleration
        float trend_adj = nz(ta.wma(ta.roc(src, 5), 3), 0) * 0.05
        float accel_adj = current_acceleration * 0.02
        
        float confidence_boost = math.max(1.0, 1.0 + confidence_normalized * 0.6)
        
        if is_bull_trend
            trend_adj *= confidence_boost
            accel_adj *= 1.2  // Усиливаем ускорение в бычьем тренде
        else if is_bear_trend
            trend_adj *= (2.0 - confidence_boost)
            accel_adj *= 1.2
        else if is_flat
            trend_adj *= 0.3  // Сильное подавление во флэте
            accel_adj *= 0.5
        
        // НОВОЕ: Mean Reversion коррекция во флэте
        float mean_reversion_adj = 0.0
        if is_flat and confidence_normalized > 0.7
            deviation_from_sma = (src - sma_val) / math.max(sma_val, 1e-10)
            mean_reversion_adj := -deviation_from_sma * 0.3 * sma_val  // Тянем к среднему
        
        // Итоговая коррекция
        total_adjustment = (trend_adj + accel_adj) * adjusted_len + mean_reversion_adj
        
        // ========================================
        // ФИНАЛЬНОЕ ОГРАНИЧЕНИЕ С УМНЫМ КЛИППИНГОМ
        // ========================================
        
        predicted_value = prediction + total_adjustment
        
        // Мягкое ограничение (не жесткий clamp)
        upper_bound = nz(src, close) + max_move
        lower_bound = nz(src, close) - max_move
        
        if predicted_value > upper_bound
            // Экспоненциальное затухание превышения
            excess = predicted_value - upper_bound
            predicted_value := upper_bound + excess * math.exp(-excess / max_move)
        else if predicted_value < lower_bound
            // Экспоненциальное затухание превышения
            excess = lower_bound - predicted_value
            predicted_value := lower_bound - excess * math.exp(-excess / max_move)
        
        // НОВОЕ: EMA-сглаживание прогноза для стабильности
        var float smoothed_prediction = close
        smoothed_prediction := ta.ema(predicted_value, 3)
        
        smoothed_prediction


// ============================================================================
// --- Раздел 1: Вспомогательные функции и вычисление признаков ---
// =============================================================================

// Choppiness Index (энтропия/шум)
f_choppiness_index(int len) =>
    atr_sum = math.sum(ta.atr(1), len)
    high_low_range = ta.highest(high, len) - ta.lowest(low, len)
    if high_low_range == 0
        0.0
    else
        100 * math.log10(atr_sum / high_low_range) / math.log10(len)

// --- 2. Вычисление всех признаков ---
ema_fast = ta.ema(close, 21)
ema_slow = ta.ema(close, 55)
[adx_series, _, _] = ta.dmi(14, 14)
[macd_line_feat, _, _] = ta.macd(close, 12, 26, 9)

adx_threshold_flat = 20.0
adx_threshold_strong = 40.0

feature_volume_ratio = high > low ? volume / (high - low) : 0
feature_corr_price_volume = ta.correlation(close, volume, 20)
feature_corr_price_macd = na(ta.correlation(close, macd_line_feat, 20)) ? 0.0 : ta.correlation(close, macd_line_feat, 20)
feature_rsi_volatility = ta.stdev(ta.rsi(close, 14), 10)
feature_entropy = f_choppiness_index(14)

// ============================================================
// XGBOOST ADVANCED - Полная улучшенная версия
// 15 признаков, Feature Importance, Multi-Factor Correction
// ============================================================
xgb_forecast(series float src, int len, float base_learning_rate, int base_max_depth, 
                     bool _is_bull, bool _is_bear, bool _is_flat, float _confidence, 
                     series float _vol_ratio, series float _corr_pv, series float _corr_pm, 
                     series float _rsi_vol, series float _entropy) =>
    
    if len <= 1 or bar_index < len
        src[1]
    else
        // ============================================================
        // 1. ИЗВЛЕЧЕНИЕ ПРИЗНАКОВ (15 признаков)
        // ============================================================
        
        // Базовые индикаторы
        rsi_series = ta.rsi(src, 14)
        [macd_line, signal_line, macd_hist] = ta.macd(src, 12, 26, 9)
        obv_series = ta.cum(math.sign(ta.change(src)) * volume)
        wma_roc_series = ta.wma(ta.roc(src, 10), 5)
        
        // НОВЫЕ: Дополнительные индикаторы
        stoch_k = ta.stoch(src, high, low, 14)
        [bb_lower, bb_middle, bb_upper] = ta.bb(src, 20, 2)
        bb_position = (src - bb_lower) / math.max(bb_upper - bb_lower, 1e-10)
        bb_width = (bb_upper - bb_lower) / bb_middle
        acceleration = ta.roc(wma_roc_series, 5)  // 2-я производная
        volume_delta = volume - ta.sma(volume, 20)
        
        // Нормализация (Z-score)
        norm_len = math.max(len, 20)
        norm_rsi = f_zscore(rsi_series, norm_len)
        norm_macd_hist = f_zscore(macd_hist, norm_len)
        norm_adx = f_zscore(adx_series, norm_len)
        norm_obv = f_zscore(obv_series, norm_len)
        norm_wma_roc = f_zscore(wma_roc_series, norm_len)
        norm_vol_ratio = f_zscore(_vol_ratio, norm_len)
        norm_corr_pv = f_zscore(_corr_pv, norm_len)
        norm_corr_pm = f_zscore(_corr_pm, norm_len)
        norm_rsi_vol = f_zscore(_rsi_vol, norm_len)
        norm_entropy = f_zscore(_entropy, norm_len)
        norm_stoch = f_zscore(stoch_k, norm_len)
        norm_bb_position = f_zscore(bb_position, norm_len)
        norm_bb_width = f_zscore(bb_width, norm_len)
        norm_acceleration = f_zscore(acceleration, norm_len)
        norm_volume_delta = f_zscore(volume_delta, norm_len)
        
        // Feature vector (15 признаков)
        current_features = array.from(norm_rsi[0], norm_macd_hist[0], norm_adx[0], norm_obv[0], norm_wma_roc[0],norm_vol_ratio[0], norm_corr_pv[0], norm_corr_pm[0], norm_rsi_vol[0], norm_entropy[0],norm_stoch[0], norm_bb_position[0], norm_bb_width[0], norm_acceleration[0], norm_volume_delta[0])
        
        // ============================================================
        // 2. FEATURE IMPORTANCE (динамическая)
        // ============================================================
        
        var array<float> feature_importance = array.new_float(15, 1.0)
        
        if _is_bull or _is_bear
            // В тренде momentum важнее
            array.set(feature_importance, 4, 1.5)   // wma_roc
            array.set(feature_importance, 13, 1.3)  // acceleration
            array.set(feature_importance, 1, 1.2)   // macd_hist
            array.set(feature_importance, 10, 1.2)  // stochastic
        else if _is_flat
            // Во флэте mean reversion важнее
            array.set(feature_importance, 0, 1.4)   // rsi
            array.set(feature_importance, 12, 1.5)  // bb_position
            array.set(feature_importance, 11, 1.3)  // bb_width
            array.set(feature_importance, 9, 1.2)   // entropy
        
        // ============================================================
        // 3. АДАПТИВНЫЕ ГИПЕРПАРАМЕТРЫ
        // ============================================================
        
        volatility = ta.stdev(src, 20) / ta.sma(src, 20)
        
        // Learning rate
        trend_factor = _is_flat ? 0.7 : 1.0 + _confidence * 0.8
        adaptive_learning_rate = base_learning_rate * trend_factor
        adaptive_learning_rate := math.max(0.05, math.min(0.3, adaptive_learning_rate))
        
        // Max depth
        depth_factor = _is_flat ? 0.7 : 1.0 + _confidence * 0.5
        adaptive_max_depth = int(math.max(3, math.min(10, base_max_depth * depth_factor)))
        
        // Kernel weight
        adaptive_kernel_weight = (1.0 + math.min(volatility, 2.0)) * (1.5 - _confidence * 0.5)
        adaptive_kernel_weight := math.max(0.5, math.min(5.0, adaptive_kernel_weight))
        
        // L2 Regularization
        l2_lambda = _is_flat ? 0.5 : 0.2
        
        // Subsampling
        subsample_ratio = _confidence > 0.7 ? 0.9 : 0.7
        
        // Количество итераций
        num_iterations = _is_flat ? 4 : 5
        
        // ============================================================
        // 4. НАЧАЛЬНЫЙ ПРОГНОЗ (динамический)
        // ============================================================
        
        float initial_prediction = 0.0
        
        if _is_bull or _is_bear
            // EMA вручную для трендов
            float sum_ema = 0.0
            float weight_sum = 0.0
            float alpha = 2.0 / (len + 1)
            
            for j = 1 to math.min(len, 50)
                weight = math.pow(1.0 - alpha, j - 1)
                sum_ema += src[j] * weight
                weight_sum += weight
            
            initial_prediction := weight_sum > 0 ? sum_ema / weight_sum : src[1]
        else
            // SMA вручную для флэта
            float sum_sma = 0.0
            int count = 0
            
            for j = 1 to math.min(len, 50)
                sum_sma += src[j]
                count += 1
            
            initial_prediction := count > 0 ? sum_sma / count : src[1]
        
        cumulative_prediction = initial_prediction
        target = src - initial_prediction
        
        // ============================================================
        // 5. GRADIENT BOOSTING LOOP
        // ============================================================
        
        var float prev_loss = 1e10
        var int no_improvement_count = 0
        
        for boost_iter = 0 to num_iterations - 1
            float sum_weights = 0.0
            float sum_weighted = 0.0
            float sum_squared_residuals = 0.0
            int valid_samples = 0
            
            for i = 1 to len - 1
                // Subsampling
                if math.random() > subsample_ratio
                    continue
                
                // Исторический feature vector
                historical_features = array.from(norm_rsi[i], norm_macd_hist[i], norm_adx[i], norm_obv[i], norm_wma_roc[i],norm_vol_ratio[i], norm_corr_pv[i], norm_corr_pm[i], norm_rsi_vol[i], norm_entropy[i],norm_stoch[i], norm_bb_position[i], norm_bb_width[i], norm_acceleration[i], norm_volume_delta[i])
                
                // Взвешенное евклидово расстояние
                float total_distance_sq = 0.0
                for f = 0 to 14
                    feature_diff = array.get(current_features, f) - array.get(historical_features, f)
                    importance = array.get(feature_importance, f)
                    total_distance_sq += importance * math.pow(feature_diff, 2)
                
                // RBF Kernel
                kernel_val = math.exp(-total_distance_sq / adaptive_kernel_weight)
                
                // Временной вес
                time_weight = math.exp(-adaptive_learning_rate * i / len)
                
                combined_weight = kernel_val * time_weight
                
                // Tree depth constraint
                if i <= adaptive_max_depth or kernel_val > 0.1
                    sum_weights += combined_weight
                    sum_weighted += target[i] * combined_weight
                    sum_squared_residuals += math.pow(target[i], 2)
                    valid_samples += 1
            
            // Прогноз текущего дерева
            float tree_prediction = 0.0
            if sum_weights > 1e-10 and valid_samples >= 3
                tree_prediction := sum_weighted / sum_weights
                
                // L2 Regularization
                tree_prediction := tree_prediction / (1.0 + l2_lambda)
                
                // Adaptive Shrinkage
                shrinkage_factor = 1.0 - (boost_iter / num_iterations) * 0.3
                tree_prediction := tree_prediction * shrinkage_factor
            
            cumulative_prediction += tree_prediction
            target -= tree_prediction
            
            // Early Stopping
            current_loss = sum_squared_residuals / math.max(valid_samples, 1)
            if current_loss >= prev_loss * 0.999
                no_improvement_count += 1
                if no_improvement_count >= 2
                    break
            else
                no_improvement_count := 0
            prev_loss := current_loss
        
        // ============================================================
        // 6. MULTI-FACTOR КОРРЕКЦИЯ
        // ============================================================
        
        local_atr = ta.atr(14)
        
        // Momentum
        momentum_adj = ta.wma(ta.roc(src, 5), 3) * 0.025 * math.sqrt(len)
        
        // Acceleration
        accel_adj = acceleration * 0.015 * math.sqrt(len)
        
        // Volume surge
        volume_surge = (volume - ta.sma(volume, 20)) / math.max(ta.sma(volume, 20), 1e-10)
        volume_adj = volume_surge * 0.01 * src
        
        float trend_adj = momentum_adj + accel_adj + volume_adj
        
        // Адаптация по режиму
        if _is_bull
            trend_adj *= (1.0 + _confidence * 0.8)
        else if _is_bear
            trend_adj *= (1.0 - _confidence * 0.8)
        else if _is_flat
            // Mean reversion
            mean_reversion = (ta.sma(src, 20) - src) * 0.3
            trend_adj := trend_adj * 0.3 + mean_reversion
        
        final_prediction = cumulative_prediction + trend_adj
        
        // ============================================================
        // 7. МЯГКОЕ ОГРАНИЧЕНИЕ
        // ============================================================
        
        max_move_multiplier = _confidence > 0.8 ? 2.5 : _is_flat ? 0.8 : 1.5
        max_move = local_atr * max_move_multiplier * (1 + volatility * 0.5)
        
        upper_bound = src[0] + max_move
        lower_bound = src[0] - max_move
        
        if final_prediction > upper_bound
            excess = final_prediction - upper_bound
            final_prediction := upper_bound + excess * math.exp(-excess / max_move)
        else if final_prediction < lower_bound
            excess = lower_bound - final_prediction
            final_prediction := lower_bound - excess * math.exp(-excess / max_move)
        
        // ============================================================
        // 8. EMA-СГЛАЖИВАНИЕ
        // ============================================================
        
        var float smoothed_xgb = src
        smoothed_xgb := ta.ema(final_prediction, 2)
        
        smoothed_xgb


// ============================================================
// УЛУЧШЕННЫЙ LIGHTGBM с Kernel-Based Gradient Boosting
// Feature Importance, Multi-Factor Correction и Adaptive Parameters
// ============================================================

lgbm_forecast(src, len, decay_rate, max_depth) =>
    if len <= 1 or bar_index < 20
        nz(src, close)
    else
        // ============================================================
        // 1. ИЗВЛЕЧЕНИЕ ПРИЗНАКОВ (15 признаков)
        // ============================================================
        
        // Базовые технические индикаторы
        rsi_series = ta.rsi(src, 14)
        roc_series = ta.roc(src, 10)
        wma_roc_series = ta.wma(roc_series, 5)
        local_atr = nz(ta.atr(14), ta.tr(handle_na=true))
        [macd_line, signal_line, macd_hist] = ta.macd(src, 12, 26, 9)
        adx_val = f_custom_adx(high, low, close, 14)
        
        // Дополнительные индикаторы
        stoch_k = ta.stoch(src, high, low, 14)
        [bb_lower, bb_middle, bb_upper] = ta.bb(src, 20, 2)
        bb_width = (bb_upper - bb_lower) / nz(bb_middle, src)
        bb_position = (src - bb_lower) / math.max(bb_upper - bb_lower, 1e-10)
        cci = ta.cci(src, 20)
        obv_series = ta.cum(math.sign(ta.change(src)) * volume)
        
        // Ускорение (2-я производная)
        acceleration = ta.roc(wma_roc_series, 5)
        
        // K-means++ признаки
        volume_ratio = km_safe_volume_ratio
        price_vol_corr = km_safe_corr_price_volume
        price_macd_corr = km_safe_corr_price_macd
        rsi_volatility = km_safe_rsi_volatility
        entropy_val = km_safe_entropy
        current_cluster = num_clusters > 0 ? km_current_cluster / math.max(num_clusters, 1) : 0.5
        confidence_normalized = math.max(0.0, math.min(1.0, nz(cluster_confidence, 0.5)))
        
        // Нормализованные значения
        rsi_val = math.max(0, math.min(100, nz(rsi_series, 50)))
        momentum_val = nz(wma_roc_series, 0)
        macd_val = nz(ta.wma(macd_line, 5), 0)
        sma_val = nz(ta.sma(src, 20), close)
        stdev_val = nz(ta.stdev(src, 20), src * 0.01)
        volatility = stdev_val / math.max(sma_val, 1e-10)
        volume_sma = nz(ta.sma(volume, 20), volume)
        
        current_adx = nz(adx_val, 20)
        current_macd_hist = nz(macd_hist, 0)
        current_stoch = nz(stoch_k, 50)
        current_cci = nz(cci, 0)
        current_obv = nz(obv_series, 0)
        current_acceleration = nz(acceleration, 0)
        current_bb_position = bb_position
        
        // ============================================================
        // 2. FEATURE VECTOR (15 признаков)
        // ============================================================
        
        current_features = array.from(rsi_val/100,momentum_val,macd_val,volatility,current_adx/100,volume_ratio,price_vol_corr,price_macd_corr,rsi_volatility,entropy_val,current_cluster,bb_width,current_stoch/100,current_cci/200,current_acceleration)
        
        // ============================================================
        // 3. FEATURE IMPORTANCE (динамическая)
        // ============================================================
        
        var array<float> feature_importance = array.new_float(15, 1.0)
        
        if is_bull_trend or is_bear_trend
            // В тренде momentum-индикаторы важнее
            array.set(feature_importance, 1, 1.5)   // momentum
            array.set(feature_importance, 14, 1.3)  // acceleration
            array.set(feature_importance, 2, 1.2)   // macd
            array.set(feature_importance, 4, 1.2)   // adx
        else if is_flat
            // Во флэте mean reversion индикаторы важнее
            array.set(feature_importance, 0, 1.4)   // rsi
            array.set(feature_importance, 11, 1.5)  // bb_width
            array.set(feature_importance, 12, 1.3)  // stochastic
            array.set(feature_importance, 9, 1.2)   // entropy
        
        // ============================================================
        // 4. АДАПТИВНЫЕ ГИПЕРПАРАМЕТРЫ
        // ============================================================
        
        // Адаптивная регуляризация
        float reg_lambda = 0.5
        if is_flat
            reg_lambda := 1.5  // Сильная регуляризация во флэте
        else if volatility > 0.03
            reg_lambda := 0.3  // Слабая в волатильности
        else if confidence_normalized > 0.8
            reg_lambda := 0.4  // Умеренная при высокой уверенности
        else
            reg_lambda := 0.7
        
        // Адаптивный learning rate
        float learning_rate = 0.1 * (is_flat ? 0.7 : 1.0 + confidence_normalized * 0.5)
        learning_rate := math.max(0.05, math.min(0.3, learning_rate))
        
        // Адаптивная глубина дерева
        float depth_factor = is_flat ? 0.7 : 1.0 + confidence_normalized * 0.5
        int adaptive_max_depth = int(math.max(3, math.min(10, max_depth * depth_factor)))
        
        // Adaptive kernel weight
        float adaptive_kernel_weight = (1.0 + math.min(volatility, 2.0)) * (1.5 - confidence_normalized * 0.5)
        adaptive_kernel_weight := math.max(0.5, math.min(5.0, adaptive_kernel_weight))
        
        // Subsample ratio
        float subsample_ratio = confidence_normalized > 0.7 ? 0.9 : 0.7
        
        // Адаптивное количество итераций
        int num_iterations = 3
        if is_bull_trend or is_bear_trend
            num_iterations := 4
        if confidence_normalized > 0.8
            num_iterations += 1
        num_iterations := math.min(num_iterations, 5)
        
        // ============================================================
        // 5. НАЧАЛЬНЫЙ ПРОГНОЗ
        // ============================================================
        
        float initial_prediction = is_bull_trend or is_bear_trend ? 
                                  ta.ema(src, 15)[1] : 
                                  ta.sma(src, len)[1]
        
        float cumulative_prediction = initial_prediction
        float target = src - initial_prediction
        
        // ============================================================
        // 6. GRADIENT BOOSTING LOOP
        // ============================================================
        
        var float prev_loss = 1e10
        var int no_improvement_count = 0
        
        for boost_iter = 0 to num_iterations - 1
            float sum_weights = 0.0
            float sum_weighted = 0.0
            float sum_squared_residuals = 0.0
            int valid_samples = 0
            
            // ========================================
            // ПОСТРОЕНИЕ ОДНОГО ДЕРЕВА
            // ========================================
            
            for i = 1 to math.min(len, 50) - 1
                // Subsampling
                if math.random() > subsample_ratio
                    continue
                
                // Исторический feature vector
                historical_features = array.from(nz(ta.rsi(src, 14)[i], 50)/100,nz(wma_roc_series[i], 0),nz(macd_line[i], 0),nz(ta.stdev(src, 20)[i], src * 0.01) / math.max(ta.sma(src, 20)[i], 1e-10),nz(adx_val[i], 20)/100,nz(volume_ratio[i], 1.0),nz(price_vol_corr[i], 0.0),nz(price_macd_corr[i], 0.0),nz(rsi_volatility[i], 0.0),nz(entropy_val[i], 0.0),nz(current_cluster, 0.5),nz((bb_upper[i] - bb_lower[i]) / bb_middle[i], 0.05),nz(ta.stoch(src, high, low, 14)[i], 50)/100,nz(ta.cci(src, 20)[i], 0)/200,nz(acceleration[i], 0))
                
                // Взвешенное евклидово расстояние
                float total_distance_sq = 0.0
                for f = 0 to array.size(current_features) - 1
                    feature_diff = array.get(current_features, f) - array.get(historical_features, f)
                    importance = array.get(feature_importance, f)
                    total_distance_sq += importance * math.pow(feature_diff, 2)
                
                // RBF Kernel similarity
                kernel_val = math.exp(-total_distance_sq / adaptive_kernel_weight)
                
                // Временной вес
                time_weight = math.exp(-learning_rate * i / len)
                
                // Комбинированный вес
                combined_weight = kernel_val * time_weight
                
                // Tree Depth Constraint
                if i <= adaptive_max_depth or kernel_val > 0.1
                    sum_weights += combined_weight
                    sum_weighted += target[i] * combined_weight
                    sum_squared_residuals += math.pow(target[i], 2)
                    valid_samples += 1
            
            // ========================================
            // ПРОГНОЗ ТЕКУЩЕГО ДЕРЕВА
            // ========================================
            
            float tree_prediction = 0.0
            if sum_weights > 1e-10 and valid_samples >= 3
                tree_prediction := sum_weighted / sum_weights
                
                // L2 Regularization
                tree_prediction := tree_prediction / (1.0 + reg_lambda)
                
                // Adaptive Shrinkage
                shrinkage_factor = 1.0 - (boost_iter / num_iterations) * 0.3
                tree_prediction := tree_prediction * shrinkage_factor
            
            // Обновление прогноза
            cumulative_prediction += tree_prediction
            target -= tree_prediction
            
            // ========================================
            // EARLY STOPPING
            // ========================================
            
            current_loss = sum_squared_residuals / math.max(valid_samples, 1)
            
            if current_loss >= prev_loss * 0.999
                no_improvement_count += 1
                if no_improvement_count >= 2
                    break
            else
                no_improvement_count := 0
            
            prev_loss := current_loss
        
        // ============================================================
        // 7. MULTI-FACTOR КОРРЕКЦИЯ ТРЕНДА
        // ============================================================
        
        // Momentum коррекция
        momentum_adj = ta.wma(ta.roc(src, 5), 3) * 0.025 * math.sqrt(len)
        
        // Acceleration коррекция
        accel_adj = current_acceleration * 0.015 * math.sqrt(len)
        
        // Volume surge коррекция
        volume_surge = (volume - volume_sma) / math.max(volume_sma, 1e-10)
        volume_adj = volume_surge * 0.01 * src
        
        float trend_adj = momentum_adj + accel_adj + volume_adj
        
        // Адаптация по режиму
        if is_bull_trend
            trend_adj *= (1.0 + confidence_normalized * 0.8)
        else if is_bear_trend
            trend_adj *= (1.0 - confidence_normalized * 0.8)
        else if is_flat
            // Mean reversion во флэте
            mean_reversion = (sma_val - src) * 0.3
            trend_adj := trend_adj * 0.3 + mean_reversion
        
        float final_prediction = cumulative_prediction + trend_adj
        
        // ============================================================
        // 8. МЯГКОЕ ОГРАНИЧЕНИЕ (SOFT CLIPPING)
        // ============================================================
        
        // Адаптивный max_move
        float smooth_vol = ta.ema(volatility, 5)
        float max_move_multiplier = 2.0
        if is_flat
            max_move_multiplier := 0.8
        else if confidence_normalized > 0.8
            max_move_multiplier := 2.5
        else
            max_move_multiplier := 1.5
        
        max_move = local_atr * max_move_multiplier * math.sqrt(len) * (1 + smooth_vol * 0.3)
        
        upper_bound = nz(src, close) + max_move
        lower_bound = nz(src, close) - max_move
        
        // Мягкое ограничение через exp
        if final_prediction > upper_bound
            excess = final_prediction - upper_bound
            final_prediction := upper_bound + excess * math.exp(-excess / max_move)
        else if final_prediction < lower_bound
            excess = lower_bound - final_prediction
            final_prediction := lower_bound - excess * math.exp(-excess / max_move)
        
        // ============================================================
        // 9. EMA-СГЛАЖИВАНИЕ ДЛЯ СТАБИЛЬНОСТИ
        // ============================================================
        
        var float smoothed_lgbm = close
        smoothed_lgbm := ta.ema(final_prediction, 3)
        
        smoothed_lgbm


// === Расчет индикаторов ===
smoothed_close = ta.ema(close, 5)
short_ema_val = ta.ema(smoothed_close, 10)
long_ema_val = ta.ema(smoothed_close, 20)
momentum_val = ta.wma(ta.roc(smoothed_close, 10), 5)
acceleration_val = ta.wma(ta.roc(momentum_val, 7), 3)
jerk_val = ta.wma(ta.roc(acceleration_val, 5), 3)
raw_momentum = 0.4 * nz(momentum_val, 0) + 0.3 * nz(acceleration_val, 0) + 0.3 * nz(jerk_val, 0)
momentum_factor = tanh(raw_momentum * 0.01) * 100
atr_val = ta.atr(14)
rsi_val = ta.rsi(smoothed_close, 14)
rsi_trend = ta.sma(rsi_val, 5)
sma_close_20 = ta.sma(smoothed_close, 20)
volatility_ratio_forecast = atr_val / math.max(nz(sma_close_20, close * 0.01), 1e-10)
stdev_close_20 = ta.stdev(smoothed_close, 20)

// Безопасный расчет volatility_factor
stdev_close = nz(ta.stdev(close, 20), close * 0.01)
sma_close = nz(ta.sma(close, 20), close)
volatility_factor := math.sqrt(forecast_length) * (1 + stdev_close / math.max(sma_close, 1e-10))

// Динамическая длина регрессии
regression_length_dynamic = int(math.max(10, math.min(50, 20 + nz(atr_val, 1) / math.max(nz(sma_close_20, close * 0.01), 1e-10) * 10)))
regression_length_dynamic := math.min(regression_length_dynamic, bar_index + 1)  // Ограничение длины истории

walk_oos_len = int(math.max(5, math.min(20, 5 + nz(volatility_ratio_forecast, 1) * 5)))

// Адаптация параметров к рыночному режиму
decay_rate_base = 0.05
learning_rate_base = 0.05
max_depth_base = 5
kernel_scale_base = 1.0

adapted_decay_rate = decay_rate_base
adapted_learning_rate = learning_rate_base
adapted_max_depth = max_depth_base
adapted_kernel_scale = kernel_scale_base

if global_volatility_ratio > 1.5
    adapted_decay_rate := decay_rate_base * 1.2
    adapted_learning_rate := learning_rate_base * 0.8
    adapted_max_depth := math.max(3, max_depth_base - 1)
    adapted_kernel_scale := kernel_scale_base * 0.5
else if is_flat
    adapted_max_depth := max_depth_base + 2
    adapted_kernel_scale := kernel_scale_base * 1.5
else if is_bull_trend or is_bear_trend
    adapted_learning_rate := learning_rate_base * 1.1
    adapted_kernel_scale := kernel_scale_base * 0.8

adapted_kernel_scale := math.max(0.1, math.min(10.0, adapted_kernel_scale))

// Прогнозы моделей с адаптированными параметрами
[slope_val_local, intercept_val_local] = weighted_linear_regression(smoothed_close, regression_length_dynamic, adapted_decay_rate)
forecast_lr := nz(intercept_val_local + slope_val_local * (-forecast_length), close)
ar_dynamic_adjustment = 2.0
ar_order = int(math.max(3, math.min(6, 3 + nz(volatility_ratio_forecast, 1) * 3)))
ar_strength = 0.2 + (nz(momentum_factor, 0) * 0.1) - (nz(volatility_ratio_forecast, 1) * 0.1)

forecast_ar := nz(smoothed_close + autoregressive_forecast(smoothed_close, ar_order, ar_strength, ar_dynamic_adjustment), close)

forecast_svr := nz(svr_forecast(smoothed_close, regression_length_dynamic, adapted_decay_rate, adapted_kernel_scale), close)

forecast_xgb := nz(xgb_forecast(smoothed_close, regression_length_dynamic, adapted_learning_rate, adapted_max_depth, is_bull_trend, is_bear_trend, is_flat, cluster_confidence, feature_volume_ratio, feature_corr_price_volume, feature_corr_price_macd, feature_rsi_volatility, feature_entropy), close)

forecast_lgbm := nz(lgbm_forecast(smoothed_close, regression_length_dynamic, adapted_decay_rate, adapted_max_depth), close)

forecast_lstm := nz(lstm_forecast(smoothed_close, regression_length_dynamic, adapted_decay_rate), close)


// === Walk-Forward и прогноз ===
if bar_index > regression_length + forecast_length + history_len
    // Обновление истории прогнозов
    if array.size(past_lr_forecasts) >= forecast_length
        array.shift(past_lr_forecasts)
    array.push(past_lr_forecasts, forecast_lr)
    
    if array.size(past_ar_forecasts) >= forecast_length
        array.shift(past_ar_forecasts)
    array.push(past_ar_forecasts, forecast_ar)
    
    if array.size(past_svr_forecasts) >= forecast_length
        array.shift(past_svr_forecasts)
    array.push(past_svr_forecasts, forecast_svr)
    
    if array.size(past_xgb_forecasts) >= forecast_length
        array.shift(past_xgb_forecasts)
    array.push(past_xgb_forecasts, forecast_xgb)
    
    if array.size(past_lgbm_forecasts) >= forecast_length
        array.shift(past_lgbm_forecasts)
    array.push(past_lgbm_forecasts, forecast_lgbm)
    
    if array.size(past_lstm_forecasts) >= forecast_length
        array.shift(past_lstm_forecasts)
    array.push(past_lstm_forecasts, forecast_lstm)
    
    if array.size(past_ensemble_forecasts) >= forecast_length  // Добавлено для общего MAE
        array.shift(past_ensemble_forecasts)
    array.push(past_ensemble_forecasts, final_forecast_val)

//=======================================================Процент неправельных направлений==============================================

    past_lr = array.get(past_lr_forecasts, 0)
    if not na(past_lr)
        if array.size(lr_acc_history) >= history_len
            array.shift(lr_acc_history)
        array.push(lr_acc_history, math.abs(past_lr - close))

    past_ar = array.get(past_ar_forecasts, 0)
    if not na(past_ar)
        if array.size(ar_acc_history) >= history_len
            array.shift(ar_acc_history)
        array.push(ar_acc_history, math.abs(past_ar - close))

    past_svr = array.get(past_svr_forecasts, 0)
    if not na(past_svr)
        if array.size(svr_acc_history) >= history_len
            array.shift(svr_acc_history)
        array.push(svr_acc_history, math.abs(past_svr - close))

    past_xgb = array.get(past_xgb_forecasts, 0)
    if not na(past_xgb)
        if array.size(xgb_acc_history) >= history_len
            array.shift(xgb_acc_history)
        array.push(xgb_acc_history, math.abs(past_xgb - close))

    past_lgbm = array.get(past_lgbm_forecasts, 0)
    if not na(past_lgbm)
        if array.size(lgbm_acc_history) >= history_len
            array.shift(lgbm_acc_history)
        array.push(lgbm_acc_history, math.abs(past_lgbm - close))
    
    past_lstm = array.get(past_lstm_forecasts, 0)
    if not na(past_lstm)
        if array.size(lstm_acc_history) >= history_len
            array.shift(lstm_acc_history)
        array.push(lstm_acc_history, math.abs(past_lstm - close))
    
    past_ensemble = array.get(past_ensemble_forecasts, 0)  // Добавлено для общего MAE
    if not na(past_ensemble)
        if array.size(ensemble_acc_history) >= history_len
            array.shift(ensemble_acc_history)
        array.push(ensemble_acc_history, math.abs(past_ensemble - close))

    //**********************************************************************************************************************************************
    if bar_index >= history_len
        past_lr = array.get(past_lr_forecasts, 0)
        past_ar = array.get(past_ar_forecasts, 0)
        past_svr = array.get(past_svr_forecasts, 0)
        past_xgb = array.get(past_xgb_forecasts, 0)
        past_lgbm = array.get(past_lgbm_forecasts, 0)
        past_lstm = array.get(past_lstm_forecasts, 0)
    
    // Проверяем, что все прогнозы валидны
    if not na(past_lr) and not na(past_ar) and not na(past_svr) and 
       not na(past_xgb) and not na(past_lgbm) and not na(past_lstm)
        
        // ОБНОВЛЕНИЕ МЕТА-ВЕСОВ (только если включено)
        if use_stacking
            meta_update_counter += 1
            
            if meta_update_counter % meta_update_frequency == 0
                // ============================================================
                // ОНЛАЙН-ОБУЧЕНИЕ МЕТА-МОДЕЛИ (КОД БЕЗ ФУНКЦИИ)
                // ============================================================
                
                // Массив прошлых прогнозов
                past_forecasts = array.from(past_lr, past_ar, past_svr, past_xgb, past_lgbm, past_lstm)
                
                // Текущее предсказание мета-модели
                prediction_meta = 0.0
                for i = 0 to 5
                    prediction_meta += array.get(past_forecasts, i) * array.get(meta_weights, i)
                
                // Ошибка мета-модели
                error_meta = close - prediction_meta
                
                // Сохраняем ошибку для мониторинга
                if array.size(meta_loss_history) >= 50
                    array.shift(meta_loss_history)
                array.push(meta_loss_history, math.abs(error_meta))
                
                // Adam optimizer параметры
                beta1 = meta_momentum
                beta2 = 0.999
                epsilon = 1e-8
                
                meta_training_steps += 1
                
                // Обновление каждого веса
                for i = 0 to 5
                    // Градиент
                    gradient = error_meta * array.get(past_forecasts, i)
                    
                    // Adam: первый момент (momentum)
                    m = beta1 * array.get(meta_velocity, i) + (1 - beta1) * gradient
                    array.set(meta_velocity, i, m)
                    
                    // Adam: второй момент (squared gradient)
                    v = beta2 * array.get(meta_grad_squared, i) + (1 - beta2) * gradient * gradient
                    array.set(meta_grad_squared, i, v)
                    
                    // Bias correction
                    m_hat = m / (1 - math.pow(beta1, meta_training_steps))
                    v_hat = v / (1 - math.pow(beta2, meta_training_steps))
                    
                    // Обновление веса
                    weight_delta = meta_learning_rate * m_hat / (math.sqrt(v_hat) + epsilon)
                    new_weight = array.get(meta_weights, i) + weight_delta
                    array.set(meta_weights, i, new_weight)
                
                // Нормализация весов (сумма = 1)
                sum_weights = array.sum(meta_weights)
                if sum_weights > 0
                    for i = 0 to 5
                        normalized_weight = array.get(meta_weights, i) / sum_weights
                        // Ограничиваем веса: 5%-50%
                        normalized_weight := math.max(0.05, math.min(0.50, normalized_weight))
                        array.set(meta_weights, i, normalized_weight)
                    
                    // Повторная нормализация после ограничений
                    sum_weights := array.sum(meta_weights)
                    for i = 0 to 5
                        array.set(meta_weights, i, array.get(meta_weights, i) / sum_weights)
    //**********************************************************************************************************************************************
    overlap_ratio = 0.5  // 50% перекрытия
    // Адаптация по волатильности и entropy
    adaptive_is_len = int(walk_is_len * (1.0 + 0.5 * global_volatility_ratio) * (1.0 - 0.3 * km_safe_entropy))
    adaptive_is_len := math.max(100, math.min(300, adaptive_is_len))
    // Walk-Forward логика
    wf_counter := wf_counter + 1
    wf_period = adaptive_is_len + walk_oos_len
    is_phase := (wf_counter % wf_period) < adaptive_is_len
    if wf_counter % int((1.0 - overlap_ratio) * adaptive_is_len) == 0
        is_phase := true
    // Функция EMA для истории ошибок
ema_error(history, length) =>
    if array.size(history) == 0
        na
    else
        float ema_val = na
        alpha = 2.0 / (length + 1)
        for i = 0 to array.size(history) - 1
            val = array.get(history, i)
            ema_val := na(ema_val) ? val : alpha * val + (1 - alpha) * ema_val
        ema_val


// Функция адаптивного весового коэффициента для анти-скачков
f_adapt_weight(err_short, err_long, stdev_err) =>
    diff = err_short - err_long
    decay_factor = diff > 0 ? math.exp(-diff * 5) : 1.0
    stability_penalty = stdev_err > 0.01 ? 1.0 / (1.0 + stdev_err * 10) : 1.0
    math.max(0.05, decay_factor * stability_penalty)
// Пользовательская функция расчета стандартного отклонения для array<float>
array_stdev(arr) =>
    n = array.size(arr)
    if n < 2
        0.0
    else
        mean = 0.0
        for i = 0 to n - 1
            mean += array.get(arr, i)
        mean := mean / n
        variance = 0.0
        for i = 0 to n - 1
            diff = array.get(arr, i) - mean
            variance += diff * diff
        variance := variance / (n - 1)
        math.sqrt(variance)

// Если в IS фазе
if is_phase
    ema_err_short_len = 10
    ema_err_long_len = 50

    // Вычисляем EMA ошибок и стандартные отклонения
    lr_err_short = ema_error(lr_acc_history, ema_err_short_len)
    lr_err_long  = ema_error(lr_acc_history, ema_err_long_len)
    stdev_lr_err = array_stdev(lr_acc_history)

    ar_err_short = ema_error(ar_acc_history, ema_err_short_len)
    ar_err_long  = ema_error(ar_acc_history, ema_err_long_len)
    stdev_ar_err = array_stdev(ar_acc_history)

    svr_err_short = ema_error(svr_acc_history, ema_err_short_len)
    svr_err_long  = ema_error(svr_acc_history, ema_err_long_len)
    stdev_svr_err = array_stdev(svr_acc_history)

    xgb_err_short = ema_error(xgb_acc_history, ema_err_short_len)
    xgb_err_long  = ema_error(xgb_acc_history, ema_err_long_len)
    stdev_xgb_err = array_stdev(xgb_acc_history)

    lgbm_err_short = ema_error(lgbm_acc_history, ema_err_short_len)
    lgbm_err_long  = ema_error(lgbm_acc_history, ema_err_long_len)
    stdev_lgbm_err = array_stdev(lgbm_acc_history)

    lstm_err_short = ema_error(lstm_acc_history, ema_err_short_len)
    lstm_err_long  = ema_error(lstm_acc_history, ema_err_long_len)
    stdev_lstm_err = array_stdev(lstm_acc_history)

    // Расчет скорректированных весов с анти-скачками
    lr_weight_calc_raw = math.pow(1 / (1 + nz(lr_err, close * 0.01)), 1.2)
    lr_weight_calc = f_adapt_weight(lr_err_short, lr_err_long, stdev_lr_err) * lr_weight_calc_raw

    ar_weight_calc_raw = math.pow(1 / (1 + nz(ar_err, close * 0.01)), 1.2)
    ar_weight_calc = f_adapt_weight(ar_err_short, ar_err_long, stdev_ar_err) * ar_weight_calc_raw

    svr_weight_calc_raw = math.pow(1 / (1 + nz(svr_err, close * 0.01)), 1.2)
    svr_weight_calc = f_adapt_weight(svr_err_short, svr_err_long, stdev_svr_err) * svr_weight_calc_raw

    xgb_weight_calc_raw = math.pow(1 / (1 + nz(xgb_err, close * 0.01)), 1.2)
    xgb_weight_calc = f_adapt_weight(xgb_err_short, xgb_err_long, stdev_xgb_err) * xgb_weight_calc_raw

    lgbm_weight_calc_raw = math.pow(1 / (1 + nz(lgbm_err, close * 0.01)), 1.2)
    lgbm_weight_calc = f_adapt_weight(lgbm_err_short, lgbm_err_long, stdev_lgbm_err) * lgbm_weight_calc_raw

    lstm_weight_calc_raw = math.pow(1 / (1 + nz(lstm_err, close * 0.01)), 1.2)
    lstm_weight_calc = f_adapt_weight(lstm_err_short, lstm_err_long, stdev_lstm_err) * lstm_weight_calc_raw

    // Учёт рыночного режима
    bull_boost = 1.1
    flat_boost = 1.1
    if is_bull_trend
        xgb_weight_calc := xgb_weight_calc * bull_boost
        lstm_weight_calc := lstm_weight_calc * bull_boost
    else if is_flat
        ar_weight_calc := ar_weight_calc * flat_boost
        svr_weight_calc := svr_weight_calc * flat_boost

    // Нормализация суммы весов
    sum_weights_calc = lr_weight_calc + ar_weight_calc + svr_weight_calc + xgb_weight_calc + lgbm_weight_calc + lstm_weight_calc

    // Экспоненциальное сглаживание для плавного обновления
    lr_weight := lr_weight * 0.7 + (lr_weight_calc / sum_weights_calc) * 0.3
    ar_weight := ar_weight * 0.7 + (ar_weight_calc / sum_weights_calc) * 0.3
    svr_weight := svr_weight * 0.7 + (svr_weight_calc / sum_weights_calc) * 0.3
    xgb_weight := xgb_weight * 0.7 + (xgb_weight_calc / sum_weights_calc) * 0.3
    lgbm_weight := lgbm_weight * 0.7 + (lgbm_weight_calc / sum_weights_calc) * 0.3
    lstm_weight := lstm_weight * 0.7 + (lstm_weight_calc / sum_weights_calc) * 0.3

else
    lr_weight := saved_lr_w
    ar_weight := saved_ar_w
    svr_weight := saved_svr_w
    xgb_weight := saved_xgb_w
    lgbm_weight := saved_lgbm_w
    lstm_weight := saved_lstm_w

    // Коррекция весов по режиму рынка
if km_kmeans_ok
    regime_strength = 0.0
    if is_bull_trend
        regime_strength := math.max(0, math.min(1, (km_last_bull_score - 5) / 5))
    else if is_bear_trend
        regime_strength := math.max(0, math.min(1, (km_last_bear_score - 5) / 5))
    else if is_flat
        regime_strength := math.max(0, math.min(1, (km_last_flat_score - 5) / 5))
    
    strength_factor = 0.2 * regime_strength

    if is_bull_trend
        svr_weight  := svr_weight  * (1.0 - strength_factor)
        xgb_weight  := xgb_weight  * (1.0 + strength_factor)
        lgbm_weight := lgbm_weight * (1.0 + strength_factor * 0.5)
        lstm_weight := lstm_weight * (1.0 + strength_factor * 0.5)
    else if is_bear_trend
        svr_weight  := svr_weight  * (1.0 + strength_factor)
        xgb_weight  := xgb_weight  * (1.0 - strength_factor)
        lgbm_weight := lgbm_weight * (1.0 - strength_factor * 0.5)
        lstm_weight := lstm_weight * (1.0 - strength_factor * 0.5)
    else if is_flat
        strength_factor = 0.3 * regime_strength
        svr_weight  := svr_weight  * (1.0 - strength_factor)
        xgb_weight  := xgb_weight  * (1.0 - strength_factor)
        lgbm_weight := lgbm_weight * (1.0 + strength_factor * 0.5)
        lstm_weight := lstm_weight * (1.0 - strength_factor * 0.3)

// ОГРАНИЧЕНИЕ ВЕСОВ В ДИАПАЗОНЕ [0.05, 0.4] С УЧЁТОМ РЫНОЧНЫХ РЕЖИМОВ
lr_weight   := math.max(0.05, math.min(0.4, lr_weight))
ar_weight   := math.max(0.05, math.min(0.4, ar_weight))
svr_weight  := math.max(0.05, math.min(0.4, svr_weight))
xgb_weight  := math.max(0.05, math.min(0.4, xgb_weight))
lgbm_weight := math.max(0.05, math.min(0.4, lgbm_weight))
lstm_weight := math.max(0.05, math.min(0.4, lstm_weight))

// ДОПОЛНИТЕЛЬНО: РАЗРЕШИТЬ ВРЕМЕННОЕ ПОВЫШЕНИЕ ВЕСОВ ДЛЯ ЛУЧШИХ МОДЕЛЕЙ
if is_bull_trend and km_last_bull_score > 7
    xgb_weight  := math.min(0.5, xgb_weight * 1.2)   // Временно до 50% в тренде
    lstm_weight := math.min(0.5, lstm_weight * 1.2)

if is_bear_trend and km_last_bear_score > 7  
    svr_weight  := math.min(0.5, svr_weight * 1.2)
    ar_weight   := math.min(0.5, ar_weight * 1.1)

// Суммарный вес моделей
total_weight = lr_weight + ar_weight + svr_weight + xgb_weight + lgbm_weight + lstm_weight

// Нормализация весов
lr_weight   := lr_weight   / math.max(total_weight, 1e-10)
ar_weight   := ar_weight   / math.max(total_weight, 1e-10)
svr_weight  := svr_weight  / math.max(total_weight, 1e-10)
xgb_weight  := xgb_weight  / math.max(total_weight, 1e-10)
lgbm_weight := lgbm_weight / math.max(total_weight, 1e-10)
lstm_weight := lstm_weight / math.max(total_weight, 1e-10)

// Формирование ансамблевого прогноза
if use_stacking
    ensemble_val := nz(forecast_lr, close) * array.get(meta_weights, 0) + nz(forecast_ar, close) * array.get(meta_weights, 1) + nz(forecast_svr, close) * array.get(meta_weights, 2) + nz(forecast_xgb, close) * array.get(meta_weights, 3) + nz(forecast_lgbm, close) * array.get(meta_weights, 4) + nz(forecast_lstm, close) * array.get(meta_weights, 5)
else
    ensemble_val := nz(forecast_lr, close)   * lr_weight + nz(forecast_ar, close)   * ar_weight + nz(forecast_svr, close)  * svr_weight + nz(forecast_xgb, close)  * xgb_weight + nz(forecast_lgbm, close) * lgbm_weight + nz(forecast_lstm, close) * lstm_weight

// Консенсус по направлению прогноза
part1  = math.sign(nz(forecast_lr, close)   - close) * lr_weight
part2  = math.sign(nz(forecast_ar, close)   - close) * ar_weight
part3  = math.sign(nz(forecast_svr, close)  - close) * svr_weight
part4  = math.sign(nz(forecast_xgb, close)  - close) * xgb_weight
part5  = math.sign(nz(forecast_lgbm, close) - close) * lgbm_weight
part6  = math.sign(nz(forecast_lstm, close) - close) * lstm_weight

avg_direction := part1 + part2 + part3 + part4 + part5 + part6
consensus_strength := math.abs(avg_direction)

// Коррекция прогноза на основе консенсуса и волатильности
volatility_factor_corr = math.min(1.0, nz(atr_val, close * 0.01) / math.max(sma_close_20, 1e-10))
adaptive_power := 0.05 * (1 + consensus_strength) * (1 - volatility_factor_corr * 0.5)

if avg_direction > 0
    confidence_multiplier := 1.0 + adaptive_power * math.min(1, consensus_strength * 2)
    ensemble_val := ensemble_val * confidence_multiplier
else if avg_direction < 0
    confidence_multiplier := 1.0 - adaptive_power * math.min(1, consensus_strength * 2)
    ensemble_val := ensemble_val * confidence_multiplier
else
    volatility_adjustment = 1.0 - volatility_factor_corr * 0.1
    ensemble_val := ensemble_val * volatility_adjustment

// Усредненное направление с нормализацией
dir_sign = math.sign(avg_direction)
dir_strength = math.min(1.0, consensus_strength)

// Модификация confidence_multiplier с сдвигом по направлению
if dir_sign > 0
    confidence_multiplier := 1.0 + adaptive_power * math.min(1, dir_strength * 2)
else if dir_sign < 0
    confidence_multiplier := 1.0 - adaptive_power * math.min(1, dir_strength * 2)
else
    confidence_multiplier := 1.0

// Применение множителя с добавлением направления (смещение)
ensemble_val := ensemble_val * confidence_multiplier + dir_sign * adaptive_power * 0.5 * sma_close_20

// Обновленное ограничение прогноза
max_move_val := nz(atr_val, close * 0.01) * 1.2 * math.sqrt(forecast_length)
upper_bound_val := close + max_move_val
lower_bound_val := close - max_move_val

final_forecast_val := math.max(math.min(ensemble_val, upper_bound_val), lower_bound_val)

// Расчет доверительных полос и других параметров прогноза (с сохранением существующей логики)
var float dynamic_multiplier = 1.0
var float max_band_width = 0.0
var float base_band_width = 0.0
var float models_accuracy = 0.5
var float consensus_factor = 1.0
var float dynamic_multiplier_raw = 1.0

volatility_factor := math.sqrt(forecast_length) * (1 + stdev_close / math.max(sma_close, 1e-10))
cluster_confidence := km_kmeans_ok ? 1.0 : 0.9
wf_multiplier := (regime == "bull" or regime == "bear") ? 0.9 : 1.1
//************************************************************************************************************************************************
if barstate.isconfirmed
    if regime == "bull"
        w_svr   *= 0.9
        w_xgb   *= 1.1
        w_lgbm  *= 1.05
        w_lstm  *= 1.05  // немного меньше усиление
    else if regime == "bear"
        w_svr   *= 1.1
        w_xgb   *= 0.85
        w_lgbm  *= 0.9
        w_lstm  *= 0.85  // уменьшить, чтобы не тянуть вверх
    else if regime == "flat"
        w_svr   *= 0.8
        w_xgb   *= 0.8
        w_arima *= 1.3
        w_lgbm  *= 1.0
        w_lstm  *= 0.9
direction_consensus = (math.sign(nz(forecast_lr, close) - close) + 
                      math.sign(nz(forecast_ar, close) - close) +   
                      math.sign(nz(forecast_svr, close) - close) + 
                      math.sign(nz(forecast_xgb, close) - close) + 
                      math.sign(nz(forecast_lgbm, close) - close) +
                      math.sign(nz(forecast_lstm, close) - close)) / 6
consensus_factor := 1.0 - math.abs(direction_consensus) * 0.5

// Безопасный расчет средней ошибки
weighted_avg_err := nz(lr_err, close * 0.01) * lr_weight + 
                   nz(ar_err, close * 0.01) * ar_weight + 
                   nz(svr_err, close * 0.01) * svr_weight + 
                   nz(xgb_err, close * 0.01) * xgb_weight + 
                   nz(lgbm_err, close * 0.01) * lgbm_weight +
                   nz(lstm_err, close * 0.01) * lstm_weight
// Байесовский подход
n_eff = history_len
n_eff := math.max(n_eff, 1)
kappa_n = bayes_kappa_prior + n_eff
kappa_n := math.max(kappa_n, 1e-10)
mu_n = (bayes_kappa_prior * bayes_mu_prior + n_eff * weighted_avg_err) / kappa_n
alpha_n = bayes_prior_alpha + n_eff / 2
beta_n = bayes_prior_beta + 0.5 * (n_eff * weighted_avg_err + (bayes_kappa_prior * n_eff * math.pow(weighted_avg_err - bayes_mu_prior, 2)) / kappa_n)
post_var = alpha_n > 1 ? beta_n / (alpha_n - 1) : nz(weighted_avg_err, close * 0.01)
forecast_std := math.sqrt(nz(post_var, close * 0.01)) * volatility_factor

//dynamic_multiplier := 2.0 * (1 - math.min(1, post_var / math.max(close * 0.01, 1e-10)))
// Клиппим dynamic_multiplier сразу, чтобы избегать отрицательных или экстремальных значений
dynamic_multiplier_raw := 2.0 * (1 - math.min(1, post_var / math.max(close * 0.01, 1e-10)))
dynamic_multiplier := math.max(0.1, math.min(2.0, dynamic_multiplier_raw))  // [0.1, 2.0] — пример границ
base_band_width := nz(atr_val, close * 0.01) * volatility_factor * math.max(dynamic_multiplier, 0.1) * consensus_factor

// Точность моделей
models_accuracy := (1 - math.min(1, safe_div(nz(lr_err, close * 0.01), close, 1))) * lr_weight + (1 - math.min(1, safe_div(nz(ar_err, close * 0.01), close, 1))) * ar_weight + (1 - math.min(1, safe_div(nz(svr_err, close * 0.01), close, 1))) * svr_weight + (1 - math.min(1, safe_div(nz(xgb_err, close * 0.01), close, 1))) * xgb_weight + (1 - math.min(1, safe_div(nz(lgbm_err, close * 0.01), close, 1))) * lgbm_weight +(1 - math.min(1, safe_div(nz(lstm_err, close * 0.01), close, 1))) * lstm_weight

last_trust_val := math.max(0.5, math.min(0.95, trust_base_val * 0.7 + nz(models_accuracy, 0.5) * 0.2 + math.abs(direction_consensus) * 0.1))
band_width := na(band_width[1]) ? base_band_width : 0.7 * band_width[1] + 0.3 * base_band_width
band_width := math.max(band_width, nz(atr_val, close * 0.01) * 0.1)

z_value = 1.96
upper_band_val := nz(adjusted_forecast, close) + z_value * nz(forecast_std, close * 0.01) * err_influence
lower_band_val := nz(adjusted_forecast, close) - z_value * nz(forecast_std, close * 0.01) * err_influence
max_band_width := close * 0.1 * forecast_length
upper_band_val := math.min(upper_band_val, close + max_band_width)
lower_band_val := math.max(lower_band_val, close - max_band_width)

adjusted_forecast := nz(final_forecast_val, close) * last_trust_val + close * (1 - last_trust_val)
forecast_val := nz(adjusted_forecast, close)
confidence_val := math.min(math.max(last_trust_val, 0.01), 0.99)

//if barstate.isconfirmed  // Только когда бар закрылся
//    stable_forecast := final_forecast_val

float ensemble_mae = array.size(ensemble_acc_history) > 0 ? array.avg(ensemble_acc_history) / math.max(close, 1e-10) * 100.0 : 0.0
float ensemble_err_percent = array.size(ensemble_acc_history) > 0 ? ema_error(ensemble_acc_history) / math.max(close, 1e-10) * 100.0 : 0.0
//**********************************************************************************************************************************************************

// === ИНФОРМАЦИОННАЯ ПАНЕЛЬ (ОБЪЕДИНЕННАЯ) ===
var table info_table = table.new(position.top_right, 1, 1, bgcolor=color.new(color.gray, 90))

if barstate.islast
    if bar_index >= min_bars_required - 1
        // Основная информация
        string status_text = "=== MARKET STATE ===\n" +
              "State: " +  
              (is_bull_trend ? "BULL ▲" : 
               is_bear_trend ? "BEAR ▼" : 
               is_flat ? "FLAT ▬" : km_kmeans_ok ? "UNCERTAIN ⚠️" : "INIT ⏳") + 
              "\nCurrent Cluster: " + str.tostring(km_current_cluster) +
              "\nLearning Rate: " + str.tostring(learning_rate, "#.##") +
              "\nHistory Size: " + str.tostring(array.size(km_atr_history)) +
              "\nVolume (norm): " + str.tostring(n_log_volume, "#.####") +
              "\nMACD (norm): " + str.tostring(n_log_macd, "#.##") +       
              "\nReinitialized: " + str.tostring(km_reinitialized_now)
        
        // Авто-оптимизация
        string auto_opt_text = "\n\n=== AUTO-OPTIMIZATION ===" +
              "\nEnabled: " + (optimize_params ? "ON" : "OFF") +
              "\nVolatility Ratio: " + str.tostring(global_volatility_ratio, "#.##") +
              "\nMarket Speed: " + str.tostring(market_speed, "#.####") +
              "\nTraining Period: " + str.tostring(training_period) + " (base: " + str.tostring(base_training_period) + ")" +
              "\nLearning Rate: " + str.tostring(learning_rate, "#.##") + " (base: " + str.tostring(base_learning_rate, "#.##") + ")" +
              "\nHysteresis: " + str.tostring(hysteresis_threshold, "#.##") + " (base: " + str.tostring(base_hysteresis, "#.##") + ")"
        
        // Прогноз цен
        string forecast_text = "\n\n=== PRICE FORECAST ===" +
             "\nForecast (" + str.tostring(forecast_length) + " bars): " + str.tostring(forecast_val, "#.####") +
             "\nConfidence: " + str.tostring(confidence_val * 100, "#.##") + "%" +
             "\nRange: " + str.tostring(lower_band_val, "#.##") + " - " + str.tostring(upper_band_val, "#.##") +
              "\nEnsemble (MAE (%) ):  " + str.tostring(ensemble_mae, "#.##") + "/" + 
              "\nEntropy: " + str.tostring(entropy_val, "#.##") + 
             "\nWeights (LSTM/LGBM/SVR/XGB): " + 
             str.tostring(lstm_weight*100, "#.#") + "%/" + 
             str.tostring(lgbm_weight*100, "#.#") + "%/" + 
             str.tostring(svr_weight*100, "#.#") + "%/" +
             str.tostring(xgb_weight*100, "#.#") + "%" +
             "\nWeights (LR/AR): " +
             str.tostring(lr_weight*100, "#.#") + "%/" + 
             str.tostring(ar_weight*100, "#.#") + "%/" 
        // Объединяем все разделы
        full_text = status_text + auto_opt_text + forecast_text
        
        // Цвет фона в зависимости от состояния рынка
        bg_color = is_bull_trend ? color.new(color.green, 90) : 
                   is_bear_trend ? color.new(color.red, 90) : 
                   is_flat ? color.new(color.blue, 90) : 
                   km_kmeans_ok ? color.new(color.yellow, 90) :
                   color.new(color.gray, 90)
        
        // Цвет текста
        text_color = is_bull_trend ? color.green : 
                     is_bear_trend ? color.red : 
                     is_flat ? color.blue : 
                     color.gray
        
        // Отображаем таблицу
        table.cell(info_table, 0, 0, full_text, bgcolor=bg_color, text_color=text_color)
    else
        string error_msg = "Insufficient data: Need at least " + str.tostring(min_bars_required) + " bars"
        table.cell(info_table, 0, 0, error_msg, bgcolor=color.red, text_color=color.white)


// 1. Определение текущего состояния
vis_bull = km_kmeans_ok and km_current_cluster == km_trend_bull_cluster
vis_bear = km_kmeans_ok and km_current_cluster == km_trend_bear_cluster
vis_flat = km_kmeans_ok and km_current_cluster == km_flat_cluster

// 2. Непосредственное вычисление цветов
bar_color = 
     vis_bull ? color.new(color.green, 40) :
     vis_bear ? color.new(color.red, 40) :
     vis_flat ? color.new(color.gray, 40) :
     km_kmeans_ok ? color.new(color.blue, 50) : // Кластеризация работает, но состояние неизвестно
     color.new(color.yellow, 45) // Кластеризация не работает

bg_color = 
     vis_bull ? color.new(color.green, 90) :
     vis_bear ? color.new(color.red, 90) :
     vis_flat ? color.new(color.gray, 90) :
     na

// 3. Непосредственное применение цветов
barcolor(bar_color)
bgcolor(bg_color)
//**********************************************************************************************************************************************************

