//@version=6
indicator("Main_6.4.1 O(n)WF-ISOOS++SVR+XGB+LGBM+LSTM+CNN - Final version", overlay=true, max_bars_back=500, max_labels_count=500)
/// === Р”РћРџРћР›РќРРўР•Р›Р¬РќР«Р™ РЎР›РћР™ Р—РђР©РРўР« ===
min_bars_required = input.int(22, "Min Bars Required", minval=5, group="Security")
reduce_load = input.bool(true, "Reduce Resource Usage", group="Security")
max_history_size = input.int(300, "Max History Size", minval=250, maxval=1000, group="Resource Control")
max_history_size := math.max(max_history_size, 200)  // Р·Р°С‰РёС‚Р° РѕС‚ 0
// 1. Р—Р°С‰РёС‚РЅР°СЏ С„СѓРЅРєС†РёСЏ РґР»СЏ Р±РµР·РѕРїР°СЃРЅРѕРіРѕ РґРµР»РµРЅРёСЏ
safe_div(a, b, def) => 
    b != 0 ? a / b : def
// 2. РћРїС‚РёРјРёР·Р°С†РёСЏ РїР°СЂР°РјРµС‚СЂРѕРІ (РѕРїС‚РёРјРёР·РёСЂРѕРІР°РЅРѕ РґР»СЏ 15m RTS Рё MX1)
optimize_params = input.bool(true, "Enable Auto-Optimization", group="Auto-Optimization")
volatility_sensitivity = input.float(0.8, "Volatility Sensitivity", minval=0.5, maxval=2.0, step=0.1, group="Auto-Optimization")
market_speed_sensitivity = input.float(1.2, "Market Speed Sensitivity", minval=0.5, maxval=2.0, step=0.1, group="Auto-Optimization")

// 3. Р¤СѓРЅРєС†РёСЏ РѕРїС‚РёРјРёР·Р°С†РёРё Р·РЅР°С‡РµРЅРёР№
get_optimized_value(base, min_val, max_val, multiplier) =>
    optimized = base * multiplier
    math.min(math.max(optimized, min_val), max_val)

// 4. РђРЅР°Р»РёР· СЂС‹РЅРѕС‡РЅС‹С… СѓСЃР»РѕРІРёР№
atr_val_global = ta.atr(14)
global_volatility_ratio = safe_div(atr_val_global, ta.ema(atr_val_global, 50), 1)
market_speed = safe_div(math.abs(ta.roc(close, 14)), ta.atr(14), 0)

// 5. РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕРїС‚РёРјРёР·Р°С†РёСЏ РїР°СЂР°РјРµС‚СЂРѕРІ
base_training_period = 100
training_period = optimize_params ? 
     int(get_optimized_value(base_training_period, 100, 250, 1/(global_volatility_ratio * volatility_sensitivity))) : 
     input.int(base_training_period, "Training Period", minval=5, maxval=150, group="K-means Parameters")

// РџРѕСЃР»Рµ РІС‹С‡РёСЃР»РµРЅРёСЏ training_period РґРѕР±Р°РІСЊС‚Рµ:
training_period := math.max(training_period, 150)  // Р“Р°СЂР°РЅС‚РёСЂРѕРІР°РЅРЅС‹Р№ РјРёРЅРёРјСѓРј
training_period := math.min(training_period, int(bar_index * 0.7))  // РќРµ Р±РѕР»СЊС€Рµ 70% РёСЃС‚РѕСЂРёРё

base_learning_rate = 0.03
learning_rate = optimize_params ? 
     get_optimized_value(base_learning_rate, 0.01, 0.5, market_speed * market_speed_sensitivity) : 
     input.float(base_learning_rate, "Learning Rate", minval=0.01, maxval=0.5, step=0.01, group="K-means Parameters")

base_hysteresis = 0.3
hysteresis_threshold = optimize_params ? 
     get_optimized_value(base_hysteresis, 0.5, 3.0, global_volatility_ratio * volatility_sensitivity) : 
     input.float(base_hysteresis, "Hysteresis Threshold", minval=0.1, step=0.1, group="K-means Parameters")

training_period := reduce_load ? math.min(training_period, 200) : training_period

// Р”РѕР±Р°РІРёС‚СЊ Р°РґР°РїС‚РёРІРЅС‹Р№ РјРЅРѕР¶РёС‚РµР»СЊ РЅР° РѕСЃРЅРѕРІРµ entropy

// 6. Р”СЂСѓРіРёРµ РїР°СЂР°РјРµС‚СЂС‹
reinit_period = input.int(150, "Reinitialization Period", minval=100, group="K-means Parameters")
atr_len = input.int(10, "ATR Length", group="Features")
smooth_factor = input.int(2, "Smoothing", minval=1, group="Features")
rsi_len = input.int(9, "RSI Length", group="Features")
roc_len = input.int(7, "ROC Length", group="Features")
sma_len = input.int(14, "SMA Length for Slope", minval=5, group="Features")
// РќРѕРІС‹Рµ РїСЂРёР·РЅР°РєРё: Volume Рё MACD

km_volume = ta.ema(volume, smooth_factor)  // РЎРіР»Р°Р¶РµРЅРЅС‹Р№ РѕР±СЉРµРј (РёСЃРїРѕР»СЊР·СѓРµРј volume РІРјРµСЃС‚Рѕ ta.volume)
km_safe_volume = nz(km_volume, 0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA
[macd_line, signal_line, _] = ta.macd(close, 12, 26, 9)  // MACD (Р»РёРЅРёСЏ MACD)
km_macd = ta.ema(macd_line, smooth_factor)  // РЎРіР»Р°Р¶РµРЅРЅР°СЏ Р»РёРЅРёСЏ MACD
km_safe_macd = nz(km_macd, 0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA
// РќРѕРІС‹Рµ РїР°СЂР°РјРµС‚СЂС‹ РґР»СЏ РґРѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹С… РїСЂРёР·РЅР°РєРѕРІ

long_volume_period = input.int(50, "Long Volume Period", minval=10, maxval=200, group="Features")
corr_period = input.int(20, "Correlation Period", minval=5, maxval=50, group="Features")
rsi_volatility_period = input.int(20, "RSI Volatility Period", minval=5, maxval=50, group="Features")

// РџРµСЂРµРјРµРЅРЅС‹Рµ СЃРѕСЃС‚РѕСЏРЅРёСЏ K-means
var array<float> km_volume_history = array.new<float>()
var array<float> km_macd_history = array.new<float>()
var float km_volume_mean = 0.0
var float km_volume_std = 0.0
var float km_macd_mean = 0.0
var float km_macd_std = 0.0
var int max_clusters = 5
var int num_clusters = 3
min_clusters = 2
var int clusters = 0
var float cluster_confidence = 1.0
var array<float> km_centroids_volume = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_macd = array.new<float>(max_clusters, 0.0)
// === РџРµСЂРµРјРµРЅРЅС‹Рµ РґР»СЏ РёСЃС‚РѕСЂРёРё РєР»Р°СЃС‚РµСЂР° Рё СѓРІРµСЂРµРЅРЅРѕСЃС‚Рё ===
var array<float> cluster_norm_history = array.new<float>(0)
var array<float> confidence_history = array.new<float>(0)
// РРЅС‚РµРіСЂР°С†РёСЏ РїСЂРѕРІРµСЂРєРё РєР°С‡РµСЃС‚РІР° РІ РѕСЃРЅРѕРІРЅРѕР№ Р°Р»РіРѕСЂРёС‚Рј
var int last_quality_check = 0
var string current_quality_status = "INITIALIZING"
// РћР±СЉСЏРІР»СЏРµРј РЅРµРґРѕСЃС‚Р°СЋС‰РёРµ РїРµСЂРµРјРµРЅРЅС‹Рµ
var bool cluster_changed = false
var bool is_bull_trend = false
var bool is_bear_trend = false
var bool is_flat = false
// === Р‘Р°Р№РµСЃРѕРІСЃРєРёРµ Р°РїСЂРёРѕСЂС‹ (РґРѕР±Р°РІСЊС‚Рµ РІ РЅР°С‡Р°Р»Рѕ РёРЅРґРёРєР°С‚РѕСЂР°, РІ СЂР°Р·РґРµР» РїР°СЂР°РјРµС‚СЂРѕРІ) ===
var float bayes_prior_alpha = 1.0
var float bayes_prior_beta = 1.0
var float bayes_mu_prior = close * 0.01
var float bayes_kappa_prior = 1.0

//***************************************************************************************************
// РџРµСЂРµРјРµРЅРЅС‹Рµ СЃРѕСЃС‚РѕСЏРЅРёСЏ K-means
var int km_trend_bull_cluster = -1
var int km_trend_bear_cluster = -1
var int km_flat_cluster = -1
var bool km_kmeans_ok = false
var bool km_reinitialized_now = false

var float km_last_bull_score = na
var float km_last_bear_score = na
var float km_last_flat_score = na

float bull_score = 0.0  // Р’РјРµСЃС‚Рѕ int bull_score = 0
float bear_score = 0.0  // Р’РјРµСЃС‚Рѕ int bear_score = 0
float flat_score = 0.0  // Р’РјРµСЃС‚Рѕ int flat_score = 0

var array<float> km_centroids_atr = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_rsi = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_roc = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_slope = array.new<float>(max_clusters, 0.0)

var array<float> km_atr_history = array.new<float>()
var array<float> km_rsi_history = array.new<float>()
var array<float> km_roc_history = array.new<float>()
var array<float> km_slope_history = array.new<float>()

var float km_norm_current_atr = na
var float km_norm_current_rsi = na
var float km_norm_current_roc = na
var float km_norm_current_slope = na
var bool km_valid_point = false

var float km_atr_mean = 0.0
var float km_atr_std = 0.0
var float km_rsi_mean = 0.0
var float km_rsi_std = 0.0
var float km_roc_mean = 0.0
var float km_roc_std = 0.0
var float km_slope_mean = 0.0
var float km_slope_std = 0.0

var array<float> km_volume_ratio_history = array.new<float>(0)
var array<float> km_corr_price_volume_history = array.new<float>(0)
var array<float> km_corr_price_macd_history = array.new<float>(0)
var array<float> km_rsi_volatility_history = array.new<float>(0)

var float km_volume_ratio_mean = 0.0
var float km_volume_ratio_std = 0.0
var float km_corr_price_volume_mean = 0.0
var float km_corr_price_volume_std = 0.0
var float km_corr_price_macd_mean = 0.0
var float km_corr_price_macd_std = 0.0
var float km_rsi_volatility_mean = 0.0
var float km_rsi_volatility_std = 0.0

var array<float> km_centroids_volume_ratio = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_corr_price_volume = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_corr_price_macd = array.new<float>(max_clusters, 0.0)
var array<float> km_centroids_rsi_volatility = array.new<float>(max_clusters, 0.0)
//*********************************************************************
// === РЈР›РЈР§РЁР•РќРРЇ K-MEANS ===

// 2. РћР±СЂР°Р±РѕС‚РєР° РІС‹Р±СЂРѕСЃРѕРІ
var float outlier_threshold = 5
var bool use_outlier_detection = true

// 3. Р’СЂРµРјРµРЅРЅС‹Рµ РІРµСЃР°
var float decay_rate = 0.01
var array<int> time_history = array.new<int>(0)

// 4. РРЅРєСЂРµРјРµРЅС‚Р°Р»СЊРЅРѕРµ РѕР±РЅРѕРІР»РµРЅРёРµ
var array<int> cluster_sizes = array.new<int>(max_clusters, 0)

// 5. Р”РёРЅР°РјРёС‡РµСЃРєР°СЏ Р°РґР°РїС‚Р°С†РёСЏ РїСЂРёР·РЅР°РєРѕРІ
var array<float> feature_weights = array.new<float>(11, 1.0) // РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЂР°РІРЅС‹РјРё РІРµСЃР°РјРё

// 6. Р“РёР±СЂРёРґРЅР°СЏ РјРµС‚СЂРёРєР° СЂР°СЃСЃС‚РѕСЏРЅРёСЏ
var float euclidean_weight = 0.6
var float correlation_weight = 0.3
var float volatility_weight = 0.1

// 7. РљРѕРЅС‚СЂРѕР»СЊ СЃС‚Р°Р±РёР»СЊРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ
var int confirmation_bars = 3
var int cluster_change_counter = 0
var int last_cluster = na
var int km_current_cluster = na
var int previous_cluster = -1
var int cycles_in_current_state = 0
// =================================================================
// === РРЎРџР РђР’Р›Р•РќРќРђРЇ РЎР•РљР¦РРЇ: РР—РћР›РР РћР’РђРќРќР«Р• РџР•Р Р•РњР•РќРќР«Р• Р”Р›РЇ РљР›РђРЎРўР•Р РР—РђР¦РР ===
// =================================================================

// Р Р°СЃС‡РµС‚ С„РёС‡РµР№ РґР»СЏ K-means
km_volatility = ta.ema(ta.atr(atr_len), smooth_factor)
km_safe_smooth_vol = nz(km_volatility, ta.tr)
km_rsi_val = nz(ta.rsi(close, rsi_len), 50)
km_roc_val = nz(ta.roc(close, roc_len), 0)

km_sma_val = ta.sma(close, sma_len)
km_sma_slope = km_sma_val[1] != 0 ? (km_sma_val - km_sma_val[1]) / math.abs(km_sma_val[1]) * 1000 : 0
km_safe_sma_slope = nz(km_sma_slope, 0)

// Р Р°СЃС‡С‘С‚ РЅРѕРІС‹С… РїСЂРёР·РЅР°РєРѕРІ
km_volume_ratio = safe_div(km_volume, ta.sma(volume, long_volume_period), 1.0)  // РЎРѕРѕС‚РЅРѕС€РµРЅРёРµ РѕР±СЉС‘РјРѕРІ
km_safe_volume_ratio = nz(km_volume_ratio, 1.0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA

km_corr_price_volume = ta.correlation(close, volume, corr_period)  // РљРѕСЂСЂРµР»СЏС†РёСЏ С†РµРЅР°/РѕР±СЉС‘Рј
km_safe_corr_price_volume = nz(km_corr_price_volume, 0.0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA

km_corr_price_macd = ta.correlation(close, macd_line, corr_period)  // РљРѕСЂСЂРµР»СЏС†РёСЏ С†РµРЅР°/MACD
km_safe_corr_price_macd = nz(km_corr_price_macd, 0.0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA

km_rsi_volatility = ta.stdev(ta.rsi(close, rsi_len), rsi_volatility_period)  // Р’РѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ RSI
km_safe_rsi_volatility = nz(km_rsi_volatility, 0.0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA

// Р”РѕР±Р°РІР»РµРЅРѕ: SMA20 РґР»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ РІ РєР»Р°СЃС‚РµСЂРёР·Р°С†РёРё
km_sma20 = ta.sma(close, 20)


// Р¤СѓРЅРєС†РёСЏ РІС‹С‡РёСЃР»РµРЅРёСЏ СЌРЅС‚СЂРѕРїРёРё РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР°
entropy(float[] src, int len, int bins=10) =>
    // РџСЂРѕРІРµСЂСЏРµРј, С‡С‚Рѕ РјР°СЃСЃРёРІ src РЅРµ РїСѓСЃС‚РѕР№
    if array.size(src) < 2
        0.0
    else
        // РЎРѕР·РґР°РµРј РјР°СЃСЃРёРІ hist СЃ РѕРіСЂР°РЅРёС‡РµРЅРЅС‹Рј СЂР°Р·РјРµСЂРѕРј
        var float[] hist = array.new_float(0)
        array.clear(hist)  // РћС‡РёС‰Р°РµРј РјР°СЃСЃРёРІ РїРµСЂРµРґ Р·Р°РїРѕР»РЅРµРЅРёРµРј
        for i = 0 to math.min(len - 1, array.size(src) - 1)
            float val = array.get(src, i)
            if not na(val)
                array.push(hist, val)
            // РћРіСЂР°РЅРёС‡РёРІР°РµРј СЂР°Р·РјРµСЂ hist
            if array.size(hist) > len
                array.shift(hist)
        
        // РџСЂРѕРІРµСЂСЏРµРј, РґРѕСЃС‚Р°С‚РѕС‡РЅРѕ Р»Рё РґР°РЅРЅС‹С…
        if array.size(hist) < 2
            0.0
        else
            // РќР°С…РѕРґРёРј РјРёРЅРёРјР°Р»СЊРЅРѕРµ Рё РјР°РєСЃРёРјР°Р»СЊРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ
            float min_val = array.min(hist)
            float max_val = array.max(hist)
            float bin_size = (max_val - min_val) / bins
            if bin_size == 0
                bin_size := 1e-10  // РР·Р±РµРіР°РµРј РґРµР»РµРЅРёСЏ РЅР° РЅРѕР»СЊ
            
            // РЎРѕР·РґР°РµРј РјР°СЃСЃРёРІ РґР»СЏ РїРѕРґСЃС‡РµС‚Р° С‡Р°СЃС‚РѕС‚С‹ РІ Р±РёРЅР°С…
            var int[] counts = array.new_int(bins, 0)
            for val in hist
                bin = math.floor((val - min_val) / bin_size)
                bin := math.min(math.max(bin, 0), bins - 1)
                array.set(counts, bin, array.get(counts, bin) + 1)
            
            // Р’С‹С‡РёСЃР»СЏРµРј СЌРЅС‚СЂРѕРїРёСЋ
            float ent = 0.0
            float total = array.sum(counts)
            if total == 0
                0.0
            else
                for c in counts
                    p = c / total
                    if p > 0
                        ent -= p * math.log(p)
                ent
// РџР°СЂР°РјРµС‚СЂС‹ РґР»СЏ СЌРЅС‚СЂРѕРїРёРё
var int entropy_length = 20  // РџРµСЂРёРѕРґ РґР»СЏ РІС‹С‡РёСЃР»РµРЅРёСЏ СЌРЅС‚СЂРѕРїРёРё
var float entropy_mult = 1.5  // РњРЅРѕР¶РёС‚РµР»СЊ РґР»СЏ Р°РґР°РїС‚Р°С†РёРё РїРѕСЂРѕРіР° РІС‹Р±СЂРѕСЃРѕРІ
var int min_training_period = 100  // РњРёРЅРёРјР°Р»СЊРЅС‹Р№ РїРµСЂРёРѕРґ РѕР±СѓС‡РµРЅРёСЏ
var int max_training_period = 200  // РњР°РєСЃРёРјР°Р»СЊРЅС‹Р№ РїРµСЂРёРѕРґ РѕР±СѓС‡РµРЅРёСЏ

var float[] close_history = array.new_float(0)
array.push(close_history, close)
if array.size(close_history) > entropy_length
    array.shift(close_history)
float entropy_val = entropy(close_history, entropy_length)

// NEW: Entropy as feature
km_entropy = entropy_val  // РЈР¶Рµ РІС‹С‡РёСЃР»РµРЅР°
km_safe_entropy = nz(km_entropy, 0.0)  // Р—Р°С‰РёС‚Р° РѕС‚ NA


//РђРґР°РїС‚Р°С†РёСЏ РїР°СЂР°РјРµС‚СЂРѕРІ РЅР° РѕСЃРЅРѕРІРµ СЌРЅС‚СЂРѕРїРёРё
float adjusted_outlier_threshold = outlier_threshold * (1.0 + entropy_mult * entropy_val)  // РђРґР°РїС‚РёРІРЅС‹Р№ РїРѕСЂРѕРі РІС‹Р±СЂРѕСЃРѕРІ
int adjusted_training_period = math.round(math.max(min_training_period, math.min(max_training_period, training_period / (1.0 + entropy_val))))

//NEW: Entropy history, mean, std, centroids
var array<float> km_entropy_history = array.new<float>(0)
var float km_entropy_mean = 0.0
var float km_entropy_std = 0.0
var array<float> km_centroids_entropy = array.new<float>(max_clusters, 0.0)

// === Р¤РЈРќРљР¦РР РЈР›РЈР§РЁР•РќРР™ ===
// 1. Р¤СѓРЅРєС†РёСЏ РѕРїСЂРµРґРµР»РµРЅРёСЏ РІС‹Р±СЂРѕСЃРѕРІ
is_outlier(value, series) =>
    if not use_outlier_detection or array.size(series) < 10
        false
    else
        median = array.median(series)
        mad_values = array.new_float(0)
        for i = 0 to array.size(series) - 1
            array.push(mad_values, math.abs(array.get(series, i) - median))
        mad = array.median(mad_values)
        z_score = 0.6745 * (value - median) / (mad + 0.0001)
        math.abs(z_score) > outlier_threshold
// 2. Р¤СѓРЅРєС†РёСЏ РІСЂРµРјРµРЅРЅРѕРіРѕ РІРµСЃР°
time_weight(bar_index_diff) =>
    math.exp(-decay_rate * bar_index_diff)

// 3. Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕРїСЂРµРґРµР»РµРЅРёСЏ РѕРїС‚РёРјР°Р»СЊРЅРѕРіРѕ С‡РёСЃР»Р° РєР»Р°СЃС‚РµСЂРѕРІ
find_optimal_clusters() =>
    // Р’С‹С‡РёСЃР»СЏРµРј adjusted_training_period РІРЅСѓС‚СЂРё С„СѓРЅРєС†РёРё
    int local_adjusted_training_period = int(math.round(math.max(min_training_period, math.min(max_training_period, training_period / (1.0 + entropy_val)))))
    
    float[] wcss_values = array.new<float>()
    
    for k = min_clusters to max_clusters
        wcss = 0.0
        
        // РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ С†РµРЅС‚СЂРѕРёРґРѕРІ РґР»СЏ РІСЃРµС… РїСЂРёР·РЅР°РєРѕРІ
        centroids_atr = array.new<float>()
        centroids_rsi = array.new<float>()
        centroids_roc = array.new<float>()
        centroids_slope = array.new<float>()
        centroids_volume = array.new<float>()
        centroids_macd = array.new<float>()
        centroids_volume_ratio = array.new<float>()
        centroids_corr_price_volume = array.new<float>()
        centroids_corr_price_macd = array.new<float>()
        centroids_rsi_volatility = array.new<float>()
        centroids_entropy = array.new<float>()

        // РЎР»СѓС‡Р°Р№РЅР°СЏ РёРЅРёС†РёР°Р»РёР·Р°С†РёСЏ С†РµРЅС‚СЂРѕРёРґРѕРІ
        for i = 0 to k - 1
            // РџСЂРѕРІРµСЂРєР° РґРѕСЃС‚СѓРїРЅРѕСЃС‚Рё РґР°РЅРЅС‹С…
            if array.size(km_atr_history) > 0
                idx = math.floor(math.random() * math.min(array.size(km_atr_history), local_adjusted_training_period))
                
                // Р—Р°РїРѕР»РЅРµРЅРёРµ С†РµРЅС‚СЂРѕРёРґРѕРІ СЃ РїСЂРѕРІРµСЂРєРѕР№ РіСЂР°РЅРёС† РјР°СЃСЃРёРІРѕРІ
                if idx < array.size(km_atr_history)
                    array.push(centroids_atr, array.get(km_atr_history, idx))
                if idx < array.size(km_rsi_history)
                    array.push(centroids_rsi, array.get(km_rsi_history, idx))
                if idx < array.size(km_roc_history)
                    array.push(centroids_roc, array.get(km_roc_history, idx))
                if idx < array.size(km_slope_history)
                    array.push(centroids_slope, array.get(km_slope_history, idx))
                if idx < array.size(km_volume_history)
                    array.push(centroids_volume, array.get(km_volume_history, idx))
                if idx < array.size(km_macd_history)
                    array.push(centroids_macd, array.get(km_macd_history, idx))
                if idx < array.size(km_volume_ratio_history)
                    array.push(centroids_volume_ratio, array.get(km_volume_ratio_history, idx))
                if idx < array.size(km_corr_price_volume_history)
                    array.push(centroids_corr_price_volume, array.get(km_corr_price_volume_history, idx))
                if idx < array.size(km_corr_price_macd_history)
                    array.push(centroids_corr_price_macd, array.get(km_corr_price_macd_history, idx))
                if idx < array.size(km_rsi_volatility_history)
                    array.push(centroids_rsi_volatility, array.get(km_rsi_volatility_history, idx))
                if idx < array.size(km_entropy_history)
                    array.push(centroids_entropy, array.get(km_entropy_history, idx))  // NEW:
        // РћРіСЂР°РЅРёС‡РёРІР°РµРј РєРѕР»РёС‡РµСЃС‚РІРѕ РёС‚РµСЂР°С†РёР№ РґР»СЏ РїСЂРѕРёР·РІРѕРґРёС‚РµР»СЊРЅРѕСЃС‚Рё
        max_iterations = 5
        
        // РћР±СЉСЏРІР»СЏРµРј cluster_assignments Р·РґРµСЃСЊ, С‡С‚РѕР±С‹ РѕРЅР° Р±С‹Р»Р° РІРёРґРЅР° РІРѕ РІСЃРµР№ РѕР±Р»Р°СЃС‚Рё РІРёРґРёРјРѕСЃС‚Рё С†РёРєР»Р° k
        var int[] cluster_assignments = array.new<int>(math.min(array.size(km_atr_history), local_adjusted_training_period), 0)
        
        for iter = 0 to max_iterations - 1
            // РќР°Р·РЅР°С‡РµРЅРёРµ С‚РѕС‡РµРє Р±Р»РёР¶Р°Р№С€РёРј С†РµРЅС‚СЂРѕРёРґР°Рј
            for i = 0 to math.min(array.size(km_atr_history), local_adjusted_training_period) - 1
                min_dist = 10e10
                closest_centroid = 0
                
                for c = 0 to array.size(centroids_atr) - 1
                    // РџСЂРѕРІРµСЂРєР° РґРѕСЃС‚СѓРїРЅРѕСЃС‚Рё РґР°РЅРЅС‹С… РґР»СЏ РІСЃРµС… РїСЂРёР·РЅР°РєРѕРІ
                    atr_val = i < array.size(km_atr_history) ? array.get(km_atr_history, i) : 0
                    rsi_val = i < array.size(km_rsi_history) ? array.get(km_rsi_history, i) : 50
                    roc_val = i < array.size(km_roc_history) ? array.get(km_roc_history, i) : 0
                    slope_val = i < array.size(km_slope_history) ? array.get(km_slope_history, i) : 0
                    volume_val = i < array.size(km_volume_history) ? array.get(km_volume_history, i) : 0
                    macd_val = i < array.size(km_macd_history) ? array.get(km_macd_history, i) : 0
                    volume_ratio_val = i < array.size(km_volume_ratio_history) ? array.get(km_volume_ratio_history, i) : 1
                    corr_pv_val = i < array.size(km_corr_price_volume_history) ? array.get(km_corr_price_volume_history, i) : 0
                    corr_pm_val = i < array.size(km_corr_price_macd_history) ? array.get(km_corr_price_macd_history, i) : 0
                    rsi_vol_val = i < array.size(km_rsi_volatility_history) ? array.get(km_rsi_volatility_history, i) : 0
                    entropy_val_i = i < array.size(km_entropy_history) ? array.get(km_entropy_history, i) : 0  // NEW:

                    // РџРѕР»СѓС‡РµРЅРёРµ Р·РЅР°С‡РµРЅРёР№ С†РµРЅС‚СЂРѕРёРґРѕРІ СЃ РїСЂРѕРІРµСЂРєРѕР№ РіСЂР°РЅРёС†
                    centroid_atr = c < array.size(centroids_atr) ? array.get(centroids_atr, c) : 0
                    centroid_rsi = c < array.size(centroids_rsi) ? array.get(centroids_rsi, c) : 50
                    centroid_roc = c < array.size(centroids_roc) ? array.get(centroids_roc, c) : 0
                    centroid_slope = c < array.size(centroids_slope) ? array.get(centroids_slope, c) : 0
                    centroid_volume = c < array.size(centroids_volume) ? array.get(centroids_volume, c) : 0
                    centroid_macd = c < array.size(centroids_macd) ? array.get(centroids_macd, c) : 0
                    centroid_volume_ratio = c < array.size(centroids_volume_ratio) ? array.get(centroids_volume_ratio, c) : 1
                    centroid_corr_pv = c < array.size(centroids_corr_price_volume) ? array.get(centroids_corr_price_volume, c) : 0
                    centroid_corr_pm = c < array.size(centroids_corr_price_macd) ? array.get(centroids_corr_price_macd, c) : 0
                    centroid_rsi_vol = c < array.size(centroids_rsi_volatility) ? array.get(centroids_rsi_volatility, c) : 0
                    centroid_entropy = c < array.size(centroids_entropy) ? array.get(centroids_entropy, c) : 0
                    // Р’С‹С‡РёСЃР»РµРЅРёРµ СЂР°СЃСЃС‚РѕСЏРЅРёСЏ
                    dist = math.sqrt(math.pow(atr_val - centroid_atr, 2) + math.pow(rsi_val - centroid_rsi, 2) + math.pow(roc_val - centroid_roc, 2) + math.pow(slope_val - centroid_slope, 2) + math.pow(volume_val - centroid_volume, 2) + math.pow(macd_val - centroid_macd, 2) + math.pow(volume_ratio_val - centroid_volume_ratio, 2) + math.pow(corr_pv_val - centroid_corr_pv, 2) + math.pow(corr_pm_val - centroid_corr_pm, 2) + math.pow(rsi_vol_val - centroid_rsi_vol, 2))
                    
                    if dist < min_dist
                        min_dist := dist
                        closest_centroid := c
                
                array.set(cluster_assignments, i, closest_centroid)
            
            // РџРµСЂРµСЃС‡РµС‚ С†РµРЅС‚СЂРѕРёРґРѕРІ
            for c = 0 to array.size(centroids_atr) - 1
                sum_atr = 0.0
                sum_rsi = 0.0
                sum_roc = 0.0
                sum_slope = 0.0
                sum_volume = 0.0
                sum_macd = 0.0
                sum_volume_ratio = 0.0
                sum_corr_pv = 0.0
                sum_corr_pm = 0.0
                sum_rsi_vol = 0.0
                count = 0
                sum_entropy = 0.0  // NEW: Entropy as feature
                for i = 0 to math.min(array.size(km_atr_history), local_adjusted_training_period) - 1
                    if i < array.size(cluster_assignments) and array.get(cluster_assignments, i) == c
                        if i < array.size(km_atr_history)
                            sum_atr += array.get(km_atr_history, i)
                        if i < array.size(km_rsi_history)
                            sum_rsi += array.get(km_rsi_history, i)
                        if i < array.size(km_roc_history)
                            sum_roc += array.get(km_roc_history, i)
                        if i < array.size(km_slope_history)
                            sum_slope += array.get(km_slope_history, i)
                        if i < array.size(km_volume_history)
                            sum_volume += array.get(km_volume_history, i)
                        if i < array.size(km_macd_history)
                            sum_macd += array.get(km_macd_history, i)
                        if i < array.size(km_volume_ratio_history)
                            sum_volume_ratio += array.get(km_volume_ratio_history, i)
                        if i < array.size(km_corr_price_volume_history)
                            sum_corr_pv += array.get(km_corr_price_volume_history, i)
                        if i < array.size(km_corr_price_macd_history)
                            sum_corr_pm += array.get(km_corr_price_macd_history, i)
                        if i < array.size(km_rsi_volatility_history)
                            sum_rsi_vol += array.get(km_rsi_volatility_history, i)
                        if i < array.size(km_entropy_history)
                            sum_entropy += array.get(km_entropy_history, i)  // NEW: Entropy as feature
                        count += 1
                
                if count > 0
                    if c < array.size(centroids_atr)
                        array.set(centroids_atr, c, sum_atr / count)
                    if c < array.size(centroids_rsi)
                        array.set(centroids_rsi, c, sum_rsi / count)
                    if c < array.size(centroids_roc)
                        array.set(centroids_roc, c, sum_roc / count)
                    if c < array.size(centroids_slope)
                        array.set(centroids_slope, c, sum_slope / count)
                    if c < array.size(centroids_volume)
                        array.set(centroids_volume, c, sum_volume / count)
                    if c < array.size(centroids_macd)
                        array.set(centroids_macd, c, sum_macd / count)
                    if c < array.size(centroids_volume_ratio)
                        array.set(centroids_volume_ratio, c, sum_volume_ratio / count)
                    if c < array.size(centroids_corr_price_volume)
                        array.set(centroids_corr_price_volume, c, sum_corr_pv / count)
                    if c < array.size(centroids_corr_price_macd)
                        array.set(centroids_corr_price_macd, c, sum_corr_pm / count)
                    if c < array.size(centroids_rsi_volatility)
                        array.set(centroids_rsi_volatility, c, sum_rsi_vol / count)
                    if c < array.size(centroids_entropy)
                        array.set(centroids_entropy, c, sum_entropy / count)  // NEW: Entropy as feature
        
        // Р Р°СЃС‡РµС‚ WCSS РґР»СЏ С‚РµРєСѓС‰РµРіРѕ k
        current_wcss = 0.0
        for i = 0 to math.min(array.size(km_atr_history), local_adjusted_training_period) - 1
            if i < array.size(cluster_assignments)
                c = array.get(cluster_assignments, i)
                
                // РџРѕР»СѓС‡РµРЅРёРµ Р·РЅР°С‡РµРЅРёР№ С‚РѕС‡РєРё РґР°РЅРЅС‹С…
                atr_val = i < array.size(km_atr_history) ? array.get(km_atr_history, i) : 0
                rsi_val = i < array.size(km_rsi_history) ? array.get(km_rsi_history, i) : 50
                roc_val = i < array.size(km_roc_history) ? array.get(km_roc_history, i) : 0
                slope_val = i < array.size(km_slope_history) ? array.get(km_slope_history, i) : 0
                volume_val = i < array.size(km_volume_history) ? array.get(km_volume_history, i) : 0
                macd_val = i < array.size(km_macd_history) ? array.get(km_macd_history, i) : 0
                volume_ratio_val = i < array.size(km_volume_ratio_history) ? array.get(km_volume_ratio_history, i) : 1
                corr_pv_val = i < array.size(km_corr_price_volume_history) ? array.get(km_corr_price_volume_history, i) : 0
                corr_pm_val = i < array.size(km_corr_price_macd_history) ? array.get(km_corr_price_macd_history, i) : 0
                rsi_vol_val = i < array.size(km_rsi_volatility_history) ? array.get(km_rsi_volatility_history, i) : 0
                entropy_val_i = i < array.size(km_entropy_history) ? array.get(km_entropy_history, i) : 0  // NEW: Entropy as feature
                // РџРѕР»СѓС‡РµРЅРёРµ Р·РЅР°С‡РµРЅРёР№ С†РµРЅС‚СЂРѕРёРґР°
                centroid_atr = c < array.size(centroids_atr) ? array.get(centroids_atr, c) : 0
                centroid_rsi = c < array.size(centroids_rsi) ? array.get(centroids_rsi, c) : 50
                centroid_roc = c < array.size(centroids_roc) ? array.get(centroids_roc, c) : 0
                centroid_slope = c < array.size(centroids_slope) ? array.get(centroids_slope, c) : 0
                centroid_volume = c < array.size(centroids_volume) ? array.get(centroids_volume, c) : 0
                centroid_macd = c < array.size(centroids_macd) ? array.get(centroids_macd, c) : 0
                centroid_volume_ratio = c < array.size(centroids_volume_ratio) ? array.get(centroids_volume_ratio, c) : 1
                centroid_corr_pv = c < array.size(centroids_corr_price_volume) ? array.get(centroids_corr_price_volume, c) : 0
                centroid_corr_pm = c < array.size(centroids_corr_price_macd) ? array.get(centroids_corr_price_macd, c) : 0
                centroid_rsi_vol = c < array.size(centroids_rsi_volatility) ? array.get(centroids_rsi_volatility, c) : 0
                centroid_entropy = c < array.size(centroids_entropy) ? array.get(centroids_entropy, c) : 0  // NEW: Entropy as feature
                // Р’С‹С‡РёСЃР»РµРЅРёРµ СЂР°СЃСЃС‚РѕСЏРЅРёСЏ Рё РґРѕР±Р°РІР»РµРЅРёРµ Рє WCSS
                dist = math.sqrt(math.pow(atr_val - centroid_atr, 2) + math.pow(rsi_val - centroid_rsi, 2) + math.pow(roc_val - centroid_roc, 2) + math.pow(slope_val - centroid_slope, 2) + math.pow(volume_val - centroid_volume, 2) + math.pow(macd_val - centroid_macd, 2) + math.pow(volume_ratio_val - centroid_volume_ratio, 2) + math.pow(corr_pv_val - centroid_corr_pv, 2) + math.pow(corr_pm_val - centroid_corr_pm, 2) + math.pow(rsi_vol_val - centroid_rsi_vol, 2) + math.pow(entropy_val_i - centroid_entropy, 2)) 
                
                current_wcss := current_wcss + dist * dist
        
        array.push(wcss_values, current_wcss)
    
    // РњРµС‚РѕРґ Р»РѕРєС‚СЏ: РїРѕРёСЃРє РЅР°РёР±РѕР»СЊС€РµРіРѕ СѓРіР»Р° РІ РєСЂРёРІРѕР№
    optimal_k = 3  // Р—РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    
    if array.size(wcss_values) > 2
        max_angle = -10e10
        for i = 1 to array.size(wcss_values) - 2
            angle = math.abs(array.get(wcss_values, i+1) - 2 * array.get(wcss_values, i) + array.get(wcss_values, i-1))
            if angle > max_angle
                max_angle := angle
                optimal_k := i + min_clusters
    
    optimal_k
// 5. Р¤СѓРЅРєС†РёСЏ РѕР±РЅРѕРІР»РµРЅРёСЏ РІРµСЃРѕРІ РїСЂРёР·РЅР°РєРѕРІ (РРЎРџР РђР’Р›Р•РќРќРђРЇ)
update_feature_weights() =>
    if array.size(km_atr_history) > 10
        // Р’С‹С‡РёСЃР»СЏРµРј РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ (СЃС‚Р°РЅРґР°СЂС‚РЅРѕРµ РѕС‚РєР»РѕРЅРµРЅРёРµ) РґР»СЏ РєР°Р¶РґРѕРіРѕ РїСЂРёР·РЅР°РєР°
        atr_vol = array.stdev(km_atr_history)
        rsi_vol = array.stdev(km_rsi_history)
        roc_vol = array.stdev(km_roc_history)
        slope_vol = array.stdev(km_slope_history)
        volume_vol = array.stdev(km_volume_history)
        macd_vol = array.stdev(km_macd_history)
        volume_ratio_vol = array.stdev(km_volume_ratio_history)
        corr_price_volume_vol = array.stdev(km_corr_price_volume_history)
        corr_price_macd_vol = array.stdev(km_corr_price_macd_history)
        rsi_volatility_vol = array.stdev(km_rsi_volatility_history)
        entropy_vol = array.stdev(km_entropy_history)
        
        // Р’С‹С‡РёСЃР»СЏРµРј РѕР±С‰СѓСЋ РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ
        total_vol = atr_vol + rsi_vol + roc_vol + slope_vol + volume_vol + macd_vol + volume_ratio_vol + corr_price_volume_vol + corr_price_macd_vol + rsi_volatility_vol + entropy_vol
        
        // РћР±РЅРѕРІР»СЏРµРј РІРµСЃР° РїСЂРёР·РЅР°РєРѕРІ РїСЂРѕРїРѕСЂС†РёРѕРЅР°Р»СЊРЅРѕ РёС… РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚Рё
        if total_vol > 0
            // РЈР±РµРґРёРјСЃСЏ, С‡С‚Рѕ РјР°СЃСЃРёРІ feature_weights РёРјРµРµС‚ РїСЂР°РІРёР»СЊРЅС‹Р№ СЂР°Р·РјРµСЂ
            if array.size(feature_weights) < 11
                // РџРµСЂРµСЃРѕР·РґР°РµРј РјР°СЃСЃРёРІ СЃ РїСЂР°РІРёР»СЊРЅС‹Рј СЂР°Р·РјРµСЂРѕРј
                array.clear(feature_weights)
                for i = 0 to 10
                    array.push(feature_weights, 1.0) // РРЅРёС†РёР°Р»РёР·РёСЂСѓРµРј СЂР°РІРЅС‹РјРё РІРµСЃР°РјРё
            
            // РЈСЃС‚Р°РЅР°РІР»РёРІР°РµРј РІРµСЃР°
            array.set(feature_weights, 0, 1.0)   // ATR
            array.set(feature_weights, 1, 3.0)   // RSI в†ђ РІС‹СЃРѕРєРёР№ РІРµСЃ
            array.set(feature_weights, 2, 3.0)   // ROC в†ђ РІС‹СЃРѕРєРёР№ РІРµСЃ
            array.set(feature_weights, 3, 2.0)   // Slope в†ђ РІС‹СЃРѕРєРёР№ РІРµСЃ
            array.set(feature_weights, 4, 1.0)   // Volume
            array.set(feature_weights, 5, 2.0)   // MACD в†ђ РІС‹СЃРѕРєРёР№ РІРµСЃ
            array.set(feature_weights, 6, 0.8)   // Volume Ratio
            array.set(feature_weights, 7, 0.8)   // Corr Price-Volume
            array.set(feature_weights, 8, 1.5)   // Corr Price-MACD в†ђ СЃСЂРµРґРЅРёР№ РІРµСЃ
            array.set(feature_weights, 9, 1.2)   // RSI Volatility
            array.set(feature_weights, 10, 0.5)  // Entropy в†ђ РЅРёР·РєРёР№ РІРµСЃ

/// 5. РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РєР°Р»РёР±СЂРѕРІРєР° РєР»Р°СЃС‚РµСЂРѕРІ (РРЎРџР РђР’Р›Р•РќРќРђРЇ Р’Р•Р РЎРРЇ)
auto_calibrate_clusters() =>
    // РџСЂРѕРІРµСЂРєР° Р°РєС‚РёРІРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ
    active_clusters = 0
    active_indices = array.new<int>()
    for i = 0 to num_clusters - 1
        if array.get(cluster_sizes, i) > 0
            active_clusters := active_clusters + 1
            array.push(active_indices, i)
    
    // Р•СЃР»Рё РјРµРЅРµРµ 3 Р°РєС‚РёРІРЅС‹С… РєР»Р°СЃС‚РµСЂРѕРІ, РёСЃРїРѕР»СЊР·СѓРµРј РґРѕСЃС‚СѓРїРЅС‹Рµ
    if active_clusters < 3
        resultArray = array.new<int>(3)
        
        // Р—Р°С‰РёС‚Р° РѕС‚ РїСѓСЃС‚РѕРіРѕ РјР°СЃСЃРёРІР° active_indices
        if array.size(active_indices) == 0
            // Р•СЃР»Рё РЅРµС‚ Р°РєС‚РёРІРЅС‹С… РєР»Р°СЃС‚РµСЂРѕРІ, РёСЃРїРѕР»СЊР·СѓРµРј РїРµСЂРІС‹Рµ С‚СЂРё
            for i = 0 to 2
                if i < num_clusters
                    array.set(resultArray, i, i)
                else
                    // Р•СЃР»Рё РєР»Р°СЃС‚РµСЂРѕРІ РјРµРЅСЊС€Рµ 3, РїРѕРІС‚РѕСЂСЏРµРј РїРѕСЃР»РµРґРЅРёР№ РґРѕСЃС‚СѓРїРЅС‹Р№
                    array.set(resultArray, i, math.min(num_clusters - 1, 0))
        else
            for i = 0 to 2
                if i < array.size(active_indices)
                    array.set(resultArray, i, array.get(active_indices, i))
                else
                    // Р•СЃР»Рё Р°РєС‚РёРІРЅС‹С… РєР»Р°СЃС‚РµСЂРѕРІ РјРµРЅСЊС€Рµ 3, РїРѕРІС‚РѕСЂСЏРµРј РїРѕСЃР»РµРґРЅРёР№ РґРѕСЃС‚СѓРїРЅС‹Р№
                    array.set(resultArray, i, array.get(active_indices, array.size(active_indices) - 1))
        resultArray
    else
        // РџРѕР»РЅР°СЏ СЂРµР°Р»РёР·Р°С†РёСЏ РєР°Р»РёР±СЂРѕРІРєРё СЃ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёРµРј СЂРµР°Р»СЊРЅС‹С… РґР°РЅРЅС‹С…
        float max_score = -10e9
        int best_bull = -1
        int best_bear = -1
        int best_flat = -1
        
        // РџРµСЂРµР±РёСЂР°РµРј РІСЃРµ РІРѕР·РјРѕР¶РЅС‹Рµ РєРѕРјР±РёРЅР°С†РёРё РєР»Р°СЃС‚РµСЂРѕРІ
        for bull = 0 to num_clusters - 1
            for bear = 0 to num_clusters - 1
                if bear == bull
                    continue
                for flat_idx = 0 to num_clusters - 1
                    if flat_idx == bull or flat_idx == bear
                        continue
                    
                    // Р РµР°Р»СЊРЅС‹Р№ СЂР°СЃС‡РµС‚ СЃРєРѕСЂР° РЅР° РѕСЃРЅРѕРІРµ С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРє РєР»Р°СЃС‚РµСЂРѕРІ
                    score = 0.0
                    // Р‘С‹С‡СЊРё С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРєРё
                    if array.get(km_centroids_rsi, bull) < 45
                        score += 10
                    if array.get(km_centroids_roc, bull) > 0
                        score += 5
                    if array.get(km_centroids_slope, bull) > 0
                        score += 5
                    
                    // РњРµРґРІРµР¶СЊРё С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРєРё
                    if array.get(km_centroids_rsi, bear) > 55
                        score += 10
                    if array.get(km_centroids_roc, bear) < 0
                        score += 5
                    if array.get(km_centroids_slope, bear) < 0
                        score += 5
                    
                    // Р¤Р»СЌС‚РѕРІС‹Рµ С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРєРё
                    if math.abs(array.get(km_centroids_rsi, flat_idx) - 50) < 5
                        score += 10
                    if math.abs(array.get(km_centroids_roc, flat_idx)) < 1
                        score += 5
                    if math.abs(array.get(km_centroids_slope, flat_idx)) < 0.5
                        score += 5
                    
                    // Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Рµ РїСЂРёР·РЅР°РєРё РёР· СЂРµР°Р»СЊРЅС‹С… РґР°РЅРЅС‹С…
                    if array.size(km_centroids_volume) > bull
                        if array.get(km_centroids_volume, bull) > 1.0
                            score += 5
                    if array.size(km_centroids_volume) > bear
                        if array.get(km_centroids_volume, bear) > 1.0
                            score += 5
                    if array.size(km_centroids_volume) > flat_idx
                        if array.get(km_centroids_volume, flat_idx) <= 1.0
                            score += 5
                    // NEW: Entropy as feature in scoring
                    if array.size(km_centroids_entropy) > bull
                        if array.get(km_centroids_entropy, bull) > km_entropy_mean + km_entropy_std
                            score += 2  // Р’С‹СЃРѕРєР°СЏ СЌРЅС‚СЂРѕРїРёСЏ РґР»СЏ bull (РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ)
                    if array.size(km_centroids_entropy) > bear
                        if array.get(km_centroids_entropy, bear) > km_entropy_mean + km_entropy_std
                            score += 2  // Р’С‹СЃРѕРєР°СЏ СЌРЅС‚СЂРѕРїРёСЏ РґР»СЏ bear
                    if array.size(km_centroids_entropy) > flat_idx
                        if array.get(km_centroids_entropy, flat_idx) < km_entropy_mean
                            score += 2  // РќРёР·РєР°СЏ СЌРЅС‚СЂРѕРїРёСЏ РґР»СЏ flat (СЃС‚Р°Р±РёР»СЊРЅРѕСЃС‚СЊ)

                    if score > max_score
                        max_score := score
                        best_bull := bull
                        best_bear := bear
                        best_flat := flat_idx
        
        resultArray = array.new<int>(3)
        array.set(resultArray, 0, best_bull)
        array.set(resultArray, 1, best_bear)
        array.set(resultArray, 2, best_flat)
        resultArray

// 6. РџСЂРѕРІРµСЂРєР° СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ (Р’Р—Р’Р•РЁР•РќРќРђРЇ Р’Р•Р РЎРРЇ)
check_cluster_consistency() =>
    valid = true
    min_distance = 2.0  // РЈРІРµР»РёС‡РµРЅРѕ СЃ 1.5 РґРѕ 2.0 РґР»СЏ Р±РѕР»РµРµ СЃС‚СЂРѕРіРѕРіРѕ СЂР°Р·РґРµР»РµРЅРёСЏ
    
    // Р’РµСЃР° РїСЂРёР·РЅР°РєРѕРІ (РїСЂРёРѕСЂРёС‚РµС‚ С‚СЂРµРЅРґРѕРІС‹Рј РёРЅРґРёРєР°С‚РѕСЂР°Рј)
    w_rsi = 3.0           // Р’С‹СЃРѕРєРёР№ РІРµСЃ - РєР»СЋС‡РµРІРѕР№ РёРЅРґРёРєР°С‚РѕСЂ С‚СЂРµРЅРґР°
    w_roc = 3.0           // Р’С‹СЃРѕРєРёР№ РІРµСЃ - СЃРєРѕСЂРѕСЃС‚СЊ РёР·РјРµРЅРµРЅРёСЏ
    w_slope = 2.0         // Р’С‹СЃРѕРєРёР№ РІРµСЃ - РЅР°РїСЂР°РІР»РµРЅРёРµ С‚СЂРµРЅРґР°
    w_macd = 2.0          // Р’С‹СЃРѕРєРёР№ РІРµСЃ - РґРёРІРµСЂРіРµРЅС†РёСЏ
    w_corr_pm = 1.5       // РЎСЂРµРґРЅРёР№ РІРµСЃ - РєРѕСЂСЂРµР»СЏС†РёСЏ price-MACD
    w_rsi_vol = 1.2       // РЎСЂРµРґРЅРёР№ РІРµСЃ - РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ RSI
    w_atr = 1.0           // РЎСЂРµРґРЅРёР№ РІРµСЃ - РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ
    w_volume = 1.0        // РЎСЂРµРґРЅРёР№ РІРµСЃ - РѕР±СЉС‘Рј
    w_vol_ratio = 0.8     // РќРёР·РєРёР№ РІРµСЃ - РѕС‚РЅРѕСЃРёС‚РµР»СЊРЅС‹Р№ РѕР±СЉС‘Рј
    w_corr_pv = 0.8       // РќРёР·РєРёР№ РІРµСЃ - РєРѕСЂСЂРµР»СЏС†РёСЏ price-volume
    w_entropy = 0.5       // РќРёР·РєРёР№ РІРµСЃ - СЌРЅС‚СЂРѕРїРёСЏ (С€СѓРјРѕРІР°СЏ РјРµС‚СЂРёРєР°)
    
    // РџСЂРѕРІРµСЂРєР° РјРёРЅРёРјР°Р»СЊРЅРѕРіРѕ СЂР°СЃСЃС‚РѕСЏРЅРёСЏ РјРµР¶РґСѓ С†РµРЅС‚СЂРѕРёРґР°РјРё
    for i = 0 to num_clusters - 2
        for j = i + 1 to num_clusters - 1
            if i < array.size(km_centroids_atr) and j < array.size(km_centroids_atr)
                // РР·РІР»РµС‡РµРЅРёРµ С†РµРЅС‚СЂРѕРёРґРѕРІ РґР»СЏ РєР»Р°СЃС‚РµСЂР° i
                ai = array.get(km_centroids_atr, i)
                bi = array.get(km_centroids_rsi, i)
                ci = array.get(km_centroids_roc, i)
                di = array.get(km_centroids_slope, i)
                vi = array.get(km_centroids_volume, i)
                mi = array.get(km_centroids_macd, i)
                vri = array.get(km_centroids_volume_ratio, i)
                cpvi = array.get(km_centroids_corr_price_volume, i)
                cpmi = array.get(km_centroids_corr_price_macd, i)
                rsivi = array.get(km_centroids_rsi_volatility, i)
                enti = array.get(km_centroids_entropy, i)

                // РР·РІР»РµС‡РµРЅРёРµ С†РµРЅС‚СЂРѕРёРґРѕРІ РґР»СЏ РєР»Р°СЃС‚РµСЂР° j
                aj = array.get(km_centroids_atr, j)
                bj = array.get(km_centroids_rsi, j)
                cj = array.get(km_centroids_roc, j)
                dj = array.get(km_centroids_slope, j)
                vj = array.get(km_centroids_volume, j)
                mj = array.get(km_centroids_macd, j)
                vrj = array.get(km_centroids_volume_ratio, j)
                cpvj = array.get(km_centroids_corr_price_volume, j)
                cpmj = array.get(km_centroids_corr_price_macd, j)
                rsivj = array.get(km_centroids_rsi_volatility, j)
                entj = array.get(km_centroids_entropy, j)

                // Р’Р—Р’Р•РЁР•РќРќРћР• РµРІРєР»РёРґРѕРІРѕ СЂР°СЃСЃС‚РѕСЏРЅРёРµ
                d = math.sqrt(
                     w_atr * math.pow(ai - aj, 2) + 
                     w_rsi * math.pow(bi - bj, 2) + 
                     w_roc * math.pow(ci - cj, 2) + 
                     w_slope * math.pow(di - dj, 2) + 
                     w_volume * math.pow(vi - vj, 2) + 
                     w_macd * math.pow(mi - mj, 2) + 
                     w_vol_ratio * math.pow(vri - vrj, 2) + 
                     w_corr_pv * math.pow(cpvi - cpvj, 2) + 
                     w_corr_pm * math.pow(cpmi - cpmj, 2) + 
                     w_rsi_vol * math.pow(rsivi - rsivj, 2) + 
                     w_entropy * math.pow(enti - entj, 2)
                     )

                if d < min_distance
                    valid := false
    
    // РџСЂРѕРІРµСЂРєР° СЃРѕРІРїР°РґРµРЅРёСЏ РєР»Р°СЃС‚РµСЂРѕРІ
    if valid and km_trend_bull_cluster == km_trend_bear_cluster
        valid := false
    
    // РџСЂРѕРІРµСЂРєР° Р»РѕРіРёРєРё RSI (Р±С‹С‡РёР№ > РјРµРґРІРµР¶СЊРµРіРѕ)
    if valid and km_trend_bull_cluster >= 0 and km_trend_bull_cluster < array.size(km_centroids_rsi) and 
       km_trend_bear_cluster >= 0 and km_trend_bear_cluster < array.size(km_centroids_rsi) and 
       array.get(km_centroids_rsi, km_trend_bull_cluster) < array.get(km_centroids_rsi, km_trend_bear_cluster)
        valid := false
    
    // Р”РћРџРћР›РќРРўР•Р›Р¬РќРђРЇ РџР РћР’Р•Р РљРђ: ROC (Р±С‹С‡РёР№ РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ > РјРµРґРІРµР¶СЊРµРіРѕ)
    if valid and km_trend_bull_cluster >= 0 and km_trend_bull_cluster < array.size(km_centroids_roc) and
       km_trend_bear_cluster >= 0 and km_trend_bear_cluster < array.size(km_centroids_roc)
        bull_roc = array.get(km_centroids_roc, km_trend_bull_cluster)
        bear_roc = array.get(km_centroids_roc, km_trend_bear_cluster)
        if bull_roc <= bear_roc
            valid := false
    
    // Р”РћРџРћР›РќРРўР•Р›Р¬РќРђРЇ РџР РћР’Р•Р РљРђ: Slope (Р±С‹С‡РёР№ РЅР°РєР»РѕРЅ РєСЂСѓС‡Рµ РјРµРґРІРµР¶СЊРµРіРѕ)
    if valid and km_trend_bull_cluster >= 0 and km_trend_bull_cluster < array.size(km_centroids_slope) and
       km_trend_bear_cluster >= 0 and km_trend_bear_cluster < array.size(km_centroids_slope)
        bull_slope = array.get(km_centroids_slope, km_trend_bull_cluster)
        bear_slope = array.get(km_centroids_slope, km_trend_bear_cluster)
        if bull_slope <= bear_slope
            valid := false
    
    // Р”РћРџРћР›РќРРўР•Р›Р¬РќРђРЇ РџР РћР’Р•Р РљРђ: MACD (Р±С‹С‡РёР№ > РјРµРґРІРµР¶СЊРµРіРѕ)
    if valid and km_trend_bull_cluster >= 0 and km_trend_bull_cluster < array.size(km_centroids_macd) and
       km_trend_bear_cluster >= 0 and km_trend_bear_cluster < array.size(km_centroids_macd)
        bull_macd = array.get(km_centroids_macd, km_trend_bull_cluster)
        bear_macd = array.get(km_centroids_macd, km_trend_bear_cluster)
        if bull_macd <= bear_macd
            valid := false
    
    valid

// 5. Р¤СѓРЅРєС†РёСЏ РїСЂРѕРІРµСЂРєРё РєР°С‡РµСЃС‚РІР° РєР»Р°СЃС‚РµСЂРёР·Р°С†РёРё (РЈР›РЈР§РЁР•РќРќРђРЇ Р’Р•Р РЎРРЇ)
check_cluster_quality() =>
    // 1. РџСЂРѕРІРµСЂРєР° РЅР° РјРёРЅРёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ РґР°РЅРЅС‹С…
    if bar_index < min_bars_required or array.size(km_atr_history) < training_period / 2
        "INITIALIZING"
    else
        // 2. РџСЂРѕРІРµСЂРєР° РЅР° РїСѓСЃС‚С‹Рµ РєР»Р°СЃС‚РµСЂС‹
        empty_clusters = false
        for i = 0 to num_clusters - 1
            if array.get(cluster_sizes, i) == 0
                empty_clusters := true
                break
        
        // 3. РџСЂРѕРІРµСЂРєР° СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ
        consistent = check_cluster_consistency()
        
        // 4. РџСЂРѕРІРµСЂРєР° СЃС‚Р°Р±РёР»СЊРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ (РЅРѕРІС‹Р№ РєСЂРёС‚РµСЂРёР№)
        cluster_stable = true
        if array.size(cluster_norm_history) > 10
            recent_changes = 0
            for i = 0 to 9
                if array.get(cluster_norm_history, array.size(cluster_norm_history) - 1 - i) != 
                   array.get(cluster_norm_history, array.size(cluster_norm_history) - 2 - i)
                    recent_changes += 1
            cluster_stable := recent_changes < 3
        
        // 5. РћРїСЂРµРґРµР»РµРЅРёРµ РёС‚РѕРіРѕРІРѕРіРѕ СЃС‚Р°С‚СѓСЃР°
        if empty_clusters or not consistent
            "RECALIBRATING"
        else if not cluster_stable
            "UNSTABLE"
        else
            "STABLE"
//*********************************************************************************
// Р’С‹С‡РёСЃР»РµРЅРёРµ Р»РѕРіР°СЂРёС„РјР° РґР»СЏ Volume
km_log_volume = math.log10(math.max(km_safe_volume, 1)) // РСЃРїРѕР»СЊР·СѓРµРј log10, max РґР»СЏ РёР·Р±РµР¶Р°РЅРёСЏ log(0)
km_log_volume_mean = array.avg(km_volume_history) // РЎСЂРµРґРЅРµРµ РїРѕ Р»РѕРіР°СЂРёС„РјР°Рј
km_log_volume_std = array.size(km_volume_history) >= 2 ? array.stdev(km_volume_history) : 1.0
km_log_volume_std := km_log_volume_std > 0.0001 ? km_log_volume_std : 1.0
n_log_volume = safe_div(km_log_volume - km_log_volume_mean, km_log_volume_std, 0)
// РЎРґРІРёРі MACD РґР»СЏ РёР·Р±РµР¶Р°РЅРёСЏ РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹С… Р·РЅР°С‡РµРЅРёР№
km_shifted_macd = km_safe_macd + math.abs(array.min(km_macd_history)) + 1 // РЎРґРІРёРі РЅР° РјРёРЅРёРјСѓРј + 1
km_log_macd = math.log10(math.max(km_shifted_macd, 1)) // Р›РѕРіР°СЂРёС„Рј
km_log_macd_mean = array.avg(km_macd_history) // РЎСЂРµРґРЅРµРµ РїРѕ Р»РѕРіР°СЂРёС„РјР°Рј
km_log_macd_std = array.size(km_macd_history) >= 2 ? array.stdev(km_macd_history) : 1.0
km_log_macd_std := km_log_macd_std > 0.0001 ? km_log_macd_std : 1.0
n_log_macd = safe_div(km_log_macd - km_log_macd_mean, km_log_macd_std, 0)

// 8. РЈРџР РћР©Р•РќРќРћР• РћР‘РќРћР’Р›Р•РќРР• РЎРўРђРўРРЎРўРРљР Р‘Р•Р— РћР‘Р РђР‘РћРўРљР Р’Р«Р‘Р РћРЎРћР’
update_km_stats() =>
    if bar_index >= min_bars_required
        // РџСЂРѕСЃС‚РѕРµ РґРѕР±Р°РІР»РµРЅРёРµ РґР°РЅРЅС‹С… Р±РµР· РїСЂРѕРІРµСЂРєРё РІС‹Р±СЂРѕСЃРѕРІ (РґР»СЏ СѓСЃРєРѕСЂРµРЅРёСЏ РёРЅРёС†РёР°Р»РёР·Р°С†РёРё)
        array.push(km_atr_history, km_safe_smooth_vol)
        array.push(km_rsi_history, km_rsi_val)
        array.push(km_roc_history, km_roc_val)
        array.push(km_slope_history, km_safe_sma_slope)
        array.push(km_volume_history, km_safe_volume)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_macd_history, km_safe_macd)      // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_volume_ratio_history, km_safe_volume_ratio)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_corr_price_volume_history, km_safe_corr_price_volume)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_corr_price_macd_history, km_safe_corr_price_macd)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_rsi_volatility_history, km_safe_rsi_volatility)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.push(km_entropy_history, km_safe_entropy)  // NEW: Entropy as feature
        array.push(cluster_norm_history, na)  // Placeholder, Р°РєС‚СѓР°Р»СЊРЅС‹Р№ push РїРѕСЃР»Рµ РІС‹С‡РёСЃР»РµРЅРёСЏ РєР»Р°СЃС‚РµСЂР°
        array.push(confidence_history, na)
        array.push(time_history, bar_index)
        
        if array.size(km_atr_history) > max_history_size
            array.shift(km_atr_history)
            array.shift(km_rsi_history)
            array.shift(km_roc_history)
            array.shift(km_slope_history)
            array.shift(km_volume_history)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_macd_history)    // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_volume_ratio_history)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_corr_price_volume_history)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_corr_price_macd_history)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_rsi_volatility_history)  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
            array.shift(km_entropy_history)  // NEW: Entropy as feature
            array.shift(time_history)
            array.shift(confidence_history)
            array.shift(cluster_norm_history)

// 9. РЈРџР РћР©Р•РќРќР«Р™ Р РђРЎР§Р•Рў РЎРўРђРўРРЎРўРРљР РЎ Р—РђР©РРўРћР™ РћРў РћРЁРР‘РћРљ
compute_km_stats() =>
    float[] stats = array.new_float(22, 0.0)
    int size = array.size(km_atr_history)
    
    if size >= 2
        // Р РµР°Р»СЊРЅС‹Рµ РІС‹С‡РёСЃР»РµРЅРёСЏ СЃС‚Р°С‚РёСЃС‚РёРєРё
        calc_atr_std = array.stdev(km_atr_history)
        calc_rsi_std = array.stdev(km_rsi_history)
        calc_roc_std = array.stdev(km_roc_history)
        calc_slope_std = array.stdev(km_slope_history)
        calc_volume_std = array.stdev(km_volume_history)
        calc_macd_std = array.stdev(km_macd_history)
        calc_volume_ratio_std = array.stdev(km_volume_ratio_history)
        calc_corr_price_volume_std = array.stdev(km_corr_price_volume_history)
        calc_corr_price_macd_std = array.stdev(km_corr_price_macd_history)
        calc_rsi_volatility_std = array.stdev(km_rsi_volatility_history)
        calc_entropy_std = array.stdev(km_entropy_history)  // NEW: Entropy as feature

        // Р—Р°С‰РёС‚Р° РѕС‚ РґРµР»РµРЅРёСЏ РЅР° РЅРѕР»СЊ
        calc_atr_std := calc_atr_std > 0.0001 ? calc_atr_std : 1.0
        calc_rsi_std := calc_rsi_std > 0.0001 ? calc_rsi_std : 1.0
        calc_roc_std := calc_roc_std > 0.0001 ? calc_roc_std : 1.0
        calc_slope_std := calc_slope_std > 0.0001 ? calc_slope_std : 1.0
        calc_volume_std := calc_volume_std > 0.0001 ? calc_volume_std : 1.0
        calc_macd_std := calc_macd_std > 0.0001 ? calc_macd_std : 1.0
        calc_volume_ratio_std := calc_volume_ratio_std > 0.0001 ? calc_volume_ratio_std : 1.0
        calc_corr_price_volume_std := calc_corr_price_volume_std > 0.0001 ? calc_corr_price_volume_std : 1.0
        calc_corr_price_macd_std := calc_corr_price_macd_std > 0.0001 ? calc_corr_price_macd_std : 1.0
        calc_rsi_volatility_std := calc_rsi_volatility_std > 0.0001 ? calc_rsi_volatility_std : 1.0
        calc_entropy_std := calc_entropy_std > 0.0001 ? calc_entropy_std : 1.0  

        // Р—Р°РїРѕР»РЅРµРЅРёРµ СЃС‚Р°С‚РёСЃС‚РёРєРё СЂРµР°Р»СЊРЅС‹РјРё Р·РЅР°С‡РµРЅРёСЏРјРё
        array.set(stats, 0, array.avg(km_atr_history))
        array.set(stats, 1, calc_atr_std)
        array.set(stats, 2, array.avg(km_rsi_history))
        array.set(stats, 3, calc_rsi_std)
        array.set(stats, 4, array.avg(km_roc_history))
        array.set(stats, 5, calc_roc_std)
        array.set(stats, 6, array.avg(km_slope_history))
        array.set(stats, 7, calc_slope_std)
        array.set(stats, 8, array.avg(km_volume_history))
        array.set(stats, 9, calc_volume_std)
        array.set(stats, 10, array.avg(km_macd_history))
        array.set(stats, 11, calc_macd_std)
        array.set(stats, 12, array.avg(km_volume_ratio_history))
        array.set(stats, 13, calc_volume_ratio_std)
        array.set(stats, 14, array.avg(km_corr_price_volume_history))
        array.set(stats, 15, calc_corr_price_volume_std)
        array.set(stats, 16, array.avg(km_corr_price_macd_history))
        array.set(stats, 17, calc_corr_price_macd_std)
        array.set(stats, 18, array.avg(km_rsi_volatility_history))
        array.set(stats, 19, calc_rsi_volatility_std)
        array.set(stats, 20, array.avg(km_entropy_history))  // NEW: Entropy as feature
        array.set(stats, 21, calc_entropy_std)  // NEW: Entropy as feature
    else
        // РСЃРїРѕР»СЊР·СѓРµРј С‚РµРєСѓС‰РёРµ Р·РЅР°С‡РµРЅРёСЏ, РµСЃР»Рё РёСЃС‚РѕСЂРёСЏ РЅРµРґРѕСЃС‚Р°С‚РѕС‡РЅР°
        array.set(stats, 0, km_safe_smooth_vol)
        array.set(stats, 1, ta.stdev(km_safe_smooth_vol, 10))
        array.set(stats, 2, km_rsi_val)
        array.set(stats, 3, ta.stdev(km_rsi_val, 10))
        array.set(stats, 4, km_roc_val)
        array.set(stats, 5, ta.stdev(km_roc_val, 10))
        array.set(stats, 6, km_safe_sma_slope)
        array.set(stats, 7, ta.stdev(km_safe_sma_slope, 10))
        array.set(stats, 8, km_safe_volume)
        array.set(stats, 9, ta.stdev(km_safe_volume, 10))
        array.set(stats, 10, km_safe_macd)
        array.set(stats, 11, ta.stdev(km_safe_macd, 10))
        array.set(stats, 12, km_safe_volume_ratio)
        array.set(stats, 13, ta.stdev(km_safe_volume_ratio, 10))
        array.set(stats, 14, km_safe_corr_price_volume)
        array.set(stats, 15, ta.stdev(km_safe_corr_price_volume, 10))
        array.set(stats, 16, km_safe_corr_price_macd)
        array.set(stats, 17, ta.stdev(km_safe_corr_price_macd, 10))
        array.set(stats, 18, km_safe_rsi_volatility)
        array.set(stats, 19, ta.stdev(km_safe_rsi_volatility, 10))
        array.set(stats, 20, km_safe_entropy)  // NEW: Entropy as feature
        array.set(stats, 21, ta.stdev(km_safe_entropy, 10))  // NEW: Entropy as feature
    stats
// 7. РРЅС‚РµРіСЂР°С†РёСЏ С„СѓРЅРєС†РёРё РѕР±РЅРѕРІР»РµРЅРёСЏ РІРµСЃРѕРІ РІ РѕСЃРЅРѕРІРЅРѕР№ Р°Р»РіРѕСЂРёС‚Рј
if barstate.islast or barstate.isconfirmed
// РџСЂРѕРІРµСЂСЏРµРј РєР°С‡РµСЃС‚РІРѕ РєР°Р¶РґС‹Рµ 20 Р±Р°СЂРѕРІ РёР»Рё РїСЂРё СЃРјРµРЅРµ РєР»Р°СЃС‚РµСЂР°
    if bar_index - last_quality_check >= 20 or cluster_changed
        current_quality_status := check_cluster_quality()
        last_quality_check := bar_index
   // РћР±РЅРѕРІР»СЏРµРј РёСЃС‚РѕСЂРёСЋ РґР°РЅРЅС‹С…
    update_km_stats()
    
    // Р’С‹С‡РёСЃР»СЏРµРј СЃС‚Р°С‚РёСЃС‚РёРєСѓ
    stats = compute_km_stats()
    
    // РћР±РЅРѕРІР»СЏРµРј РіР»РѕР±Р°Р»СЊРЅС‹Рµ РїРµСЂРµРјРµРЅРЅС‹Рµ СЃС‚Р°С‚РёСЃС‚РёРєРё
    km_atr_mean := array.get(stats, 0)
    km_atr_std := array.get(stats, 1)
    km_rsi_mean := array.get(stats, 2)
    km_rsi_std := array.get(stats, 3)
    km_roc_mean := array.get(stats, 4)
    km_roc_std := array.get(stats, 5)
    km_slope_mean := array.get(stats, 6)
    km_slope_std := array.get(stats, 7)
    km_volume_mean := array.get(stats, 8)
    km_volume_std := array.get(stats, 9)
    km_macd_mean := array.get(stats, 10)
    km_macd_std := array.get(stats, 11)
    km_volume_ratio_mean := array.get(stats, 12)
    km_volume_ratio_std := array.get(stats, 13)
    km_corr_price_volume_mean := array.get(stats, 14)
    km_corr_price_volume_std := array.get(stats, 15)
    km_corr_price_macd_mean := array.get(stats, 16)
    km_corr_price_macd_std := array.get(stats, 17)
    km_rsi_volatility_mean := array.get(stats, 18)
    km_rsi_volatility_std := array.get(stats, 19)
    km_entropy_mean := array.get(stats, 20)
    km_entropy_std := array.get(stats, 21)
    
    // РћР±РЅРѕРІР»СЏРµРј РІРµСЃР° РїСЂРёР·РЅР°РєРѕРІ
    if array.size(km_atr_history) > 10
        update_feature_weights()
adaptive_hysteresis = hysteresis_threshold * (1.0 + 0.3 * (km_entropy / km_entropy_mean))

// Р’С‹С‡РёСЃР»РµРЅРёРµ СЌРЅРµСЂРіРёРё С†РёРєР»Р° (trend strength)
calculate_cycle_energy(centroid_rsi, centroid_roc, centroid_slope, centroid_atr, centroid_volume, stats_volume_mean) =>
    float energy = 0.0
    
    // RSI РІРєР»Р°Рґ (РѕС‚РєР»РѕРЅРµРЅРёРµ РѕС‚ 50)
    rsi_contribution = math.abs(centroid_rsi - 50) / 50.0  // 0-1
    energy += rsi_contribution * 0.3
    
    // ROC РІРєР»Р°Рґ (Р°Р±СЃРѕР»СЋС‚РЅРѕРµ РёР·РјРµРЅРµРЅРёРµ)
    roc_contribution = math.min(math.abs(centroid_roc) / 2.0, 1.0)  // РЅРѕСЂРјР°Р»РёР·Р°С†РёСЏ Рє 0-1
    energy += roc_contribution * 0.3
    
    // Slope РІРєР»Р°Рґ
    slope_contribution = math.min(math.abs(centroid_slope) / 1.0, 1.0)
    energy += slope_contribution * 0.2
    
    // ATR РІРєР»Р°Рґ (РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ)
    atr_contribution = math.min(centroid_atr / 1.0, 1.0)
    energy += atr_contribution * 0.1
    
    // Volume РІРєР»Р°Рґ
    volume_contribution = math.min(centroid_volume / (stats_volume_mean * 1.5), 1.0)
    energy += volume_contribution * 0.1
    
    energy  // 0-1, РіРґРµ 1 = РјР°РєСЃРёРјР°Р»СЊРЅР°СЏ СЌРЅРµСЂРіРёСЏ С†РёРєР»Р°

// 10. РќР°Р·РЅР°С‡РµРЅРёРµ С‚РёРїРѕРІ РєР»Р°СЃС‚РµСЂРѕРІ (РџРћР›РќРђРЇ РЈР›РЈР§РЁР•РќРќРђРЇ Р’Р•Р РЎРРЇ)
assign_cluster_types(stats) =>
    stats_atr_mean = array.get(stats, 0)
    stats_atr_std = array.get(stats, 1)
    stats_rsi_mean = array.get(stats, 2)
    stats_rsi_std = array.get(stats, 3)
    stats_roc_mean = array.get(stats, 4)
    stats_roc_std = array.get(stats, 5)
    stats_slope_mean = array.get(stats, 6)
    stats_slope_std = array.get(stats, 7)
    stats_volume_mean = array.get(stats, 8)
    stats_volume_std = array.get(stats, 9)
    stats_macd_mean = array.get(stats, 10)
    stats_macd_std = array.get(stats, 11)
    stats_volume_ratio_mean = array.get(stats, 12)
    stats_volume_ratio_std = array.get(stats, 13)
    stats_corr_price_volume_mean = array.get(stats, 14)
    stats_corr_price_volume_std = array.get(stats, 15)
    stats_corr_price_macd_mean = array.get(stats, 16)
    stats_corr_price_macd_std = array.get(stats, 17)
    stats_rsi_volatility_mean = array.get(stats, 18)
    stats_rsi_volatility_std = array.get(stats, 19)
    stats_entropy_mean = array.get(stats, 20)
    stats_entropy_std = array.get(stats, 21)
    
    array<float> denorm_atr = array.new<float>()
    array<float> denorm_rsi = array.new<float>()
    array<float> denorm_roc = array.new<float>()
    array<float> denorm_slope = array.new<float>()
    array<float> denorm_volume = array.new<float>()
    array<float> denorm_macd = array.new<float>()
    array<float> denorm_volume_ratio = array.new_float(0)
    array<float> denorm_corr_price_volume = array.new_float(0)
    array<float> denorm_corr_price_macd = array.new_float(0)
    array<float> denorm_rsi_volatility = array.new_float(0)
    array<float> denorm_entropy = array.new_float(0)

    // Р›РѕРіР°СЂРёС„РјРёС‡РµСЃРєРѕРµ РїСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ
    km_log_volume = math.log10(math.max(km_safe_volume, 1))
    km_shifted_macd = km_safe_macd + math.abs(array.min(km_macd_history)) + 1
    km_log_macd = math.log10(math.max(km_shifted_macd, 1))
    km_log_volume_ratio = math.log10(math.max(km_safe_volume_ratio, 1))
    km_shifted_corr_price_volume = km_safe_corr_price_volume + 1
    km_log_corr_price_volume = math.log10(math.max(km_shifted_corr_price_volume, 1))
    km_shifted_corr_price_macd = km_safe_corr_price_macd + 1
    km_log_corr_price_macd = math.log10(math.max(km_shifted_corr_price_macd, 1))
    km_log_rsi_volatility = math.log10(math.max(km_safe_rsi_volatility, 1))
    km_log_entropy = math.log10(math.max(km_safe_entropy, 1))

    // Р”РµРЅРѕСЂРјР°Р»РёР·Р°С†РёСЏ С†РµРЅС‚СЂРѕРёРґРѕРІ
    for i = 0 to num_clusters - 1
        array.push(denorm_atr, array.get(km_centroids_atr, i) * stats_atr_std + stats_atr_mean)
        array.push(denorm_rsi, array.get(km_centroids_rsi, i) * stats_rsi_std + stats_rsi_mean)
        array.push(denorm_roc, array.get(km_centroids_roc, i) * stats_roc_std + stats_roc_mean)
        array.push(denorm_slope, array.get(km_centroids_slope, i) * stats_slope_std + stats_slope_mean)
        array.push(denorm_volume, array.get(km_centroids_volume, i) * stats_volume_std + stats_volume_mean)
        array.push(denorm_macd, array.get(km_centroids_macd, i) * stats_macd_std + stats_macd_mean)
        array.push(denorm_volume_ratio, array.get(km_centroids_volume_ratio, i) * stats_volume_ratio_std + stats_volume_ratio_mean)
        array.push(denorm_corr_price_volume, array.get(km_centroids_corr_price_volume, i) * stats_corr_price_volume_std + stats_corr_price_volume_mean)
        array.push(denorm_corr_price_macd, array.get(km_centroids_corr_price_macd, i) * stats_corr_price_macd_std + stats_corr_price_macd_mean)
        array.push(denorm_rsi_volatility, array.get(km_centroids_rsi_volatility, i) * stats_rsi_volatility_std + stats_rsi_volatility_mean)
        array.push(denorm_entropy, array.get(km_centroids_entropy, i) * stats_entropy_std + stats_entropy_mean)
    
    array<float> bull_scores = array.new<float>(num_clusters, 0)
    array<float> bear_scores = array.new<float>(num_clusters, 0)
    array<float> flat_scores = array.new<float>(num_clusters, 0)

    // ====== РћР¦Р•РќРљРђ РљР›РђРЎРўР•Р РћР’ ======
    for i = 0 to num_clusters - 1
        centroid_atr = array.get(denorm_atr, i)
        centroid_rsi = array.get(denorm_rsi, i)
        centroid_roc = array.get(denorm_roc, i)
        centroid_slope = array.get(denorm_slope, i)
        centroid_volume = array.get(denorm_volume, i)
        centroid_macd = array.get(denorm_macd, i)
        centroid_volume_ratio = array.get(denorm_volume_ratio, i)
        centroid_corr_price_volume = array.get(denorm_corr_price_volume, i)
        centroid_corr_price_macd = array.get(denorm_corr_price_macd, i)
        centroid_rsi_volatility = array.get(denorm_rsi_volatility, i)
        centroid_entropy = array.get(denorm_entropy, i)
        
        // ====== Р‘Р«Р§РР™ РљР›РђРЎРўР•Р  (СЃС‚СЂРѕРіРёРµ РїРѕСЂРѕРіРё) ======
        bull_score = 0
        
        // RSI: РјРЅРѕРіРѕСѓСЂРѕРІРЅРµРІР°СЏ РѕС†РµРЅРєР° (РІРµСЃ x3)
        if centroid_rsi > 65
            bull_score += 5  // РћС‡РµРЅСЊ Р±С‹С‡РёР№
        else if centroid_rsi > 58
            bull_score += 3  // РЈРјРµСЂРµРЅРЅРѕ Р±С‹С‡РёР№
        else if centroid_rsi > 52
            bull_score += 1  // РЎР»Р°Р±Рѕ Р±С‹С‡РёР№
        
        // ROC: РїСЂРёСЂРѕСЃС‚ С†РµРЅС‹ (РІРµСЃ x3)
        if centroid_roc > 1.0
            bull_score += 4
        else if centroid_roc > 0.5
            bull_score += 3
        else if centroid_roc > 0
            bull_score += 1
        
        // Slope: РЅР°РїСЂР°РІР»РµРЅРёРµ С‚СЂРµРЅРґР° (РІРµСЃ x2)
        if centroid_slope > 0.5
            bull_score += 4
        else if centroid_slope > 0.3
            bull_score += 3
        else if centroid_slope > 0
            bull_score += 1
        
        // MACD: РґРёРІРµСЂРіРµРЅС†РёСЏ (РІРµСЃ x2)
        if centroid_macd > stats_macd_std * 0.5
            bull_score += 3
        else if centroid_macd > 0
            bull_score += 2
        
        // ATR: РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ
        if centroid_atr > 0.5
            bull_score += 2
        
        // Volume: Р°РєС‚РёРІРЅРѕСЃС‚СЊ
        if centroid_volume > stats_volume_mean * 1.2
            bull_score += 3
        else if centroid_volume > stats_volume_mean
            bull_score += 1
        
        // Volume Ratio
        if centroid_volume_ratio > stats_volume_ratio_mean * 1.1
            bull_score += 2
        
        // РљРѕСЂСЂРµР»СЏС†РёСЏ price-volume: РїРѕР»РѕР¶РёС‚РµР»СЊРЅР°СЏ РґР»СЏ СЂРѕСЃС‚Р°
        if centroid_corr_price_volume > 0.4
            bull_score += 2
        else if centroid_corr_price_volume > 0.2
            bull_score += 1
        
        // РљРѕСЂСЂРµР»СЏС†РёСЏ price-MACD: СЃРёР»СЊРЅР°СЏ РїРѕР»РѕР¶РёС‚РµР»СЊРЅР°СЏ
        if centroid_corr_price_macd > 0.4
            bull_score += 2
        else if centroid_corr_price_macd > 0.2
            bull_score += 1
        
        // RSI Volatility: СЃСЂРµРґРЅСЏСЏ Р°РєС‚РёРІРЅРѕСЃС‚СЊ
        if centroid_rsi_volatility > stats_rsi_volatility_mean * 1.1
            bull_score += 2
        
        // Entropy: РІС‹СЃРѕРєР°СЏ РґР»СЏ С‚СЂРµРЅРґРѕРІ
        if centroid_entropy > stats_entropy_mean + stats_entropy_std * 0.5
            bull_score += 2
        
        // РљРћРњР‘РРќРР РћР’РђРќРќР«Р• Р‘РћРќРЈРЎР« (СЃРёРЅРµСЂРіРёСЏ РїСЂРёР·РЅР°РєРѕРІ)
        if centroid_rsi > 60 and centroid_roc > 0.5 and centroid_slope > 0.3
            bull_score += 5  // Р’СЃРµ С‚СЂРё РєР»СЋС‡РµРІС‹С… РёРЅРґРёРєР°С‚РѕСЂР° РїРѕРґС‚РІРµСЂР¶РґР°СЋС‚ Р±С‹С‡РёР№ С‚СЂРµРЅРґ
        
        if centroid_volume > stats_volume_mean * 1.2 and centroid_corr_price_volume > 0.4
            bull_score += 3  // Р’С‹СЃРѕРєРёР№ РѕР±СЉС‘Рј СЃ РїРѕР»РѕР¶РёС‚РµР»СЊРЅРѕР№ РєРѕСЂСЂРµР»СЏС†РёРµР№
        
        if centroid_macd > 0 and centroid_corr_price_macd > 0.4
            bull_score += 2  // MACD Рё РєРѕСЂСЂРµР»СЏС†РёСЏ СЃРѕРіР»Р°СЃРѕРІР°РЅС‹
        
        // РЁРўР РђР¤Р« Р·Р° РїСЂРёР·РЅР°РєРё С„Р»СЌС‚Р°
        if math.abs(centroid_rsi - 50) < 8
            bull_score -= 2
        if math.abs(centroid_roc) < 0.5
            bull_score -= 2
        if math.abs(centroid_slope) < 0.3
            bull_score -= 2
        if centroid_atr < 0.3
            bull_score -= 1
        
        bull_score := math.max(bull_score, 0)
        
        // ====== РњР•Р”Р’Р•Р–РР™ РљР›РђРЎРўР•Р  (Р·РµСЂРєР°Р»СЊРЅР°СЏ Р»РѕРіРёРєР°) ======
        bear_score = 0
        
        // RSI: РјРЅРѕРіРѕСѓСЂРѕРІРЅРµРІР°СЏ РѕС†РµРЅРєР°
        if centroid_rsi < 35
            bear_score += 5
        else if centroid_rsi < 42
            bear_score += 3
        else if centroid_rsi < 48
            bear_score += 1
        
        // ROC: РїР°РґРµРЅРёРµ С†РµРЅС‹
        if centroid_roc < -1.0
            bear_score += 4
        else if centroid_roc < -0.5
            bear_score += 3
        else if centroid_roc < 0
            bear_score += 1
        
        // Slope: РЅРёСЃС…РѕРґСЏС‰РёР№ С‚СЂРµРЅРґ
        if centroid_slope < -0.5
            bear_score += 4
        else if centroid_slope < -0.3
            bear_score += 3
        else if centroid_slope < 0
            bear_score += 1
        
        // MACD: РѕС‚СЂРёС†Р°С‚РµР»СЊРЅР°СЏ РґРёРІРµСЂРіРµРЅС†РёСЏ
        if centroid_macd < -stats_macd_std * 0.5
            bear_score += 3
        else if centroid_macd < 0
            bear_score += 2
        
        // ATR: РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ
        if centroid_atr > 0.5
            bear_score += 2
        
        // Volume: Р°РєС‚РёРІРЅРѕСЃС‚СЊ
        if centroid_volume > stats_volume_mean * 1.2
            bear_score += 3
        else if centroid_volume > stats_volume_mean
            bear_score += 1
        
        // Volume Ratio
        if centroid_volume_ratio > stats_volume_ratio_mean * 1.1
            bear_score += 2
        
        // РљРѕСЂСЂРµР»СЏС†РёСЏ price-volume: РѕС‚СЂРёС†Р°С‚РµР»СЊРЅР°СЏ РґР»СЏ РїР°РґРµРЅРёСЏ
        if centroid_corr_price_volume < -0.4
            bear_score += 2
        else if centroid_corr_price_volume < -0.2
            bear_score += 1
        
        // РљРѕСЂСЂРµР»СЏС†РёСЏ price-MACD: СЃРёР»СЊРЅР°СЏ РѕС‚СЂРёС†Р°С‚РµР»СЊРЅР°СЏ
        if centroid_corr_price_macd < -0.4
            bear_score += 2
        else if centroid_corr_price_macd < -0.2
            bear_score += 1
        
        // RSI Volatility
        if centroid_rsi_volatility > stats_rsi_volatility_mean * 1.1
            bear_score += 2
        
        // Entropy: РІС‹СЃРѕРєР°СЏ РґР»СЏ С‚СЂРµРЅРґРѕРІ
        if centroid_entropy > stats_entropy_mean + stats_entropy_std * 0.5
            bear_score += 2
        
        // РљРћРњР‘РРќРР РћР’РђРќРќР«Р• Р‘РћРќРЈРЎР«
        if centroid_rsi < 40 and centroid_roc < -0.5 and centroid_slope < -0.3
            bear_score += 5  // Р’СЃРµ С‚СЂРё РїРѕРґС‚РІРµСЂР¶РґР°СЋС‚ РјРµРґРІРµР¶РёР№
        
        if centroid_volume > stats_volume_mean * 1.2 and centroid_corr_price_volume < -0.4
            bear_score += 3  // Р’С‹СЃРѕРєРёР№ РѕР±СЉС‘Рј СЃ РѕС‚СЂРёС†Р°С‚РµР»СЊРЅРѕР№ РєРѕСЂСЂРµР»СЏС†РёРµР№
        
        if centroid_macd < 0 and centroid_corr_price_macd < -0.4
            bear_score += 2  // MACD Рё РєРѕСЂСЂРµР»СЏС†РёСЏ СЃРѕРіР»Р°СЃРѕРІР°РЅС‹
        
        // РЁРўР РђР¤Р« Р·Р° РїСЂРёР·РЅР°РєРё С„Р»СЌС‚Р°
        if math.abs(centroid_rsi - 50) < 8
            bear_score -= 2
        if math.abs(centroid_roc) < 0.5
            bear_score -= 2
        if math.abs(centroid_slope) < 0.3
            bear_score -= 2
        if centroid_atr < 0.3
            bear_score -= 1
        
        bear_score := math.max(bear_score, 0)
        
        // ====== Р¤Р›Р­Рў (РЎРўР РћР“РР• РљР РРўР•Р РР) ======
        flat_score = 0
        
        // RSI: Р±Р»РёР·РєРѕ Рє 50 (РІРµСЃ x5)
        if math.abs(centroid_rsi - 50) < 5
            flat_score += 5
        else if math.abs(centroid_rsi - 50) < 8
            flat_score += 3
        
        // ROC: РјРёРЅРёРјР°Р»СЊРЅРѕРµ РёР·РјРµРЅРµРЅРёРµ (РІРµСЃ x5)
        if math.abs(centroid_roc) < 0.3
            flat_score += 5
        else if math.abs(centroid_roc) < 0.7
            flat_score += 3
        
        // Slope: РіРѕСЂРёР·РѕРЅС‚Р°Р»СЊРЅС‹Р№ (РІРµСЃ x5)
        if math.abs(centroid_slope) < 0.2
            flat_score += 5
        else if math.abs(centroid_slope) < 0.4
            flat_score += 3
        
        // MACD: СЃР»Р°Р±С‹Р№ СЃРёРіРЅР°Р» (РІРµСЃ x4)
        if math.abs(centroid_macd) < stats_macd_std * 0.3
            flat_score += 4
        else if math.abs(centroid_macd) < stats_macd_std * 0.5
            flat_score += 2
        
        // ATR: РЅРёР·РєР°СЏ РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ (РІРµСЃ x4)
        if centroid_atr < 0.25
            flat_score += 4
        else if centroid_atr < 0.4
            flat_score += 2
        
        // Volume: РЅРёР¶Рµ СЃСЂРµРґРЅРµРіРѕ
        if centroid_volume < stats_volume_mean * 0.9
            flat_score += 3
        
        // Volume Ratio: РЅРёР·РєРёР№
        if centroid_volume_ratio < stats_volume_ratio_mean * 0.9
            flat_score += 2
        
        // РљРѕСЂСЂРµР»СЏС†РёРё: СЃР»Р°Р±С‹Рµ
        if math.abs(centroid_corr_price_volume) < 0.2
            flat_score += 3
        
        if math.abs(centroid_corr_price_macd) < 0.2
            flat_score += 3
        
        // RSI Volatility: РЅРёР·РєР°СЏ
        if centroid_rsi_volatility < stats_rsi_volatility_mean * 0.8
            flat_score += 3
        
        // Entropy: РЅРёР·РєР°СЏ С…Р°РѕС‚РёС‡РЅРѕСЃС‚СЊ
        if centroid_entropy < stats_entropy_mean - stats_entropy_std * 0.3
            flat_score += 3
        else if centroid_entropy < stats_entropy_mean
            flat_score += 1
        
        // РљРћРњР‘РРќРР РћР’РђРќРќР«Р• Р‘РћРќРЈРЎР«
        if math.abs(centroid_rsi - 50) < 5 and math.abs(centroid_roc) < 0.3 and math.abs(centroid_slope) < 0.2
            flat_score += 5  // Р’СЃРµ С‚СЂРё РєР»СЋС‡РµРІС‹С… РїСЂРёР·РЅР°РєР° РІ РЅРµР№С‚СЂР°Р»СЊРЅРѕР№ Р·РѕРЅРµ
        
        if centroid_atr < 0.3 and centroid_volume < stats_volume_mean * 0.9
            flat_score += 3  // РќРёР·РєР°СЏ РІРѕР»Р°С‚РёР»СЊРЅРѕСЃС‚СЊ + РЅРёР·РєРёР№ РѕР±СЉС‘Рј
        
        if math.abs(centroid_corr_price_volume) < 0.2 and math.abs(centroid_corr_price_macd) < 0.2
            flat_score += 2  // РћР±Рµ РєРѕСЂСЂРµР»СЏС†РёРё СЃР»Р°Р±С‹Рµ
        
        // РЁРўР РђР¤Р« Р·Р° С‚СЂРµРЅРґРѕРІС‹Рµ РїСЂРёР·РЅР°РєРё
        if centroid_rsi > 60 or centroid_rsi < 40
            flat_score -= 3
        if math.abs(centroid_roc) > 0.7
            flat_score -= 3
        if math.abs(centroid_slope) > 0.4
            flat_score -= 3
        if centroid_atr > 0.5
            flat_score -= 2
        if math.abs(centroid_macd) > stats_macd_std * 0.5
            flat_score -= 2
        
        flat_score := math.max(flat_score, 0)
        
        // РќРћР РњРђР›РР—РђР¦РРЇ: РїСЂРёРІРѕРґРёРј Рє С€РєР°Р»Рµ 0-100
        max_possible_bull = 35.0
        max_possible_bear = 35.0
        max_possible_flat = 40.0
        
        normalized_bull = (bull_score / max_possible_bull) * 100
        normalized_bear = (bear_score / max_possible_bear) * 100
        normalized_flat = (flat_score / max_possible_flat) * 100
        
        array.set(bull_scores, i, normalized_bull)
        array.set(bear_scores, i, normalized_bear)
        array.set(flat_scores, i, normalized_flat)

    // РћРїСЂРµРґРµР»РµРЅРёРµ РєР°РЅРґРёРґР°С‚РѕРІ
    bull_candidate = array.indexof(bull_scores, array.max(bull_scores))
    bear_candidate = array.indexof(bear_scores, array.max(bear_scores))
    flat_candidate = array.indexof(flat_scores, array.max(flat_scores))
    
    float current_bull_score = array.get(bull_scores, bull_candidate)
    float current_bear_score = array.get(bear_scores, bear_candidate)
    float current_flat_score = array.get(flat_scores, flat_candidate)
    
    // РџР РћР’Р•Р РљРђ РЈР’Р•Р Р•РќРќРћРЎРўР
    sorted_scores = array.new_float(0)
    array.push(sorted_scores, current_bull_score)
    array.push(sorted_scores, current_bear_score)
    array.push(sorted_scores, current_flat_score)
    array.sort(sorted_scores, order.descending)
    
    best_score = array.get(sorted_scores, 0)
    second_best = array.get(sorted_scores, 1)
    confidence = best_score - second_best
    
    // РџСЂРѕРІРµСЂРєР° СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё
    if check_cluster_consistency()
        km_trend_bull_cluster = bull_candidate
        km_trend_bear_cluster = bear_candidate
        km_flat_cluster = flat_candidate
    else
        calibration = auto_calibrate_clusters()
        km_trend_bull_cluster = array.get(calibration, 0)
        km_trend_bear_cluster = array.get(calibration, 1)
        km_flat_cluster = array.get(calibration, 2)
    
    // РљР°Р»РёР±СЂРѕРІРєР° РїСЂРё РЅРёР·РєРѕР№ СѓРІРµСЂРµРЅРЅРѕСЃС‚Рё РёР»Рё РЅРёР·РєРёС… РѕС†РµРЅРєР°С…
    if confidence < 15 or current_bull_score < 25 or current_bear_score < 25 or current_flat_score < 25
        calibration = auto_calibrate_clusters()
        bull_candidate := array.get(calibration, 0)
        bear_candidate := array.get(calibration, 1)
        flat_candidate := array.get(calibration, 2)
        current_bull_score := 50
        current_bear_score := 50
        current_flat_score := 50

    // Р¤РѕСЂРјРёСЂРѕРІР°РЅРёРµ СЂРµР·СѓР»СЊС‚Р°С‚Р°
    result = array.new_float(0)
    array.push(result, float(bull_candidate))
    array.push(result, float(bear_candidate))
    array.push(result, float(flat_candidate))
    array.push(result, current_bull_score)
    array.push(result, current_bear_score)
    array.push(result, current_flat_score)
    result

   
// === РљР›РђРЎРЎРР§Р•РЎРљРђРЇ Р Р•РђР›РР—РђР¦РРЇ K-MEANS++ ===*******************************************************************************************8
var int initialization_stage = 0
var string status_message = "РћР¶РёРґР°РЅРёРµ РґР°РЅРЅС‹С…..."

// РћР±СЉСЏРІР»СЏРµРј РјР°СЃСЃРёРІС‹ РґР»СЏ РЅРѕСЂРјР°Р»РёР·РѕРІР°РЅРЅС‹С… РґР°РЅРЅС‹С… РЅР° РіР»РѕР±Р°Р»СЊРЅРѕРј СѓСЂРѕРІРЅРµ
var array<float> normalized_atr = array.new<float>()
var array<float> normalized_rsi = array.new<float>()
var array<float> normalized_roc = array.new<float>()
var array<float> normalized_slope = array.new<float>()
var array<float> normalized_volume = array.new<float>(0)
var array<float> normalized_macd = array.new<float>(0)
var array<float> normalized_volume_ratio = array.new<float>()
var array<float> normalized_corr_price_volume = array.new<float>()
var array<float> normalized_corr_price_macd = array.new<float>(0)
var array<float> normalized_rsi_volatility = array.new<float>(0)
var array<float> normalized_entropy = array.new<float>(0)  // NEW: Entropy as feature

var float stable_forecast = na

var float math = 0.0
if array.size(km_atr_history) < training_period
    status_message := "РЎР±РѕСЂ РґР°РЅРЅС‹С…..."
    
// DTW distance function for two sequences using a single array
dtw_distance(float[] a, float[] b) =>
    int m = array.size(a)
    int n = array.size(b)
    if m == 0 or n == 0
        0.0
    else
        // РЎРѕР·РґР°РµРј РѕРґРЅРѕРјРµСЂРЅС‹Р№ РјР°СЃСЃРёРІ РґР»СЏ С…СЂР°РЅРµРЅРёСЏ РјР°С‚СЂРёС†С‹ DTW СЂР°Р·РјРµСЂРѕРј (m+1)*(n+1)
        var float[] dtw_matrix = array.new_float((m + 1) * (n + 1), 1e10)
        // РЈСЃС‚Р°РЅР°РІР»РёРІР°РµРј РЅР°С‡Р°Р»СЊРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ dtw_matrix[0][0] = 0
        array.set(dtw_matrix, 0, 0.0)
        // Р—Р°РїРѕР»РЅСЏРµРј РїРµСЂРІСѓСЋ СЃС‚СЂРѕРєСѓ Рё СЃС‚РѕР»Р±РµС† Р±РµСЃРєРѕРЅРµС‡РЅРѕСЃС‚СЏРјРё
        for i = 1 to m
            array.set(dtw_matrix, i * (n + 1), 1e10)
        for j = 1 to n
            array.set(dtw_matrix, j, 1e10)
        // Р—Р°РїРѕР»РЅСЏРµРј РјР°С‚СЂРёС†Сѓ DTW
        for i = 1 to m
            for j = 1 to n
                float cost = math.abs(array.get(a, i - 1) - array.get(b, j - 1))
                float min_prev = math.min(array.get(dtw_matrix, (i - 1) * (n + 1) + j), array.get(dtw_matrix, i * (n + 1) + (j - 1)), array.get(dtw_matrix, (i - 1) * (n + 1) + (j - 1)))
                array.set(dtw_matrix, i * (n + 1) + j, cost + min_prev)
        // Р’РѕР·РІСЂР°С‰Р°РµРј РёС‚РѕРіРѕРІРѕРµ СЂР°СЃСЃС‚РѕСЏРЅРёРµ
        array.get(dtw_matrix, m * (n + 1) + n)

// 6. РњРѕРґРёС„РёС†РёСЂРѕРІР°РЅРЅР°СЏ С„СѓРЅРєС†РёСЏ РІР·РІРµС€РµРЅРЅРѕРіРѕ РµРІРєР»РёРґРѕРІР° СЂР°СЃСЃС‚РѕСЏРЅРёСЏ СЃ DTW
euclidean_distance(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11) =>
    // РЎРѕР·РґР°РµРј РјР°СЃСЃРёРІС‹ РґР»СЏ РїСЂРёР·РЅР°РєРѕРІ С‚РѕС‡РµРє a Рё b
    array_a = array.new_float(11)
    array_b = array.new_float(11)
    
    // Р—Р°РїРѕР»РЅСЏРµРј РјР°СЃСЃРёРІ РїСЂРёР·РЅР°РєРѕРІ С‚РѕС‡РєРё a
    array.set(array_a, 0, a1)  // ATR
    array.set(array_a, 1, a2)  // RSI
    array.set(array_a, 2, a3)  // ROC
    array.set(array_a, 3, a4)  // Slope
    array.set(array_a, 4, a5)  // Volume
    array.set(array_a, 5, a6)  // MACD
    array.set(array_a, 6, a7)  // Volume Ratio
    array.set(array_a, 7, a8)  // Corr Price-Volume
    array.set(array_a, 8, a9)  // Corr Price-MACD
    array.set(array_a, 9, a10) // RSI Volatility
    array.set(array_a, 10, a11) // Entropy
    
    // Р—Р°РїРѕР»РЅСЏРµРј РјР°СЃСЃРёРІ РїСЂРёР·РЅР°РєРѕРІ С‚РѕС‡РєРё b
    array.set(array_b, 0, b1)
    array.set(array_b, 1, b2)
    array.set(array_b, 2, b3)
    array.set(array_b, 3, b4)
    array.set(array_b, 4, b5)
    array.set(array_b, 5, b6)
    array.set(array_b, 6, b7)
    array.set(array_b, 7, b8)
    array.set(array_b, 8, b9)
    array.set(array_b, 9, b10)
    array.set(array_b, 10, b11)
    
    // ====== РЈР›РЈР§РЁР•РќРР• 1: Р‘Р°Р·РѕРІРѕРµ РІР·РІРµС€РµРЅРЅРѕРµ РµРІРєР»РёРґРѕРІРѕ СЂР°СЃСЃС‚РѕСЏРЅРёРµ ======
    weighted_euclidean = 0.0
    for i = 0 to 10
        weight = array.get(feature_weights, i)
        diff = array.get(array_a, i) - array.get(array_b, i)
        weighted_euclidean += weight * math.pow(diff, 2)
    
    weighted_euclidean := math.sqrt(weighted_euclidean)
    
    // ====== РЈР›РЈР§РЁР•РќРР• 2: Manhattan distance РґР»СЏ СѓСЃС‚РѕР№С‡РёРІРѕСЃС‚Рё Рє РІС‹Р±СЂРѕСЃР°Рј ======
    weighted_manhattan = 0.0
    for i = 0 to 10
        weight = array.get(feature_weights, i)
        diff = math.abs(array.get(array_a, i) - array.get(array_b, i))
        weighted_manhattan += weight * diff
    
    // ====== РЈР›РЈР§РЁР•РќРР• 3: РќР°РїСЂР°РІР»РµРЅРЅР°СЏ РјРµС‚СЂРёРєР° РґР»СЏ С‚СЂРµРЅРґРѕРІС‹С… РїСЂРёР·РЅР°РєРѕРІ ======
    // РЎРїРµС†РёР°Р»СЊРЅС‹Р№ Р±РѕРЅСѓСЃ РґР»СЏ РєР»Р°СЃС‚РµСЂРѕРІ СЃ РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹РјРё С‚СЂРµРЅРґР°РјРё
    trend_divergence = 0.0
    
    // RSI divergence (РёРЅРґРµРєСЃС‹ 1)
    rsi_diff = a2 - b2
    trend_divergence += 2.0 * math.abs(rsi_diff)  // 2x РІРµСЃ РґР»СЏ RSI
    
    // ROC divergence (РёРЅРґРµРєСЃ 2)
    roc_diff = a3 - b3
    trend_divergence += 2.0 * math.abs(roc_diff)  // 2x РІРµСЃ РґР»СЏ ROC
    
    // Slope divergence (РёРЅРґРµРєСЃ 3)
    slope_diff = a4 - b4
    trend_divergence += 1.5 * math.abs(slope_diff)  // 1.5x РІРµСЃ РґР»СЏ Slope
    
    // MACD divergence (РёРЅРґРµРєСЃ 5)
    macd_diff = a6 - b6
    trend_divergence += 1.5 * math.abs(macd_diff)  // 1.5x РІРµСЃ РґР»СЏ MACD
    
    // ====== РЈР›РЈР§РЁР•РќРР• 4: РђРґР°РїС‚РёРІРЅР°СЏ РєРѕРјР±РёРЅР°С†РёСЏ РјРµС‚СЂРёРє ======
    // Р’С‹С‡РёСЃР»СЏРµРј "СЃРёР»Сѓ С‚СЂРµРЅРґР°" РЅР° РѕСЃРЅРѕРІРµ РєР»СЋС‡РµРІС‹С… РїСЂРёР·РЅР°РєРѕРІ
    trend_strength_a = math.abs(a2 - 50) + math.abs(a3) + math.abs(a4)  // RSI РѕС‚ С†РµРЅС‚СЂР° + ROC + Slope
    trend_strength_b = math.abs(b2 - 50) + math.abs(b3) + math.abs(b4)
    avg_trend_strength = (trend_strength_a + trend_strength_b) / 2.0
    
    // РќРѕСЂРјР°Р»РёР·СѓРµРј СЃРёР»Сѓ С‚СЂРµРЅРґР° (0 = С„Р»СЌС‚, 1 = СЃРёР»СЊРЅС‹Р№ С‚СЂРµРЅРґ)
    normalized_trend_strength = math.min(avg_trend_strength / 100.0, 1.0)
    
    // ====== РЈР›РЈР§РЁР•РќРР• 5: DTW С‚РѕР»СЊРєРѕ РµСЃР»Рё РѕР±Р° РёРјРµСЋС‚ С‚СЂРµРЅРґРѕРІС‹Р№ С…Р°СЂР°РєС‚РµСЂ ======
    dtw_component = 0.0
    if normalized_trend_strength > 0.3  // РўРѕР»СЊРєРѕ РґР»СЏ РЅРµС„Р»СЌС‚РѕРІС‹С… РєР»Р°СЃС‚РµСЂРѕРІ
        dtw_result = dtw_distance(array_a, array_b)
        dtw_component := dtw_result * normalized_trend_strength
    
    // ====== РЈР›РЈР§РЁР•РќРР• 6: РљРѕРјР±РёРЅРёСЂРѕРІР°РЅРЅР°СЏ РјРµС‚СЂРёРєР° СЃ Р°РґР°РїС‚РёРІРЅС‹РјРё РІРµСЃР°РјРё ======
    // Р‘Р°Р·РѕРІР°СЏ С„РѕСЂРјСѓР»Р° (СѓРїСЂРѕС‰РµРЅРЅР°СЏ, Р±РµР· РґСѓР±Р»РёСЂРѕРІР°РЅРёСЏ)
    base_distance = 
         0.50 * weighted_euclidean +     // РћСЃРЅРѕРІРЅР°СЏ РјРµС‚СЂРёРєР°
         0.20 * weighted_manhattan +     // РЈСЃС‚РѕР№С‡РёРІРѕСЃС‚СЊ Рє РІС‹Р±СЂРѕСЃР°Рј
         0.20 * trend_divergence +       // РЈСЃРёР»РµРЅРёРµ СЂР°Р·РґРµР»РµРЅРёСЏ С‚СЂРµРЅРґРѕРІ
         0.10 * dtw_component            // DTW С‚РѕР»СЊРєРѕ РґР»СЏ С‚СЂРµРЅРґРѕРІС‹С…
    
    // ====== РЈР›РЈР§РЁР•РќРР• 7: РђРґР°РїС‚РёРІРЅС‹Р№ Р±РѕРЅСѓСЃ РґР»СЏ РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹С… С‚СЂРµРЅРґРѕРІ ======
    // Р•СЃР»Рё RSI/ROC/Slope РёРјРµСЋС‚ РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹Рµ Р·РЅР°РєРё, СѓРІРµР»РёС‡РёРІР°РµРј СЂР°СЃСЃС‚РѕСЏРЅРёРµ
    opposite_trend_bonus = 0.0
    
    // RSI: РѕРґРёРЅ >55, РґСЂСѓРіРѕР№ <45
    if (a2 > 55 and b2 < 45) or (a2 < 45 and b2 > 55)
        opposite_trend_bonus += 2.0
    
    // ROC: РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹Рµ Р·РЅР°РєРё СЃ РґРѕСЃС‚Р°С‚РѕС‡РЅРѕР№ СЃРёР»РѕР№
    if (a3 > 0.5 and b3 < -0.5) or (a3 < -0.5 and b3 > 0.5)
        opposite_trend_bonus += 2.0
    
    // Slope: РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹Рµ Р·РЅР°РєРё
    if (a4 > 0.3 and b4 < -0.3) or (a4 < -0.3 and b4 > 0.3)
        opposite_trend_bonus += 1.5
    
    // MACD: РїСЂРѕС‚РёРІРѕРїРѕР»РѕР¶РЅС‹Рµ Р·РЅР°РєРё
    if (a6 > 0 and b6 < 0) or (a6 < 0 and b6 > 0)
        opposite_trend_bonus += 1.0
    
    // Р¤РёРЅР°Р»СЊРЅРѕРµ СЂР°СЃСЃС‚РѕСЏРЅРёРµ
    final_distance = base_distance + opposite_trend_bonus
    
    final_distance


// РћСЃРЅРѕРІРЅРѕР№ Р±Р»РѕРє РёРЅРёС†РёР°Р»РёР·Р°С†РёРё K-means++************************************************************************
if bar_index >= min_bars_required and array.size(km_atr_history) >= adjusted_training_period
    if initialization_stage == 0
        status_message := "РЎР±РѕСЂ РґР°РЅРЅС‹С…..."
        initialization_stage := 1
    
    // Р‘Р»РѕРє РЅРѕСЂРјР°Р»РёР·Р°С†РёРё РґР°РЅРЅС‹С… СЃ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёРµРј С„СѓРЅРєС†РёРё is_outlier()
if initialization_stage == 1
    status_message := "РќРѕСЂРјР°Р»РёР·Р°С†РёСЏ РґР°РЅРЅС‹С…..."
    
    // РћС‡РёС‰Р°РµРј РјР°СЃСЃРёРІС‹ РїРµСЂРµРґ Р·Р°РїРѕР»РЅРµРЅРёРµРј
    array.clear(normalized_atr)
    array.clear(normalized_rsi)
    array.clear(normalized_roc)
    array.clear(normalized_slope)
    array.clear(normalized_volume)
    array.clear(normalized_macd)
    array.clear(normalized_volume_ratio)
    array.clear(normalized_corr_price_volume)
    array.clear(normalized_corr_price_macd)
    array.clear(normalized_rsi_volatility)
    array.clear(normalized_entropy)

    // РџСЂРµРґРІР°СЂРёС‚РµР»СЊРЅРѕ РІС‹С‡РёСЃР»СЏРµРј РјРµРґРёР°РЅС‹ РґР»СЏ РєР°Р¶РґРѕРіРѕ РїСЂРёР·РЅР°РєР°
    median_atr = array.median(km_atr_history)
    median_rsi = array.median(km_rsi_history)
    median_roc = array.median(km_roc_history)
    median_slope = array.median(km_slope_history)
    median_volume = array.median(km_volume_history)
    median_macd = array.median(km_macd_history)
    median_volume_ratio = array.median(km_volume_ratio_history)
    median_corr_price_volume = array.median(km_corr_price_volume_history)
    median_corr_price_macd = array.median(km_corr_price_macd_history)
    median_rsi_volatility = array.median(km_rsi_volatility_history)
    median_entropy = array.median(km_entropy_history)

    for i = 0 to array.size(km_atr_history) - 1
        if i < adjusted_training_period
            atr_value = array.get(km_atr_history, i)
            rsi_value = array.get(km_rsi_history, i)
            roc_value = array.get(km_roc_history, i)
            slope_value = array.get(km_slope_history, i)
            volume_value = array.get(km_volume_history, i)
            macd_value = array.get(km_macd_history, i)
            volume_ratio_value = array.get(km_volume_ratio_history, i)
            corr_price_volume_value = array.get(km_corr_price_volume_history, i)
            corr_price_macd_value = array.get(km_corr_price_macd_history, i)
            rsi_volatility_value = array.get(km_rsi_volatility_history, i)
            entropy_value = array.get(km_entropy_history, i)

            // РџСЂРѕРІРµСЂРєР° РЅР° РІС‹Р±СЂРѕСЃС‹ СЃ РїРѕРјРѕС‰СЊСЋ С„СѓРЅРєС†РёРё is_outlier()
            is_atr_outlier = is_outlier(atr_value, km_atr_history)
            is_rsi_outlier = is_outlier(rsi_value, km_rsi_history)
            is_roc_outlier = is_outlier(roc_value, km_roc_history)
            is_slope_outlier = is_outlier(slope_value, km_slope_history)
            is_volume_outlier = is_outlier(volume_value, km_volume_history)
            is_macd_outlier = is_outlier(macd_value, km_macd_history)
            is_volume_ratio_outlier = is_outlier(volume_ratio_value,km_volume_ratio_history)
            is_corr_price_volume_outlier = is_outlier(corr_price_volume_value, km_corr_price_volume_history)
            is_corr_price_macd_outlier = is_outlier(corr_price_macd_value, km_corr_price_macd_history)
            is_rsi_volatility_outlier = is_outlier(rsi_volatility_value, km_rsi_volatility_history)
            is_entropy_outlier = is_outlier(entropy_value, km_entropy_history)

            // РџСЂРѕРїСѓСЃРєР°РµРј С‚РѕС‡РєСѓ, РµСЃР»Рё С…РѕС‚СЏ Р±С‹ РѕРґРёРЅ РїСЂРёР·РЅР°Рє СЏРІР»СЏРµС‚СЃСЏ РІС‹Р±СЂРѕСЃРѕРј
            if not is_atr_outlier and not is_rsi_outlier and not is_roc_outlier and 
               not is_slope_outlier and not is_volume_outlier and not is_macd_outlier and
               not is_volume_ratio_outlier and not is_corr_price_volume_outlier and
               not is_corr_price_macd_outlier and not is_rsi_volatility_outlier and
               not is_entropy_outlier
                
                // РќРѕСЂРјР°Р»РёР·СѓРµРј РґР°РЅРЅС‹Рµ
                n_atr = safe_div(atr_value - km_atr_mean, km_atr_std, 0)
                n_rsi = safe_div(rsi_value - km_rsi_mean, km_rsi_std, 0)
                n_roc = safe_div(roc_value - km_roc_mean, km_roc_std, 0)
                n_slope = safe_div(slope_value - km_slope_mean, km_slope_std, 0)
                n_volume = safe_div(volume_value - km_volume_mean, km_volume_std, 0)
                n_macd = safe_div(macd_value - km_macd_mean, km_macd_std, 0)
                n_volume_ratio = safe_div(volume_ratio_value - km_volume_ratio_mean, km_volume_ratio_std, 0)
                n_corr_price_volume = safe_div(corr_price_volume_value - km_corr_price_volume_mean, km_corr_price_volume_std, 0)
                n_corr_price_macd = safe_div(corr_price_macd_value - km_corr_price_macd_mean, km_corr_price_macd_std, 0)
                n_rsi_volatility = safe_div(rsi_volatility_value - km_rsi_volatility_mean, km_rsi_volatility_std, 0)
                n_entropy = safe_div(entropy_value - km_entropy_mean, km_entropy_std, 0)

                // Р”РѕР±Р°РІР»СЏРµРј РЅРѕСЂРјР°Р»РёР·РѕРІР°РЅРЅС‹Рµ Р·РЅР°С‡РµРЅРёСЏ РІ РјР°СЃСЃРёРІС‹
                array.push(normalized_atr, n_atr)
                array.push(normalized_rsi, n_rsi)
                array.push(normalized_roc, n_roc)
                array.push(normalized_slope, n_slope)
                array.push(normalized_volume, n_volume)
                array.push(normalized_macd, n_macd)
                array.push(normalized_volume_ratio, n_volume_ratio)
                array.push(normalized_corr_price_volume, n_corr_price_volume)
                array.push(normalized_corr_price_macd, n_corr_price_macd)
                array.push(normalized_rsi_volatility, n_rsi_volatility)
                array.push(normalized_entropy, n_entropy)
        // 12. РРќРўР•Р“Р РђР¦РРЇ Р¤РЈРќРљР¦РР РћРџРўРРњРђР›Р¬РќРћР“Рћ РљР›РђРЎРўР•Р Рђ Р’ РћРЎРќРћР’РќРћР™ РђР›Р“РћР РРўРњ
    if initialization_stage == 1 and array.size(km_atr_history) > min_training_period
        // РћРїСЂРµРґРµР»СЏРµРј РѕРїС‚РёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ РєР»Р°СЃС‚РµСЂРѕРІ
        optimal_clusters = find_optimal_clusters()
        num_clusters := int(math.max(min_clusters, math.min(max_clusters, optimal_clusters)))
    
        status_message := "РћРїС‚РёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ РєР»Р°СЃС‚РµСЂРѕРІ: " + str.tostring(num_clusters)
        
        initialization_stage := 2
        status_message := "РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ С†РµРЅС‚СЂРѕРёРґРѕРІ..."
        var array<float> normalized_volume = array.new<float>()
        var array<float> normalized_macd = array.new<float>()

    if initialization_stage == 2
        // 1. Р’С‹Р±РёСЂР°РµРј РїРµСЂРІС‹Р№ С†РµРЅС‚СЂРѕРёРґ СЃР»СѓС‡Р°Р№РЅС‹Рј РѕР±СЂР°Р·РѕРј
        int random_index = math.floor(math.random() * array.size(normalized_atr))
        
        array.set(km_centroids_atr, 0, array.get(normalized_atr, random_index))
        array.set(km_centroids_rsi, 0, array.get(normalized_rsi, random_index))
        array.set(km_centroids_roc, 0, array.get(normalized_roc, random_index))
        array.set(km_centroids_slope, 0, array.get(normalized_slope, random_index))
        array.set(km_centroids_volume, 0, array.get(normalized_volume, random_index))  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.set(km_centroids_macd, 0, array.get(normalized_macd, random_index))      // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.set(km_centroids_corr_price_macd, 0, array.get(normalized_corr_price_macd, random_index))
        array.set(km_centroids_corr_price_volume, 0, array.get(normalized_corr_price_volume, random_index))
        array.set(km_centroids_rsi_volatility, 0, array.get(normalized_rsi_volatility, random_index))  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.set(km_centroids_volume_ratio, 0, array.get(normalized_volume_ratio, random_index))      // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
        array.set(km_centroids_entropy, 0, array.get(normalized_entropy, random_index))  // NEW: Entropy as feature
        for cluster_index = 1 to num_clusters - 1
            var float[] distances = array.new_float(0)
            float total_distance = 0.0
            
            // Р’С‹С‡РёСЃР»СЏРµРј СЂР°СЃСЃС‚РѕСЏРЅРёРµ РѕС‚ РєР°Р¶РґРѕР№ С‚РѕС‡РєРё РґРѕ Р±Р»РёР¶Р°Р№С€РµРіРѕ С†РµРЅС‚СЂРѕРёРґР°
            for i = 0 to array.size(normalized_atr) - 1
                float min_distance = 1e10
                
                // Р’РЅСѓС‚СЂРµРЅРЅРёР№ С†РёРєР» РїРѕ СѓР¶Рµ РёРЅРёС†РёР°Р»РёР·РёСЂРѕРІР°РЅРЅС‹Рј С†РµРЅС‚СЂРѕРёРґР°Рј
                for k = 0 to cluster_index - 1
                    float distance_val = euclidean_distance(array.get(normalized_atr, i),array.get(normalized_rsi, i),array.get(normalized_roc, i),array.get(normalized_slope, i),array.get(normalized_volume, i), array.get(normalized_macd, i), array.get(normalized_volume_ratio, i),array.get(normalized_corr_price_volume, i), array.get(normalized_corr_price_macd, i), array.get(normalized_rsi_volatility, i), array.get(normalized_entropy, i), array.get(km_centroids_atr, k),array.get(km_centroids_rsi, k),array.get(km_centroids_roc, k),array.get(km_centroids_slope, k), array.get(km_centroids_volume, k), array.get(km_centroids_macd, k), array.get(km_centroids_volume_ratio, k),array.get(km_centroids_corr_price_volume, k), array.get(km_centroids_corr_price_macd, k), array.get(km_centroids_rsi_volatility, k), array.get(km_centroids_entropy, k)) 
                    
                    if distance_val < min_distance
                        min_distance := distance_val
                
                array.push(distances, min_distance)
                total_distance := total_distance + min_distance
            
            // Р’С‹Р±РёСЂР°РµРј СЃР»РµРґСѓСЋС‰СѓСЋ С‚РѕС‡РєСѓ СЃ РІРµСЂРѕСЏС‚РЅРѕСЃС‚СЊСЋ, РїСЂРѕРїРѕСЂС†РёРѕРЅР°Р»СЊРЅРѕР№ СЂР°СЃСЃС‚РѕСЏРЅРёСЋ
            float random_value = math.random() * total_distance
            float cumulative_sum = 0.0
            
            for i = 0 to array.size(distances) - 1
                cumulative_sum := cumulative_sum + array.get(distances, i)
                if cumulative_sum >= random_value
                    array.set(km_centroids_atr, cluster_index, array.get(normalized_atr, i))
                    array.set(km_centroids_rsi, cluster_index, array.get(normalized_rsi, i))
                    array.set(km_centroids_roc, cluster_index, array.get(normalized_roc, i))
                    array.set(km_centroids_slope, cluster_index, array.get(normalized_slope, i))
                    array.set(km_centroids_volume, cluster_index, array.get(normalized_volume, i))  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
                    array.set(km_centroids_macd, cluster_index, array.get(normalized_macd, i))      // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
                    array.set(km_centroids_corr_price_macd, cluster_index, array.get(normalized_corr_price_macd, i))
                    array.set(km_centroids_corr_price_volume, cluster_index, array.get(normalized_corr_price_volume, i))
                    array.set(km_centroids_rsi_volatility, cluster_index, array.get(normalized_rsi_volatility, i))  // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
                    array.set(km_centroids_volume_ratio, cluster_index, array.get(normalized_volume_ratio, i))      // РќРѕРІС‹Р№ РїСЂРёР·РЅР°Рє
                    array.set(km_centroids_entropy, cluster_index, array.get(normalized_entropy, i))  // NEW: Entropy as feature
                break

        initialization_stage := 3
        status_message := "РљР»Р°СЃС‚РµСЂРёР·Р°С†РёСЏ Р·Р°РїСѓС‰РµРЅР°..."
        km_kmeans_ok := true
        
        // РРЅРёС†РёР°Р»РёР·РёСЂСѓРµРј СЂР°Р·РјРµСЂС‹ РєР»Р°СЃС‚РµСЂРѕРІ
        for i = 0 to num_clusters - 1
            array.set(cluster_sizes, i, 1)
        
// Р’Р«Р—РћР’ Р Р•РђР›Р¬РќР«РҐ Р¤РЈРќРљР¦РР™ Р’РњР•РЎРўРћ Р—РђР“Р›РЈРЁР•Рљ
var float[] stats = compute_km_stats()
var float[] cluster_types = na

// Р—Р°С‰РёС‚Р° РѕС‚ РїСѓСЃС‚С‹С… stats
if array.size(stats) > 0
    cluster_types := assign_cluster_types(stats)
else
    // Р—РЅР°С‡РµРЅРёСЏ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ, РµСЃР»Рё stats РїСѓСЃС‚
    cluster_types := array.new<float>(6, 0.0)
    array.set(cluster_types, 0, 0)
    array.set(cluster_types, 1, 1)
    array.set(cluster_types, 2, 2)
    array.set(cluster_types, 3, 3)
    array.set(cluster_types, 4, 4)
    array.set(cluster_types, 5, 5)
    
if array.size(cluster_types) >= 6
    km_trend_bull_cluster := int(math.round(array.get(cluster_types, 0)))
    km_trend_bear_cluster := int(math.round(array.get(cluster_types, 1)))
    km_flat_cluster := int(math.round(array.get(cluster_types, 2)))
    km_last_bull_score := array.get(cluster_types, 3)
    km_last_bear_score := array.get(cluster_types, 4)
    km_last_flat_score := array.get(cluster_types, 5)
else
    // Р—РЅР°С‡РµРЅРёСЏ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ, РµСЃР»Рё cluster_types СЃР»РёС€РєРѕРј РјР°Р»
    km_trend_bull_cluster := 0
    km_trend_bear_cluster := 1
    km_flat_cluster := 2
    km_last_bull_score := 10
    km_last_bear_score := 10
    km_last_flat_score := 10

//********************************************************************************************************
// 9. РРЅС‚РµРіСЂР°С†РёСЏ РїСЂРѕРІРµСЂРєРё СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё РІ РѕСЃРЅРѕРІРЅРѕР№ Р°Р»РіРѕСЂРёС‚Рј
var int last_consistency_check_bar = 0
var string cluster_quality_status = "INITIALIZING"
var int recalibration_count = 0
var bool needs_recalibration = false

// Р¤СѓРЅРєС†РёСЏ РїСЂРѕРІРµСЂРєРё Рё РѕР±РЅРѕРІР»РµРЅРёСЏ СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё РєР»Р°СЃС‚РµСЂРѕРІ
check_and_update_consistency() =>
    // РЎРѕР·РґР°РµРј РјР°СЃСЃРёРІ РґР»СЏ РІРѕР·РІСЂР°С‚Р° Р·РЅР°С‡РµРЅРёР№
    array<float> result = array.new<float>(7)
    
    // РРЅРёС†РёР°Р»РёР·РёСЂСѓРµРј Р·РЅР°С‡РµРЅРёСЏ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    array.set(result, 0, 0) // quality_status (0=STABLE, 1=RECALIBRATING, 2=INITIALIZING)
    array.set(result, 1, 0) // needs_recal (0=false, 1=true)
    array.set(result, 2, recalibration_count)
    array.set(result, 3, km_trend_bull_cluster)
    array.set(result, 4, km_trend_bear_cluster)
    array.set(result, 5, km_flat_cluster)
    array.set(result, 6, 0) // status_msg_updated (0=no, 1=yes)
    
    if initialization_stage == 3 and km_kmeans_ok
        // РџСЂРѕРІРµСЂСЏРµРј СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚СЊ РєР°Р¶РґС‹Рµ 50 Р±Р°СЂРѕРІ РёР»Рё РїСЂРё СЃРјРµРЅРµ РєР»Р°СЃС‚РµСЂР°
        if bar_index - last_consistency_check_bar >= 50 or cluster_changed or needs_recalibration
            quality_status = check_cluster_quality()
            
            // РџСЂРµРѕР±СЂР°Р·СѓРµРј СЃС‚СЂРѕРєРѕРІС‹Р№ СЃС‚Р°С‚СѓСЃ РІ С‡РёСЃР»РѕРІРѕР№ РґР»СЏ РІРѕР·РІСЂР°С‚Р°
            quality_status_num = quality_status == "STABLE" ? 0 : quality_status == "RECALIBRATING" ? 1 : 2
            array.set(result, 0, quality_status_num)
            
            if quality_status == "RECALIBRATING" or needs_recalibration
                // РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РєР°Р»РёР±СЂРѕРІРєР° РєР»Р°СЃС‚РµСЂРѕРІ
                calibration = auto_calibrate_clusters()
                if array.size(calibration) >= 3
                    array.set(result, 3, array.get(calibration, 0))
                    array.set(result, 4, array.get(calibration, 1))
                    array.set(result, 5, array.get(calibration, 2))
                    
                    array.set(result, 2, recalibration_count + 1)
                    array.set(result, 6, 1) // status_msg_updated = true
                
                array.set(result, 1, 0) // needs_recal = false

    result

// РРЅС‚РµРіСЂР°С†РёСЏ РІ РѕСЃРЅРѕРІРЅРѕР№ Р°Р»РіРѕСЂРёС‚Рј РєР»Р°СЃС‚РµСЂРёР·Р°С†РёРё
if initialization_stage == 3 and km_kmeans_ok
    // Р’С‹С‡РёСЃР»СЏРµРј С‚РµРєСѓС‰СѓСЋ РЅРѕСЂРјР°Р»РёР·РѕРІР°РЅРЅСѓСЋ С‚РѕС‡РєСѓ
    current_atr = safe_div(km_safe_smooth_vol - km_atr_mean, km_atr_std, 0)
    current_rsi = safe_div(km_rsi_val - km_rsi_mean, km_rsi_std, 0)
    current_roc = safe_div(km_roc_val - km_roc_mean, km_roc_std, 0)
    current_slope = safe_div(km_safe_sma_slope - km_slope_mean, km_slope_std, 0)
    current_volume = safe_div(km_safe_volume - km_volume_mean, km_volume_std, 0)
    current_macd = safe_div(km_safe_macd - km_macd_mean, km_macd_std, 0)
    current_volume_ratio = safe_div(km_safe_volume_ratio - km_volume_ratio_mean, km_volume_ratio_std, 0)
    current_corr_price_volume = safe_div(km_safe_corr_price_volume - km_corr_price_volume_mean, km_corr_price_volume_std, 0)
    current_corr_price_macd = safe_div(km_safe_corr_price_macd - km_corr_price_macd_mean, km_corr_price_macd_std, 0)
    current_rsi_volatility = safe_div(km_safe_rsi_volatility - km_rsi_volatility_mean, km_rsi_volatility_std, 0)
    current_entropy = safe_div(km_safe_entropy - km_entropy_mean, km_entropy_std, 0)
    
    // РџРѕРёСЃРє Р±Р»РёР¶Р°Р№С€РµРіРѕ РєР»Р°СЃС‚РµСЂР°
    float min_distance = 1e10
    int closest_cluster = 0
    
    for i = 0 to num_clusters - 1
        distance_val = euclidean_distance(current_atr, current_rsi, current_roc, current_slope, current_volume, current_macd, current_volume_ratio, current_corr_price_volume, current_corr_price_macd, current_rsi_volatility, current_entropy, array.get(km_centroids_atr, i), array.get(km_centroids_rsi, i), array.get(km_centroids_roc, i), array.get(km_centroids_slope, i), array.get(km_centroids_volume, i), array.get(km_centroids_macd, i), array.get(km_centroids_volume_ratio, i), array.get(km_centroids_corr_price_volume, i), array.get(km_centroids_corr_price_macd, i), array.get(km_centroids_rsi_volatility, i), array.get(km_centroids_entropy, i))
        
        if distance_val < min_distance
            min_distance := distance_val
            closest_cluster := i
    
    // РџСЂРѕРІРµСЂСЏРµРј, РёР·РјРµРЅРёР»СЃСЏ Р»Рё РєР»Р°СЃС‚РµСЂ
    cluster_changed := km_current_cluster != closest_cluster
    km_current_cluster := closest_cluster
    
    // РџРѕСЃР»Рµ РѕРїСЂРµРґРµР»РµРЅРёСЏ current cluster
    if km_current_cluster == previous_cluster
        cycles_in_current_state += 1
    else
        cycles_in_current_state := 1
        previous_cluster := km_current_cluster

// РњРѕРґРёС„РёРєР°С‚РѕСЂ РёРЅРµСЂС†РёРё РґР»СЏ scores
    inertia_bonus = math.min(cycles_in_current_state * 0.05, 0.3)  // Р”Рѕ +30% Р±РѕРЅСѓСЃР°

    // РћР±РЅРѕРІР»СЏРµРј С†РµРЅС‚СЂРѕРёРґ СЃ СѓС‡РµС‚РѕРј РІСЂРµРјРµРЅРЅРѕРіРѕ РІРµСЃР°
    time_diff_current = 0
    learning_rate_val = learning_rate * time_weight(time_diff_current)
    
    array.set(km_centroids_atr, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_atr, closest_cluster) + learning_rate_val * current_atr)
    array.set(km_centroids_rsi, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_rsi, closest_cluster) + learning_rate_val * current_rsi)
    array.set(km_centroids_roc, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_roc, closest_cluster) + learning_rate_val * current_roc)
    array.set(km_centroids_slope, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_slope, closest_cluster) + learning_rate_val * current_slope)
    array.set(km_centroids_volume, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_volume, closest_cluster) + learning_rate_val * current_volume)
    array.set(km_centroids_macd, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_macd, closest_cluster) + learning_rate_val * current_macd)
    array.set(km_centroids_volume_ratio, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_volume_ratio, closest_cluster) + learning_rate_val * current_volume_ratio)
    array.set(km_centroids_corr_price_volume, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_corr_price_volume, closest_cluster) + learning_rate_val * current_corr_price_volume)
    array.set(km_centroids_corr_price_macd, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_corr_price_macd, closest_cluster) + learning_rate_val * current_corr_price_macd)
    array.set(km_centroids_rsi_volatility, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_rsi_volatility, closest_cluster) + learning_rate_val * current_rsi_volatility)
    array.set(km_centroids_entropy, closest_cluster, (1 - learning_rate_val) * array.get(km_centroids_entropy, closest_cluster) + learning_rate_val * current_entropy)
    
    // РћР±РЅРѕРІР»СЏРµРј СЂР°Р·РјРµСЂ РєР»Р°СЃС‚РµСЂР° СЃ СѓС‡РµС‚РѕРј РІСЂРµРјРµРЅРЅРѕРіРѕ РІРµСЃР°
    current_cluster_size = array.get(cluster_sizes, closest_cluster)
    array.set(cluster_sizes, closest_cluster, int(current_cluster_size + time_weight(time_diff_current)))
    // РџСЂРѕРІРµСЂСЏРµРј Рё РѕР±РЅРѕРІР»СЏРµРј СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚СЊ РєР»Р°СЃС‚РµСЂРѕРІ
    result_array = check_and_update_consistency()
    
    // РћР±РЅРѕРІР»СЏРµРј РіР»РѕР±Р°Р»СЊРЅС‹Рµ РїРµСЂРµРјРµРЅРЅС‹Рµ РЅР° РѕСЃРЅРѕРІРµ СЂРµР·СѓР»СЊС‚Р°С‚Р°
    quality_status_num = array.get(result_array, 0)
    cluster_quality_status := quality_status_num == 0 ? "STABLE" : quality_status_num == 1 ? "RECALIBRATING" : "INITIALIZING"
    
    needs_recalibration_num = array.get(result_array, 1)
    needs_recalibration := needs_recalibration_num == 1  // РџСЂР°РІРёР»СЊРЅРѕРµ РїСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ С‡РёСЃР»Р° РІ bool
    
    recalibration_count := int(array.get(result_array, 2))
    km_trend_bull_cluster := int(array.get(result_array, 3))
    km_trend_bear_cluster := int(array.get(result_array, 4))
    km_flat_cluster := int(array.get(result_array, 5))
    
    status_msg_updated = array.get(result_array, 6) == 1
    if status_msg_updated
        status_message := "РљР»Р°СЃС‚РµСЂС‹ РїРµСЂРµРєР°Р»РёР±СЂРѕРІР°РЅС‹ (#" + str.tostring(recalibration_count) + "). Р‘С‹С‡РёР№: " + str.tostring(km_trend_bull_cluster) + ", РњРµРґРІРµР¶РёР№: " + str.tostring(km_trend_bear_cluster) + ", Р¤Р»РµС‚: " + str.tostring(km_flat_cluster)
    
    last_consistency_check_bar := bar_index
    
    // РћРїСЂРµРґРµР»СЏРµРј С‚РµРєСѓС‰РµРµ СЃРѕСЃС‚РѕСЏРЅРёРµ СЂС‹РЅРєР° РЅР° РѕСЃРЅРѕРІРµ РєР»Р°СЃС‚РµСЂР°
    is_bull_trend := km_current_cluster == km_trend_bull_cluster and km_trend_bull_cluster >= 0
    is_bear_trend := km_current_cluster == km_trend_bear_cluster and km_trend_bear_cluster >= 0
    is_flat := km_current_cluster == km_flat_cluster and km_flat_cluster >= 0
    
    // Р’С‹С‡РёСЃР»СЏРµРј СѓРІРµСЂРµРЅРЅРѕСЃС‚СЊ РєР»Р°СЃС‚РµСЂР°
    cluster_confidence := math.min(math.max(1.0 - min_distance / 10.0, 0.1), 1.0)
    
    // РћР±РЅРѕРІР»СЏРµРј РёСЃС‚РѕСЂРёСЋ РєР»Р°СЃС‚РµСЂР° Рё СѓРІРµСЂРµРЅРЅРѕСЃС‚Рё
    if array.size(cluster_norm_history) > 0
        array.set(cluster_norm_history, array.size(cluster_norm_history) - 1, float(km_current_cluster))
        array.set(confidence_history, array.size(confidence_history) - 1, cluster_confidence)
    
    // РџСЂРѕРІРµСЂСЏРµРј РЅРµРѕР±С…РѕРґРёРјРѕСЃС‚СЊ РїРµСЂРµРёРЅРёС†РёР°Р»РёР·Р°С†РёРё
    if bar_index % reinit_period == 0
        initialization_stage := 0
        status_message := "РџРµСЂРµРёРЅРёС†РёР°Р»РёР·Р°С†РёСЏ..."
        km_kmeans_ok := false
        km_reinitialized_now := true
    else
        km_reinitialized_now := false
// === СЕКЦИЯ ПРОГНОЗИРОВАНИЯ (УЛУЧШЕННАЯ + Walk-Forward IS/OOS + SVR + XGB + LightGBM, ОПТИМИЗИРОВАННАЯ ПОД ММВБ) ===

// === Input Parameters ===
regression_length = input.int(30, "Regression Length", minval=10, maxval=200)
forecast_length = input.int(3, "Forecast Horizon", minval=1, maxval=20)
walk_is_len = input.int(150, "IS Window Length", minval=20)
history_len = input.int(60, "Error History Length", minval=10, maxval=100)
vol_adapt_coeff = input.float(4.0, "Volatility Adaptation Coefficient", minval=1.0, maxval=10.0)
trust_mult_base = input.float(1.2, "Base Trust Multiplier", minval=1.0, maxval=2.0)
err_influence = input.float(1.2, "Error Influence on Range", minval=0.5, maxval=2.0)
threshold_bb = input.float(0.02, "BB Width Threshold", minval=0.01, maxval=0.05)
threshold_adx = input.float(25.0, "ADX Threshold", minval=15.0, maxval=35.0)

// История ошибок мета-модели для мониторинга
var array<float> meta_loss_history = array.new_float(0)

// Переключатель: использовать ли стекинг
use_stacking = input.bool(true, "Use Stacking Meta-Model", group="Ensemble")
meta_learning_rate = input.float(0.01, "Meta Learning Rate", minval=0.001, maxval=0.1, step=0.001, group="Ensemble")
meta_momentum = input.float(0.9, "Meta Momentum", minval=0.5, maxval=0.99, step=0.01, group="Ensemble")
meta_update_frequency = input.int(3, "Meta Update Frequency (bars)", minval=1, maxval=10, group="Ensemble")

// === Глобальные переменные ===
var float adjusted_forecast = na
var float forecast_val = na
var float confidence_val = 0.8
var float upper_band_val = na
var float lower_band_val = na
var float final_forecast_val = na
var float last_trust_val = 0.8
var float trust_base_val = 0.75
var float band_width = 0.0

// Веса моделей
var float lr_weight = 0.15
var float ar_weight = 0.15
var float svr_weight = 0.15
var float xgb_weight = 0.15
var float lgbm_weight = 0.20
var float lstm_weight = 0.20

// Сохранённые веса для Walk-Forward
var float saved_lr_w = 0.15
var float saved_ar_w = 0.15
var float saved_svr_w = 0.15
var float saved_xgb_w = 0.15
var float saved_lgbm_w = 0.20
var float saved_lstm_w = 0.20

// Ошибки моделей
var float lr_err = 0.0
var float ar_err = 0.0
var float svr_err = 0.0
var float xgb_err = 0.0
var float lgbm_err = 0.0
var float lstm_err = 0.0

// Прогнозы моделей
var float forecast_lr = na
var float forecast_ar = na
var float forecast_svr = na
var float forecast_xgb = na
var float forecast_lgbm = na
var float forecast_lstm = na

// Массивы для хранения ошибок
var float[] lr_acc_history = array.new_float(0)
var float[] ar_acc_history = array.new_float(0)
var float[] svr_acc_history = array.new_float(0)
var float[] xgb_acc_history = array.new_float(0)
var float[] lgbm_acc_history = array.new_float(0)
var float[] lstm_acc_history = array.new_float(0)
var float[] ensemble_acc_history = array.new_float(0)

// Массивы для хранения прогнозов
var float[] past_lr_forecasts = array.new_float(0)
var float[] past_ar_forecasts = array.new_float(0)
var float[] past_svr_forecasts = array.new_float(0)
var float[] past_xgb_forecasts = array.new_float(0)
var float[] past_lgbm_forecasts = array.new_float(0)
var float[] past_lstm_forecasts = array.new_float(0)
var float[] past_ensemble_forecasts = array.new_float(0)

// Переменные для Walk-Forward
var int wf_counter = 0
var bool is_phase = true
var float ensemble_err = 0.0

// === Глобальные переменные для точности направлений ===
var float ensemble_accuracy = na
var float ensemble_error_rate = na
var int ensemble_correct_direction = 0
var int ensemble_total_direction = 0
var float[] base_prices = array.new_float(0)
var int[] forecast_bars = array.new_int(0)

// === Глобальные переменные для точности направлений ===

// Дополнительные переменные
var float ensemble_val = na
var float max_move_val = 0.0
var float upper_bound_val = na
var float lower_bound_val = na
var float weighted_avg_err = 0.0
var float volatility_factor = 0.0
var float avg_direction = 0.0
var float consensus_strength = 0.0
var float adaptive_power = 0.0
var float confidence_multiplier = 1.0
var float forecast_std = 0.0
var float diversification_factor = 1.0
var float wf_multiplier = 1.0
var string regime = "unknown"
var float w_svr = 1.0
var float w_xgb = 1.0
var float w_arima = 1.0
var float w_lgbm = 1.0
var float w_lstm = 1.0

// Мета-веса для стекинга (инициализируем равномерно)
var array<float> meta_weights = array.from(0.167, 0.167, 0.167, 0.166, 0.166, 0.167)  // LR, AR, SVR, XGB, LGBM, LSTM
var array<float> meta_velocity = array.new_float(6, 0.0)  // Для momentum
var array<float> meta_grad_squared = array.new_float(6, 0.0)  // Для Adam optimizer
var int meta_update_counter = 0
var int meta_training_steps = 0

// Инициализация массивов прогнозов
if array.size(past_lr_forecasts) == 0
    for i = 0 to forecast_length - 1
        array.push(past_lr_forecasts, na)
        array.push(past_ar_forecasts, na)
        array.push(past_svr_forecasts, na)
        array.push(past_xgb_forecasts, na)
        array.push(past_lgbm_forecasts, na)
        array.push(past_ensemble_forecasts, na)

// === Вспомогательные функции ===
// Гиперболический тангенс
tanh(x) => (math.exp(x) - math.exp(-x)) / (math.exp(x) + math.exp(-x))

// Расчет экспоненциально взвешенной средней ошибки
ema_error(hist) =>
    sz = array.size(hist)
    if sz == 0
        0.0
    else if sz == 1
        array.get(hist, 0)
    else
        alpha = 2.0 / (sz + 1)
        ema_val = array.get(hist, 0)
        for i = 1 to sz - 1
            item = array.get(hist, i)
            ema_val := item * alpha + ema_val * (1 - alpha)
        ema_val
// Z-нормализация для стабилизации данных
f_zscore(series float src, int len) =>
    avg = ta.sma(src, len)
    std = ta.stdev(src, len)
    (src - avg) / (std > 0 ? std : 1)
// Пользовательская функция ADX
f_custom_adx(high, low, close, length) =>
    var float up = na
    var float down = na
    var float plusDM = na
    var float minusDM = na
    up := high - high[1]
    down := low[1] - low
    plusDM := na(up) or na(down) ? 0.0 : up > down and up > 0.0 ? up : 0.0
    minusDM := na(up) or na(down) ? 0.0 : down > up and down > 0.0 ? down : 0.0
    float tr = ta.tr(handle_na=true)
    float plusDM_smoothed = ta.rma(plusDM, length)
    float minusDM_smoothed = ta.rma(minusDM, length)
    float tr_smoothed = ta.rma(tr, length)
    float plusDI = 100.0 * plusDM_smoothed / math.max(tr_smoothed, 1e-10)
    float minusDI = 100.0 * minusDM_smoothed / math.max(tr_smoothed, 1e-10)
    float dx = 100.0 * math.abs(plusDI - minusDI) / math.max(plusDI + minusDI, 1e-10)
    float adx = ta.rma(dx, length)
    adx
//========================================================================
// ============================================================
// ФУНКЦИЯ РАСЧЕТА АДАПТИВНОГО LEARNING RATE
// ============================================================

calculate_adaptive_lr(float base_lr, string model_type) =>
    float adaptive_lr = base_lr
    
    // Базовая адаптация по волатильности
    volatility_factor = 1.0 + global_volatility_ratio
    
    // Специфичная адаптация для каждой модели
    if model_type == "LSTM"
        // LSTM: увеличиваем при волатильности для быстрой адаптации
        adaptive_lr := base_lr * volatility_factor
        
        // Дополнительная адаптация по режиму
        if is_bull_trend or is_bear_trend
            adaptive_lr := adaptive_lr * 1.1  // Агрессивнее в тренде
        else if is_flat
            adaptive_lr := adaptive_lr * 0.9  // Консервативнее во флэте
        
    else if model_type == "XGBoost" or model_type == "LightGBM"
        // Деревья: уменьшаем при высокой волатильности для стабильности
        if global_volatility_ratio > 1.5
            adaptive_lr := base_lr * 0.8  // Консервативнее
        else if is_bull_trend or is_bear_trend
            adaptive_lr := base_lr * 1.1  // Агрессивнее в тренде
        else
            adaptive_lr := base_lr
    
    // Ограничение в разумных пределах
    adaptive_lr := math.max(0.001, math.min(0.5, adaptive_lr))
    adaptive_lr

//===========================================================================
f_obv() =>
    obv_val = 0.0
    if close > close[1]
        obv_val := nz(obv_val[1], 0) + volume
    else if close < close[1]
        obv_val := nz(obv_val[1], 0) - volume
    else
        obv_val := nz(obv_val[1], 0)
    obv_val

// Адаптивная взвешенная линейная регрессия с динамической регуляризацией
weighted_linear_regression(src, len, decay_rate_base) =>
    if len <= 1
        [0.0, nz(src[0], close)]
    else
        // НОВОЕ: АДАПТИВНАЯ СКОРОСТЬ ЗАТУХАНИЯ И РЕГУЛЯРИЗАЦИЯ
        float volatility = nz(ta.stdev(src, 20), 0.01) / math.max(nz(ta.sma(src, 20)), 1e-10)
        float confidence_normalized = math.max(0.0, math.min(1.0, nz(cluster_confidence, 0.5)))
        float current_entropy = nz(km_safe_entropy, 0.5)

        float adaptive_decay_rate = decay_rate_base * (1.0 + volatility * 0.5) * (1.0 + confidence_normalized * 0.5)
        
        // Динамическая регуляризация: увеличивается во флэте
        float reg_lambda = is_flat ? 0.5 + volatility * 1.5 : 0.5 + volatility * 0.5

        sum_w = 0.0
        sum_wx = 0.0
        sum_wxx = 0.0
        sum_wy = 0.0
        sum_wxy = 0.0
        
        for i = 0 to len - 1
            // НОВОЕ: ГИБРИДНЫЙ ВЕС, зависящий от энтропии и регуляризации
            float base_weight = math.exp(-adaptive_decay_rate * i)
            float entropy_factor = 1.0 - math.abs(current_entropy - nz(km_safe_entropy[i], current_entropy))
            weight = base_weight * entropy_factor * (1.0 - reg_lambda * 0.1)
            
            x_val = i
            y_val = nz(src[i], close)
            
            sum_w += weight
            sum_wx += weight * x_val
            sum_wxx += weight * math.pow(x_val, 2)
            sum_wy += weight * y_val
            sum_wxy += weight * x_val * y_val
        
        denominator = sum_w * sum_wxx - math.pow(sum_wx, 2)
        epsilon = 1e-10
        safe_denom = math.abs(denominator) > epsilon ? denominator : math.sign(denominator) * epsilon
        
        slope = (sum_w * sum_wxy - sum_wx * sum_wy) / safe_denom
        intercept = (sum_wy - slope * sum_wx) / sum_w
        
        [slope, intercept]

// Адаптивная взвешенная линейная регрессия для массива
wlr_from_array(src_array, len, decay_rate_base) =>
    if len <= 1
        [0.0, array.get(src_array, 0)]
    else
        // НОВОЕ: Адаптивная скорость затухания на основе рыночных условий
        float current_entropy = nz(km_safe_entropy, 0.5) // Предполагаем, что этот признак доступен
        float volatility = nz(ta.stdev(close, 20), 0.01) / math.max(nz(ta.sma(close, 20)), 1e-10)
        float confidence_normalized = math.max(0.0, math.min(1.0, nz(cluster_confidence, 0.5)))
        
        // НОВОЕ: Скорость затухания адаптируется к уверенности и рыночной волатильности
        float adaptive_decay_rate = decay_rate_base * (1.0 + volatility * 0.5) * (1.0 + confidence_normalized * 0.5)
        
        sum_w = 0.0
        sum_wx = 0.0
        sum_wxx = 0.0
        sum_wy = 0.0
        sum_wxy = 0.0
        
        // НОВОЕ: Динамическая нормализация данных
        float max_y = array.max(src_array)
        float min_y = array.min(src_array)
        float range_y = max_y - min_y
        float scale_y = range_y > 1e-10 ? 1.0 / range_y : 1.0

        for i = 0 to len - 1
            weight = math.exp(-adaptive_decay_rate * i)
            x_val = i
            y_val = nz(array.get(src_array, i), close)
            
            // НОВОЕ: Нормализация y_val
            float normalized_y = (y_val - min_y) * scale_y

            sum_w += weight
            sum_wx += weight * x_val
            sum_wxx += weight * math.pow(x_val, 2)
            sum_wy += weight * normalized_y
            sum_wxy += weight * x_val * normalized_y
            
        denominator = sum_w * sum_wxx - math.pow(sum_wx, 2)
        epsilon = 1e-10
        safe_denom = math.abs(denominator) > epsilon ? denominator : math.sign(denominator) * epsilon
        
        slope_norm = (sum_w * sum_wxy - sum_wx * sum_wy) / safe_denom
        intercept_norm = (sum_wy - slope_norm * sum_wx) / sum_w

        // Денормализация (возвращение к исходному масштабу)
        float slope = slope_norm * scale_y
        float intercept = intercept_norm * range_y + min_y - slope_norm * sum_wx / sum_w * range_y

        [slope, intercept]
// Адаптивная взвешенная квадратичная регрессия с динамической регуляризацией
weighted_quadratic_regression(src, len, decay_rate_base) =>
    if len <= 2
        [0.0, 0.0, nz(src[0], close)]
    else
        // НОВОЕ: АДАПТИВНАЯ СКОРОСТЬ ЗАТУХАНИЯ И РЕГУЛЯРИЗАЦИЯ
        float volatility = nz(ta.stdev(src, 20), 0.01) / math.max(nz(ta.sma(src, 20)), 1e-10)
        float confidence_normalized = math.max(0.0, math.min(1.0, nz(cluster_confidence, 0.5)))
        float current_entropy = nz(km_safe_entropy, 0.5)

        float adaptive_decay_rate = decay_rate_base * (1.0 + volatility * 0.5) * (1.0 + confidence_normalized * 0.5)
        
        // Динамическая регуляризация: увеличивается во флэте
        float reg_lambda = is_flat ? 0.5 + volatility * 1.5 : 0.5 + volatility * 0.5

        sum_w = 0.0
        sum_wx = 0.0
        sum_wxx = 0.0
        sum_wxxx = 0.0
        sum_wxxxx = 0.0
        sum_wy = 0.0
        sum_wxy = 0.0
        sum_wxxy = 0.0
        
        for i = 0 to len - 1
            // НОВОЕ: ГИБРИДНЫЙ ВЕС, зависящий от энтропии и регуляризации
            float base_weight = math.exp(-adaptive_decay_rate * i)
            float entropy_factor = 1.0 - math.abs(current_entropy - nz(km_safe_entropy[i], current_entropy))
            weight = base_weight * entropy_factor * (1.0 - reg_lambda * 0.1)
            
            x = i
            x2 = x * x
            x3 = x * x2
            x4 = x2 * x2
            y = nz(src[i], close)

            sum_w += weight
            sum_wx += weight * x
            sum_wxx += weight * x2
            sum_wxxx += weight * x3
            sum_wxxxx += weight * x4
            sum_wy += weight * y
            sum_wxy += weight * x * y
            sum_wxxy := sum_wxxy + weight * x2 * y
        
        det = sum_w * (sum_wxx * sum_wxxxx - sum_wxxx * sum_wxxx) - sum_wx * (sum_wx * sum_wxxxx - sum_wxx * sum_wxxx) + sum_wxx * (sum_wx * sum_wxxx - sum_wxx * sum_wxx)
        
        if math.abs(det) < 1e-10
            [0.0, 0.0, close]
        else
            a = (sum_wy * (sum_wxx * sum_wxxxx - sum_wxxx * sum_wxxx) - sum_wxy * (sum_wx * sum_wxxxx - sum_wxx * sum_wxxx) + sum_wxxy * (sum_wx * sum_wxxx - sum_wxx * sum_wxx)) / det
            b = (sum_w * (sum_wxy * sum_wxxxx - sum_wxxy * sum_wxxx) - sum_wy * (sum_wx * sum_wxxxx - sum_wxx * sum_wxxx) + sum_wxx * (sum_wx * sum_wxxy - sum_wxx * sum_wxy)) / det
            c = (sum_w * (sum_wxx * sum_wxy - sum_wxxx * sum_wxy) - sum_wx * (sum_wx * sum_wxxy - sum_wxx * sum_wxy) + sum_wxx * (sum_wx * sum_wxxx - sum_wxx * sum_wxx)) / det
            
            [a, b, c]

// --- 2. Основная функция авторегрессионного прогноза ---

autoregressive_forecast(src, order, base_strength, dynamic_adjustment) =>
    // Проверка начальных условий
    if bar_index < order + 20
        0.0
    else
        // --- 2.1. Подготовка и нормализация данных ---
        normalized_src = f_zscore(src, order)
        
        // --- 2.2. Расчет динамической силы прогноза ---
        local_volatility = ta.stdev(src, 20) / ta.sma(src, 20)
        
        // Сила прогноза адаптируется к волатильности
        adaptive_strength = base_strength * (1 + local_volatility * dynamic_adjustment)
        
        // --- 2.3. Основной авторегрессионный расчет ---
        sum_w = 0.0
        sum_wy = 0.0
        sum_wx = 0.0
        sum_wxy = 0.0
        sum_wxx = 0.0
        
        // Использование нормализованных данных для повышения точности
        for i = 0 to order - 1
            // Более сложный расчет весов
            // Вес = (временная близость) * (схожесть с текущим значением)
            time_weight = math.exp(-0.1 * i)
            similarity_weight = math.exp(-math.abs(src[i + 1] - src[1]) * 0.005)
            
            combined_weight = time_weight * similarity_weight
            
            y = normalized_src[i+1]
            x = normalized_src[i]
            
            sum_w += combined_weight
            sum_wy += combined_weight * y
            sum_wx += combined_weight * x
            sum_wxy += combined_weight * x * y
            sum_wxx += combined_weight * x * x
            
        // Расчет коэффициентов линейной регрессии
        b = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wxx - sum_wx * sum_wx)
        a = (sum_wy / sum_w) - b * (sum_wx / sum_w)
        
        // Прогноз следующего нормализованного значения
        normalized_forecast = a + b * normalized_src[0]
        
        // Денормализация прогноза
        avg = ta.sma(src, order)
        std = ta.stdev(src, order)
        final_forecast = (normalized_forecast * (std > 0 ? std : 1)) + avg
        
        // --- 2.4. Применение силы прогноза ---
        // Возврат прогноза, скорректированного силой и текущей ценой
        src[0] + (final_forecast - src[0]) * adaptive_strength


//****************************************************************************
//=========== LSTM CNN Hybrid Forecast v6 (Полностью рабочий код) ===========//
//*****************************************************************************

// Hyperparameters (tweakable)
// ПЕРЕМЕЩЕНО: Объявление параметров в начало
units = input.int(8, "LSTM units per layer", minval=1, maxval=64)
alpha_base = input.float(0.01, "Base learning rate (alpha)", step=0.0001)
momentum = input.float(0.9, "Momentum", step=0.01, minval=0.0, maxval=0.999)
w_min = input.float(-5.0, "Weight min", step=0.1)
w_max = input.float(5.0, "Weight max", step=0.1)
safe_len_default = input.int(30, "Sequence length (safe_len)", minval=10, maxval=150)
decay = input.float(0.0001, "Weight decay", step=0.0001, minval=0.0)
cnn_window = input.int(5, "CNN Window Size", minval=3, maxval=20)
cnn_filters = input.int(8, "CNN Filters", minval=2, maxval=32)

// Helper activations
sigmoid(x) => 1.0 / (1.0 + math.exp(-x))
tanh_act(x) => 2.0 * sigmoid(2.0 * x) - 1.0

// -------------------------
// Utility: compute mean and std of an array<float>
array_mean(a) =>
    s = 0.0
    for i = 0 to a.size() - 1
        s += a.get(i)
    s / a.size()

array_std(a, mean) =>
    n = a.size()
    if n <= 1
        0.0
    else
        s = 0.0
        for i = 0 to n - 1
            diff = a.get(i) - mean
            s += diff * diff
        math.sqrt(s / n)

// Persistent states and weights
var float[] cell1 = array.new_float(units, 0.0)
var float[] hidden1 = array.new_float(units, 0.0)
var float[] cell2 = array.new_float(units, 0.0)
var float[] hidden2 = array.new_float(units, 0.0)
var float[] cell3 = array.new_float(units, 0.0)
var float[] hidden3 = array.new_float(units, 0.0)
var float[] cell4 = array.new_float(units, 0.0)
var float[] hidden4 = array.new_float(units, 0.0)

// ❗ ИСПРАВЛЕНО: Инициализация массивов вне условного блока
var array<float> cnn_weights_flat = array.new_float(cnn_filters * cnn_window, 0.0)
var bool cnn_initialized = false
var float[] norm_cnn_features = array.new_float(cnn_filters, 0.0)
var float[] cnn_features = array.new_float(cnn_filters, 0.0)

if not cnn_initialized
    for f = 0 to cnn_filters - 1
        for i = 0 to cnn_window - 1
            index = f * cnn_window + i
            array.set(cnn_weights_flat, index, math.random() * 2 - 1)
    cnn_initialized := true
    
// Layer1 weights
var float[] w_f1 = array.new_float(units, 0.8), u_f1 = array.new_float(units, 0.2), b_f1 = array.new_float(units, 0.0)
var float[] w_i1 = array.new_float(units, 0.5), u_i1 = array.new_float(units, 0.5), b_i1 = array.new_float(units, 0.0)
