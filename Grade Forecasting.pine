// Momentum arrays for LSTM
var float[] mv_w_f1 = array.new_float(units, 0.0), mv_u_f1 = array.new_float(units, 0.0), mv_w_i1 = array.new_float(units, 0.0), mv_u_i1 = array.new_float(units, 0.0), mv_w_c1 = array.new_float(units, 0.0), mv_u_c1 = array.new_float(units, 0.0), mv_w_o1 = array.new_float(units, 0.0), mv_u_o1 = array.new_float(units, 0.0)
var float[] mv_w_f2 = array.new_float(units, 0.0), mv_u_f2 = array.new_float(units, 0.0), mv_w_i2 = array.new_float(units, 0.0), mv_u_i2 = array.new_float(units, 0.0), mv_w_c2 = array.new_float(units, 0.0), mv_u_c2 = array.new_float(units, 0.0), mv_w_o2 = array.new_float(units, 0.0), mv_u_o2 = array.new_float(units, 0.0)
var float[] mv_w_f3 = array.new_float(units, 0.0), mv_u_f3 = array.new_float(units, 0.0), mv_w_i3 = array.new_float(units, 0.0), mv_u_i3 = array.new_float(units, 0.0), mv_w_c3 = array.new_float(units, 0.0), mv_u_c3 = array.new_float(units, 0.0), mv_w_o3 = array.new_float(units, 0.0), mv_u_o3 = array.new_float(units, 0.0)
var float[] mv_w_f4 = array.new_float(units, 0.0), mv_u_f4 = array.new_float(units, 0.0), mv_w_i4 = array.new_float(units, 0.0), mv_u_i4 = array.new_float(units, 0.0), mv_w_c4 = array.new_float(units, 0.0), mv_u_c4 = array.new_float(units, 0.0), mv_w_o4 = array.new_float(units, 0.0), mv_u_o4 = array.new_float(units, 0.0)

// Per-feature weights
var float[] w_in_price = array.new_float(units, 0.1)
var float[] w_in_rsi = array.new_float(units, 0.1)
var float[] w_in_roc = array.new_float(units, 0.1)
var float[] w_in_atr = array.new_float(units, 0.1)
